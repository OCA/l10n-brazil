#, python-format
msgid ""
"<p><strong>Payment Installments Renegotiated</strong></p><p><strong>Previous"
" installments:</strong><br/>%(old)s</p><p><strong>New "
"installments:</strong><br/>%(new)s</p>"
msgstr ""
"<p><strong>Parcelas renegociadas</strong></p><p><strong>Parcelas "
"anteriores:</strong><br/>%(old)s</p><p><strong>Novas parcelas:</strong><br/>%"
"(new)s</p>"

#. module: l10n_br_account_renegotiation
#: model_terms:ir.ui.view,arch_db:l10n_br_account_renegotiation.view_installment_renegotiation_wizard_form
msgid ""
"<strong>Note:</strong> This action will modify the payment due dates\n"
"                    and amounts on the posted invoice. The fiscal document (NFe) will\n"
"                    not be affected. A record of this change will be logged in the\n"
"                    invoice's chatter."
msgstr ""
"<strong>Observação:</strong> esta ação altera os vencimentos e os valores "
"das parcelas\n"
"                    da fatura lançada. O documento fiscal (NF-e) não é "
"alterado. O registro\n"
"                    da alteração fica no histórico da fatura."

#. module: l10n_br_account_renegotiation
#: model_terms:ir.ui.view,arch_db:l10n_br_account_renegotiation.view_installment_renegotiation_wizard_form
msgid ""
"<strong>Warning:</strong> The total amount must remain unchanged.\n"
"                    Please adjust the installment amounts so the difference is zero."
msgstr ""
"<strong>Atenção:</strong> o valor total não pode mudar.\n"
"                    Ajuste os valores das parcelas até a diferença ficar "
"zerada."

