<odoo>

    <record id="view_move_form_renegotiation" model="ir.ui.view">
        <field name="name">account.move.form.renegotiation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_renegotiate_installments" invisible="1" />
                <button
                    name="action_renegotiate_installments"
                    string="Renegotiate Installments"
                    type="object"
                    class="oe_highlight"
                    groups="account.group_account_manager"
                    attrs="{'invisible': [('can_renegotiate_installments', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

</odoo>
