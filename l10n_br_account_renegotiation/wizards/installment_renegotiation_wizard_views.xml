<odoo>

    <record id="view_installment_renegotiation_wizard_form" model="ir.ui.view">
        <field name="name">account.installment.renegotiation.wizard.form</field>
        <field name="model">account.installment.renegotiation.wizard</field>
        <field name="arch" type="xml">
            <form string="Renegotiate Installments">
                <group>
                    <group>
                        <field name="move_id" readonly="1" />
                        <field name="currency_id" invisible="1" />
                        <field name="payment_term_id" options="{'no_create': True}" />
                        <field name="starting_date" required="1" />
                    </group>
                    <group>
                        <field name="original_total" readonly="1" />
                        <field name="new_total" readonly="1" />
                        <field
                            name="difference"
                            readonly="1"
                            decoration-danger="difference != 0"
                            decoration-success="difference == 0"
                        />
                    </group>
                </group>
                <notebook>
                    <page string="Installments" name="installments">
                        <field name="line_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="date_maturity" />
                                <field name="amount" />
                                <field
                                    name="payment_mode_id"
                                    options="{'no_create': True}"
                                />
                                <field name="company_id" column_invisible="1" />
                                <field name="currency_id" column_invisible="1" />
                                <field name="original_line_id" column_invisible="1" />
                            </tree>
                        </field>
                    </page>
                </notebook>
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': [('difference', '=', 0)]}"
                >
                    <strong>Warning:</strong> The total amount must remain unchanged.
                    Please adjust the installment amounts so the difference is zero.
                </div>
                <div class="alert alert-info" role="alert">
                    <strong>Note:</strong> This action will modify the payment due dates
                    and amounts on the posted invoice. The fiscal document (NFe) will
                    not be affected. A record of this change will be logged in the
                    invoice's chatter.
                </div>
                <footer>
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('difference', '!=', 0)]}"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
