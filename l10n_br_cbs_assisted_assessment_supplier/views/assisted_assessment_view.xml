<odoo>
    <record id="view_assessment_period_form_cbs_suppliers" model="ir.ui.view">
        <field name="name">l10n_br_assisted_assessment.period.form.cbs.suppliers</field>
        <field name="model">l10n_br_assisted_assessment.period</field>
        <field
            name="inherit_id"
            ref="l10n_br_assisted_assessment.view_assessment_period_form"
        />
