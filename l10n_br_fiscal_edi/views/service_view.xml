<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="service_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.service.search</field>
        <field name="model">l10n_br_fiscal_edi.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
                <field name="document_type_ids" />
            </search>
        </field>
    </record>

    <record id="service_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.service.tree</field>
        <field name="model">l10n_br_fiscal_edi.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="document_type_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <record id="service_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.service.form</field>
        <field name="model">l10n_br_fiscal_edi.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="description" />
                        <field name="document_type_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="service_action" model="ir.actions.act_window">
        <field name="name">Fiscal Document Service</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_br_fiscal_edi.service</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="service_tree" />
        <field name="help" type="html">
            <p
                class="o_view_nocontent_smiling_face"
            >Add a new Fiscal Document Service</p>
            <p>All SEFAZ electronic document webservices (authorization, event
            reception, distribution...) supported by the Brazilian Fiscal
            module for Odoo.</p>
        </field>
    </record>

</odoo>
