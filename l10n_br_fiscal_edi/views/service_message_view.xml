<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="service_message_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.service.message.search</field>
        <field name="model">l10n_br_fiscal_edi.service.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="service_id" />
            </search>
        </field>
    </record>

    <record id="service_message_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.service.message.tree</field>
        <field name="model">l10n_br_fiscal_edi.service.message</field>
        <field name="arch" type="xml">
            <tree edit="false" create="false">
                <field name="code" />
                <field name="name" />
                <field name="service_id" invisible="1" />
                <field name="message_type" />
            </tree>
        </field>
    </record>

    <record id="service_message_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.service.message.form</field>
        <field name="model">l10n_br_fiscal_edi.service.message</field>
        <field name="arch" type="xml">
            <form edit="false" create="false">
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="description" />
                        <field name="service_id" />
                        <field name="message_type" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
