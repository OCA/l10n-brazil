<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_document_event">
        <t t-set="o" t-value="doc" />
        <t t-set="o" t-value="o.with_context(lang=o.document_id.partner_id.lang)" />
        <div class="page" style="font-size:16px;">
            <style type="text/css">
.col-1,
.col-2,
.col-3,
.col-4,
.col-5,
.col-6,
.col-7,
.col-8,
.col-9,
.col-10,
.col-11,
.col-12 {
    padding: 5px 5px 5px 5px;
}
.bt {
    border-top: 1px solid black;
}
.bb {
    border-bottom: 1px solid black;
}
.bl {
    border-left: 1px solid black;
}
.br {
    border-right: 1px solid black;
}
row {
    cols: 10;
}
            </style>

            <div id="header" class="row bt bb bl br">
                <div class="col-12" style="text-align: center; font-size: 36px;">
                    <span t-field="o.type" />
                </div>
            </div>
            <div class="row bb bl br">
                <div id="document_key" class="col-6">
                    <strong style="font-size:18px;">Document Key:</strong>
                    <p t-field="o.document_id.document_key" />
                </div>
                <div id="company_cnpj_cpf" class="col-6 bl">
                    <strong style="font-size:18px;">CNPJ:</strong>
                    <p t-field="o.document_id.company_id.vat" />
                </div>
            </div>
            <div class="row bb bl br">
                <div id="document_number" class="col-3">
                    <strong style="font-size:18px;">Document Number:</strong>
                    <p t-field="o.document_number" />
                </div>
                <div id="document_serie_code" class="col-3 bl">
                    <strong style="font-size:18px;">Document Serie:</strong>
                    <p t-field="o.document_serie_id.code" />
                </div>
                <div id="environment" class="col-6 bl">
                    <strong style="font-size:18px;">Environment:</strong>
                    <p t-field="o.environment" />
                </div>
            </div>
            <div class="row bb bl br">
                <div id="protocol_number" class="col-6">
                    <strong style="font-size:18px;">Protocol Number:</strong>
                    <p t-field="o.protocol_number" />
                </div>
                <div id="protocol_date" class="col-6 bl">
                    <strong style="font-size:18px;">Protocol Date:</strong>
                    <p t-field="o.protocol_date" />
                </div>
            </div>
            <div id="justification" class="row bb bl br">
                <div class="col-12" t-if="o.justification">
                    <strong style="font-size:18px;">Justification:</strong>
                    <p t-field="o.justification" />
                </div>
            </div>
        </div>
    </template>
    <template id="report_document_event_cce">
        <t t-set="o" t-value="doc" />
        <t t-set="v" t-value="o._get_cce_report_values()" />
        <div class="page" style="font-size:12px; position: relative;">
            <style type="text/css">
.cce td {
    border: 1px solid black;
    padding: 4px 6px;
    vertical-align: top;
}
.cce table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 6px;
}
.cce .label {
    font-weight: bold;
    font-size: 10px;
    text-transform: uppercase;
}
.cce .title {
    font-weight: bold;
    font-size: 14px;
}
.cce .subtitle {
    font-style: italic;
}
.cce .watermark {
    position: absolute;
    top: 300px;
    left: 0;
    width: 100%;
    text-align: center;
    font-size: 90px;
    font-weight: bold;
    color: rgba(160, 160, 160, 0.3);
    transform: rotate(-30deg);
    z-index: -1;
}
            </style>
            <div class="cce">
                <div t-if="v['homologation']" class="watermark">NO FISCAL VALUE</div>
                <table>
                    <tr>
                        <td style="width: 55%;">
                            <div class="label">Issuer</div>
                            <strong t-out="v['issuer_name']" />
                            <div>CNPJ/CPF: <span t-out="v['issuer_cnpj_cpf']" /></div>
                            <div t-if="v['issuer_ie']">State registration: <span
                                t-out="v['issuer_ie']"
                            /></div>
                            <div t-out="v['issuer_address']" />
                            <div t-if="v['issuer_phone']" t-out="v['issuer_phone']" />
                        </td>
                        <td style="text-align: center;">
                            <div class="title">Graphic representation of the CC-e</div>
                            <div class="subtitle">(Electronic Correction Letter)</div>
                            <div style="margin-top: 6px; text-align: left;">
                                <div>Event ID: <span t-out="v['event_id']" /></div>
                                <div>Sequence: <span t-out="v['sequence']" /></div>
                                <div>Created on: <span t-out="v['event_date']" /></div>
                                <div>Protocol: <span t-out="o.protocol_number" /></div>
                                <div>Registered at: <span
                                    t-out="v['registration_date']"
                                /></div>
                                <div t-if="v['status']">Status: <span
                                    t-out="v['status']"
                                /></div>
                            </div>
                        </td>
                    </tr>
                </table>
                <table>
                    <tr>
                        <td>
                            <div class="label">Recipient</div>
                            <strong t-out="v['recipient_name']" />
                            <div>CNPJ/CPF: <span
                                t-out="v['recipient_cnpj_cpf']"
                            /></div>
                        </td>
                        <td style="width: 45%;">
                            <div class="label">NF-e</div>
                            <div>Model: <span t-out="v['nfe_model']" /> Number: <span
                                t-out="v['nfe_number']"
                            /> Series: <span t-out="v['nfe_serie']" /></div>
                            <div>Issue date: <span t-out="v['nfe_date']" /></div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <div class="label">Access key</div>
                            <div t-out="v['access_key_text']" />
                            <img
                                t-if="v['access_key']"
                                alt="Barcode"
                                t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=600&amp;height=60' % v['access_key']"
                                style="width: 100%; max-height: 60px;"
                            />
                        </td>
                    </tr>
                </table>
                <table>
                    <tr>
                        <td>
                            <div class="label">Conditions of use</div>
                            <div
                                style="font-size: 10px;"
                                t-out="v['condition_of_use']"
                            />
                        </td>
                    </tr>
                </table>
                <table>
                    <tr>
                        <td style="height: 380px;">
                            <div class="label">Corrections to be considered</div>
                            <div
                                style="white-space: pre-line; margin-top: 4px;"
                                t-out="v['correction']"
                            />
                        </td>
                    </tr>
                </table>
                <div
                    style="text-align: center; font-size: 10px;"
                >This document is a graphic representation of the CC-e, printed only for information, and has no fiscal validity. The CC-e must be received and kept as an XML file and can be consulted on the SEFAZ portals.</div>
            </div>
        </div>
    </template>
    <template id="main_report_document_event">
        <t t-call="web.html_container">
            <div class="article">
                <t t-foreach="docs" t-as="doc">
                    <t
                        t-if="doc.type == '14'"
                        t-call="l10n_br_fiscal_edi.report_document_event_cce"
                        t-lang="doc._get_cce_report_lang()"
                    />
                    <t
                        t-else=""
                        t-call="l10n_br_fiscal_edi.report_document_event"
                        t-lang="doc.document_id.partner_id.lang"
                    />
                </t>
            </div>
        </t>
    </template>
</odoo>
