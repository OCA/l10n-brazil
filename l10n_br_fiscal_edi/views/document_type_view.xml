<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="document_type_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_edi.document.type.form</field>
        <field name="model">l10n_br_fiscal.document.type</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='document_email']" position="after">
                <page
                    name="service"
                    string="Services"
                    attrs="{'invisible': [('electronic', '=', False)]}"
                >
                    <field
                        name="service_ids"
                        context="{'default_document_type_id': id}"
                    />
                </page>
                <page
                    name="event"
                    string="Events"
                    attrs="{'invisible': [('electronic', '=', False)]}"
                >
                    <field
                        name="event_ids"
                        context="{'default_document_type_id': id}"
                    />
                </page>
            </xpath>
        </field>
    </record>

</odoo>
