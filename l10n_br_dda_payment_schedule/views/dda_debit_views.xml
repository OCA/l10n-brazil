<odoo>
    <record id="dda_debit_view_form" model="ir.ui.view">
        <field name="model">l10n_br_dda.debit</field>
        <field name="inherit_id" ref="l10n_br_dda.dda_debit_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='link']/group" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not payment_schedule_warning"
                >
                    <field name="payment_schedule_warning" nolabel="1" />
                </div>
            </xpath>
            <xpath
                expr="//field[@name='allocation_ids']/list/field[@name='amount']"
                position="after"
            >
                <field name="payment_schedule_state" widget="badge" />
            </xpath>
        </field>
    </record>
</odoo>
