<odoo>
    <record id="view_company_form_tax_assessment" model="ir.ui.view">
        <field name="name">res.company.form.tax.assessment.start</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <group name="normal_taxes" position="after">
                <group name="tax_assessment" string="Apuração de impostos">
                    <field name="tax_assessment_start" />
                </group>
            </group>
        </field>
    </record>
</odoo>
