<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form.frenet</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_frenet_sync_services"
                        type="object"
                        string="Synchronize Frenet Services"
                        class="btn-primary"
                        invisible="delivery_type != 'frenet'"
                    />
                </header>
            </xpath>
            <group name="delivery_details" position="after">
                <group
                    name="frenet"
                    string="Frenet"
                    invisible="delivery_type != 'frenet'"
                >
                    <field name="frenet_token" password="True" />
                    <field name="frenet_carrier_name" />
                    <field name="frenet_service_description" />
                    <field name="frenet_service_code" />
                    <field name="frenet_package_length" string="Box Length (cm)" />
                    <field name="frenet_package_width" string="Box Width (cm)" />
                    <field name="frenet_package_height" string="Box Height (cm)" />
                </group>
            </group>
        </field>
    </record>
</odoo>
