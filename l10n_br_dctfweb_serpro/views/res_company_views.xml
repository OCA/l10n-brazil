<odoo>
    <record id="view_company_form_dctfweb_serpro" model="ir.ui.view">
        <field name="name">res.company.form.dctfweb.serpro</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_dctfweb.view_company_form_dctfweb" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dctfweb']//group" position="after">
                <group
                    name="dctfweb_serpro"
                    string="Integra Contador"
                    groups="base.group_system"
                >
                    <field name="serpro_environment" />
                    <field name="serpro_consumer_key" password="True" />
                    <field name="serpro_consumer_secret" password="True" />
                    <field name="serpro_contractor_cnpj" />
                    <field name="serpro_author_cnpj" />
                    <field name="serpro_warn_cost" />
                    <field name="serpro_token_expiration" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
