<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record forcecreate="True" id="ir_cron_poll_requests" model="ir.cron">
        <field name="name">CBS Assessment: poll and download pending requests</field>
        <field
            name="model_id"
            ref="l10n_br_assisted_assessment.model_l10n_br_assessment_request"
        />
        <field name="state">code</field>
        <field name="code">model._cron_poll_requests()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record forcecreate="True" id="ir_cron_request_daily" model="ir.cron">
        <field name="name">CBS Assessment: open the daily requests</field>
        <field
            name="model_id"
            ref="l10n_br_assisted_assessment.model_l10n_br_assessment_request"
        />
        <field name="state">code</field>
        <field name="code">model._cron_request_daily()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False" />
    </record>
</odoo>
