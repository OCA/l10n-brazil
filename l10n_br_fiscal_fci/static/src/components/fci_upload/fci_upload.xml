<templates>
    <t t-name="l10n_br_fiscal_fci.FCIFileUploader">
        <FileUploader
            acceptedFileExtensions="'.txt,.zip'"
            fileUploadClass="'fci_file_uploader'"
            onUploaded.bind="onFileUploaded"
        >
            <t t-set-slot="toggler">
                <button type="button" class="btn btn-secondary o_button_upload_fci">
                    Upload
                </button>
            </t>
        </FileUploader>
    </t>

    <t
        t-name="l10n_br_fiscal_fci.ListView.Buttons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
    >
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <FCIFileUploader />
        </xpath>
    </t>
</templates>
