<odoo>

    <record id="product_template_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_fci.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="l10n_br_fiscal.product_template_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='fiscal']" position="inside">
                <group name="fci" string="FCI">
                    <field name="fci_count" invisible="1" />
                    <field name="fci_code" />
                    <button
                        name="action_view_fci"
                        type="object"
                        string="FCI History"
                        class="btn-link"
                        icon="fa-list"
                        attrs="{'invisible': [('fci_count', '=', 0)]}"
                    />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
