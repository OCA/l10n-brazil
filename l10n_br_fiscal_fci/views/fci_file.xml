<odoo>
    <record id="fci_file_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.fci.file.search</field>
        <field name="model">l10n_br_fiscal.fci.file</field>
        <field name="arch" type="xml">
            <search string="FCI">
                <field name="name" />
                <field name="protocol_number" />
                <field name="company_id" />
                <field
                    name="fci_ids"
                    string="Product"
                    filter_domain="[('fci_ids.product_id', 'ilike', self)]"
                />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_generated"
                    string="File Generated"
                    domain="[('state', '=', 'generated')]"
                />
                <filter
                    name="filter_transmitted"
                    string="Transmitted"
                    domain="[('state', '=', 'transmitted')]"
                />
                <filter
                    name="filter_done"
                    string="Done"
                    domain="[('state', '=', 'done')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                    <filter
                        name="group_date"
                        string="Creation Date"
                        context="{'group_by': 'date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="fci_file_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.fci.file.tree</field>
        <field name="model">l10n_br_fiscal.fci.file</field>
        <field name="arch" type="xml">
            <list js_class="fci_file_tree">
                <field name="name" />
                <field name="date" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="fci_count" />
                <field name="protocol_number" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'generated'"
                    decoration-warning="state == 'transmitted'"
                    decoration-success="state == 'done'"
                />
            </list>
        </field>
    </record>

    <record id="fci_file_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.fci.file.form</field>
        <field name="model">l10n_br_fiscal.fci.file</field>
        <field name="arch" type="xml">
            <form string="FCI">
                <header>
                    <button
                        name="action_generate_file"
                        type="object"
                        string="Generate File"
                        invisible="state != 'draft'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_set_transmitted"
                        type="object"
                        string="Confirm Transmission"
                        invisible="state != 'generated'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_import_return_file"
                        type="object"
                        string="Import Return File"
                        invisible="state not in ('transmitted', 'done')"
                        class="oe_highlight"
                    />
                    <button
                        name="action_back_to_draft"
                        type="object"
                        string="Back to Draft"
                        invisible="state != 'generated'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group name="fci_data" string="FCI">
                            <field
                                name="company_id"
                                readonly="state != 'draft'"
                                options="{'no_create': True}"
                            />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="layout_version" />
                            <field name="currency_id" invisible="1" />
                        </group>
                        <group name="establishment" string="Establishment">
                            <field name="vat" />
                            <field name="l10n_br_ie_code" />
                            <field name="legal_name" />
                            <field name="city_id" />
                            <field name="state_id" />
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Goods">
                            <field
                                name="fci_ids"
                                nolabel="1"
                                readonly="state != 'draft'"
                            >
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="company_id" column_invisible="1" />
                                    <field name="currency_id" column_invisible="1" />
                                    <field
                                        name="product_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="name" />
                                    <field name="ncm_id" optional="show" />
                                    <field name="product_code" />
                                    <field name="gtin" optional="hide" />
                                    <field name="uom_code" />
                                    <field name="amount_interstate" sum="Total" />
                                    <field name="amount_imported" sum="Total" />
                                    <field name="import_content" />
                                    <field name="fci_code" optional="show" />
                                    <field
                                        name="validation_indicator"
                                        optional="hide"
                                    />
                                </list>
                            </field>
                        </page>
                        <page name="file" string="File">
                            <group>
                                <group name="file_data" string="Transmission">
                                    <field
                                        name="file"
                                        filename="filename"
                                        invisible="not file"
                                    />
                                    <field name="filename" invisible="1" />
                                    <field
                                        name="protocol_number"
                                        readonly="state != 'generated'"
                                    />
                                </group>
                                <group name="return_data" string="Return">
                                    <field
                                        name="return_file"
                                        filename="return_filename"
                                        invisible="not return_file"
                                    />
                                    <field name="return_filename" invisible="1" />
                                    <field name="hash_code" />
                                    <field name="date_reception" />
                                    <field name="date_validation" />
                                    <field name="validation_indicator" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
</odoo>
