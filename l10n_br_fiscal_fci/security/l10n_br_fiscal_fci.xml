<odoo noupdate="1">

    <record id="l10n_br_fiscal_fci_header_rule" model="ir.rule">
        <field name="name">FCI multi-company</field>
        <field name="model_id" ref="model_l10n_br_fiscal_fci_header" />
        <field eval="True" name="global" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_br_fiscal_fci_line_rule" model="ir.rule">
        <field name="name">FCI Line multi-company</field>
        <field name="model_id" ref="model_l10n_br_fiscal_fci_line" />
        <field eval="True" name="global" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
