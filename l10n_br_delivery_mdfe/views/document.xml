<odoo>
    <record id="mdfe_document_form_view" model="ir.ui.view">
        <field name="name">mdfe.document.form.view (in l10n_br_delivery_mdfe)</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_mdfe.mdfe_document_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='vehicle']//field[@name='mdfe30_cInt']"
                position="before"
            >
                <field
                    name="vehicle_id"
                    domain="[('active', '=', True)]"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
