<odoo>
    <record model="ir.ui.view" id="nfse_dfe_document_tree">
        <field name="name">l10n_br_fiscal_dfe.document.tree.nfse</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list
                create="false"
                edit="false"
                delete="false"
                decoration-success="color_status == 'green'"
                decoration-info="color_status == 'blue'"
                decoration-muted="color_status == 'muted'"
            >
                <field
                    name="color_status"
                    widget="badge"
                    string="Type"
                    decoration-success="color_status == 'green'"
                    decoration-info="color_status == 'blue'"
                    decoration-muted="color_status == 'muted'"
                />
                <field name="document_emission_date" string="Date" widget="date" />
                <field name="access_key" />
                <field name="emitter" />
                <field name="vat" />
                <field name="partner_id" />
                <field name="document_amount" string="Amount" widget="monetary" />
                <field name="currency_id" column_invisible="1" />
                <field name="document_state_label" string="State" />
                <button
                    string="XML"
                    name="action_download_xml"
                    type="object"
                    icon="fa-file-code-o"
                />
                <button
                    name="import_document"
                    string="Import"
                    type="object"
                    icon="fa-file-text-o"
                />
            </list>
        </field>
    </record>

    <record id="view_l10n_br_fiscal_dfe_document_form_nfse" model="ir.ui.view">
        <field name="name">l10n_br_fiscal_dfe.document.form.nfse</field>
        <field name="model">l10n_br_fiscal_dfe.document</field>
        <field
            name="inherit_id"
            ref="l10n_br_fiscal_dfe.l10n_br_fiscal_dfe_document_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='make_pdf']" position="attributes">
                <attribute name="invisible">fiscal_type == 'nfse'</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_nfse_dfe_document" model="ir.actions.act_window">
        <field name="name">Third-party NFS-e</field>
        <field name="res_model">l10n_br_fiscal_dfe.document</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('fiscal_type', '=', 'nfse'), ('is_own_document', '=', False)]</field>
        <field name="context">{'default_fiscal_type': 'nfse'}</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'list',
                           'view_id': ref('nfse_dfe_document_tree')}),
                   (0, 0, {'view_mode': 'form',
                           'view_id': ref('l10n_br_fiscal_dfe.l10n_br_fiscal_dfe_document_form')})]"
        />
    </record>

    <menuitem
        id="menu_l10n_br_nfse_dfe_document"
        name="Third-party NFS-e"
        action="action_nfse_dfe_document"
        parent="l10n_br_fiscal_dfe.menu_l10n_br_fiscal_dfe_root"
        sequence="20"
    />
</odoo>
