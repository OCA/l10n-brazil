<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
    Views: res.company
    -->

    <record id="l10n_br_base_res_company_form" model="ir.ui.view">
        <field name="name">l10n_br_base.res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <field name="vat" position="attributes">
                <attribute name="invisible">show_l10n_br</attribute>
            </field>
            <field name="vat" position="after">
                <field name="vat_formatted_cnpj" invisible="not show_l10n_br" />
            </field>
            <field name="company_registry" position="after">
                <field
                    name="legal_name"
                    placeholder="Legal Name..."
                    invisible="not show_l10n_br"
                />
                <field
                    name="l10n_br_ie_code"
                    placeholder="State Tax Number..."
                    invisible="not show_l10n_br"
                />
                <field
                    name="l10n_br_im_code"
                    placeholder="Municipal Tax Number..."
                    invisible="not show_l10n_br"
                />
                <field
                    name="l10n_br_isuf_code"
                    placeholder="Suframa"
                    invisible="state_id != %(base.state_br_am)d"
                />
                <field name="state_tax_number_ids" invisible="not show_l10n_br">
                    <list editable="bottom">
                        <!-- field name="company_id" column_invisible="1" /-->
                        <field name="l10n_br_ie_code" />
                        <field
                            name="state_id"
                            domain="[('country_id', '=', %(base.br)d)]"
                            create="False"
                            edit="False"
                        />
                    </list>
                </field>
            </field>
            <!-- TODO: Na v12 era desnecessario incluir o codigo abaixo para
                  tornar invisivel o campo City/Char e incluir City_id/m2o,
                  teria outra forma de fazer isso? -->
            <field name="state_id" position="after">
                <field
                    name="city_id"
                    class="o_address_city"
                    placeholder="City"
                    options='{"no_open": True}'
                />
            </field>
            <field name="city" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="l10n_br_base_res_company_tree" model="ir.ui.view">
        <field name="name">l10n_br_base.res.company.tree</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="vat_formatted_cnpj"
                    string="CNPJ"
                    invisible="not show_br_vat_format"
                />
                <field name="vat" string="VAT" invisible="show_br_vat_format" />
            </field>
        </field>
    </record>
</odoo>
