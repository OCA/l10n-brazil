<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_base_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div id="l10n_br_base_config">
                    <block
                        title="Brazilian Localization"
                        name="l10n_br_base_setting_container"
                    >
                        <field name="company_id" invisible="1" />
                        <setting
                            id="allow_cnpj_multi_ie_setting"
                            help="Allows you to create more than one partner with the same CNPJ and different State Tax Number"
                        >
                            <field name="allow_cnpj_multi_ie" />
                        </setting>
                        <setting
                            id="module_l10n_br_zip_setting"
                            help="Use Brazilian postal service API to search partner address using postal zip code"
                        >
                            <field name="module_l10n_br_zip" />
                        </setting>
                        <setting
                            id="disable_cpf_cnpj_validation_setting"
                            help="Select to disable CPF and CNPJ validation"
                        >
                            <field name="disable_cpf_cnpj_validation" />
                        </setting>
                        <setting
                            id="disable_ie_validation_setting"
                            help="Select to disable IE validation"
                        >
                            <field name="disable_ie_validation" />
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
