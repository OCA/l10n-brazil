<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="nfe_document_form_inherit" model="ir.ui.view">
        <field name="name">l10n_br_nfe.document.form.inherit</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_view_invoice"
                    type="object"
                    help="Show related invoices"
                    attrs="{'invisible': [('move_count', '=', 0)]}"
                    icon="fa-pencil-square-o"
                >
                    <field name="move_count" widget="statinfo" string="Invoices" />
                </button>
            </xpath>
            <field name="state_fiscal" position="after">
                <field name="move_ids" invisible="1" />
                <field name="imported_document" invisible="1" />
            </field>
            <xpath expr="//button[@name='action_send_email']" position="after">
                <button
                    name="action_import_confirm"
                    string="Confirm Import"
                    type="object"
                    class="oe_highlight"
                    attrs="{'invisible': [('imported_document', '!=', True)]}"
                />
            </xpath>
        </field>
    </record>

</odoo>
