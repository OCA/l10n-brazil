<odoo>

    <record id="bank_connection_form_dda" model="ir.ui.view">
        <field name="name">l10n_br_bank_connection.connection.form.dda</field>
        <field name="model">l10n_br_bank_connection.connection</field>
        <field name="inherit_id" ref="l10n_br_bank_connection.bank_connection_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sync']" position="after">
                <page
                    string="DDA"
                    name="dda"
                    attrs="{'invisible': [('dda_available', '=', False)]}"
                >
                    <field name="dda_available" invisible="1" />
                    <div
                        class="alert alert-warning"
                        role="alert"
                        attrs="{'invisible': [('dda_pending_events', '=', 0)]}"
                    >
                        <field name="dda_pending_events" /> DDA event(s) waiting to be
                        processed or retried. See the events below.
                    </div>
                    <div class="mb-3">
                        <button
                            name="action_enable_dda"
                            type="object"
                            string="Enable DDA"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('dda_enabled', '=', True), ('state', '=', 'draft')]}"
                        />
                        <button
                            name="action_dda_sync_now"
                            type="object"
                            string="Synchronize now"
                            class="btn-secondary"
                            attrs="{'invisible': [('dda_enabled', '=', False)]}"
                        />
                        <button
                            name="action_disable_dda"
                            type="object"
                            string="Disable DDA"
                            class="btn-secondary"
                            confirm="The bank stops sending new boletos. The ones already captured stay in the inbox. Continue?"
                            attrs="{'invisible': [('dda_enabled', '=', False)]}"
                        />
                    </div>
                    <group>
                        <group name="dda_state">
                            <field name="dda_enabled" />
                            <field name="dda_last_incremental" />
                            <field name="dda_last_full" />
                            <field name="dda_last_cursor" groups="base.group_no_one" />
                        </group>
                    </group>
                    <separator string="Last synchronization" />
                    <field name="dda_sync_status_ids">
                        <tree
                            decoration-danger="state == 'error'"
                            decoration-warning="state == 'warning'"
                        >
                            <field name="last_date" />
                            <field name="state" />
                            <field name="message" />
                        </tree>
                    </field>
                    <separator string="Events" />
                    <field name="dda_event_ids">
                        <tree
                            create="false"
                            decoration-danger="state == 'quarantine'"
                            decoration-warning="state == 'error'"
                            decoration-muted="state == 'done'"
                        >
                            <field name="create_date" />
                            <field name="event_type" />
                            <field name="state" />
                            <field name="attempts" />
                            <field name="next_attempt_at" />
                            <field name="last_error" />
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath
                expr="//div[hasclass('oe_chatter')]/field[@name='message_follower_ids']"
                position="after"
            >
                <field name="activity_ids" />
            </xpath>
        </field>
    </record>

</odoo>
