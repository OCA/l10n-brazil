<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
        t-name="l10n_br_pos.TicketScreen"
        t-inherit="point_of_sale.TicketScreen"
        t-inherit-mode="extension"
    >

        <xpath expr="//div[hasclass('header-row')]/div[4]" position="after">
            <div class="col p-2">CPF/CNPJ</div>
            <div class="col wide p-2">Chave</div>
        </xpath>

        <xpath expr="(//div[hasclass('order-row')])[1]/div[4]" position="after">
            <div class="col p-2">
                <t t-esc="order.get_cnpj_cpf ? order.get_cnpj_cpf() : ''" />
            </div>
            <div class="col wide p-2">
                <t t-esc="order.document_key || ''" />
            </div>
        </xpath>

    </t>

</templates>
