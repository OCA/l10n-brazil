<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_payment_term_form" model="ir.ui.view">
        <field name="name">account.payment.term.form.business.day</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form" />
        <field name="arch" type="xml">
            <field name="note" position="before">
                <group string="Business Day">
                    <field name="business_day_policy" />
                    <field
                        name="holiday_calendar_id"
                        invisible="business_day_policy == 'none'"
                        required="business_day_policy != 'none'"
                    />
                </group>
            </field>
        </field>
    </record>
</odoo>
