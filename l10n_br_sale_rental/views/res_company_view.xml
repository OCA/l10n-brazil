<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_sale_rental_res_company_form" model="ir.ui.view">
        <field name="name">l10n_br_sale_rental.res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='taxes']" position="after">
                <page name="rental" string="Rental">
                    <group string="Fiscal Operations">
                        <field
                            name="rental_fiscal_operation_id"
                            options="{'no_create': True}"
                        />
                        <field
                            name="rental_remessa_fiscal_operation_id"
                            options="{'no_create': True}"
                        />
                        <field
                            name="rental_retorno_fiscal_operation_id"
                            options="{'no_create': True}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
