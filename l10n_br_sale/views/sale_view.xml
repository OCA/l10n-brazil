<odoo>
    <record id="l10n_br_sale_quotation_tree" model="ir.ui.view">
        <field name="name">l10n_br_sale.quotation.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="fiscal_operation_id" readonly="1" optional="show" />
            </field>
        </field>
    </record>

    <record id="l10n_br_sale_order_tree" model="ir.ui.view">
        <field name="name">l10n_br_sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="fiscal_operation_id" readonly="1" optional="show" />
            </field>
        </field>
    </record>

    <record id="l10n_br_sale_order_form" model="ir.ui.view">
        <field name="name">l10n_br_sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- order top form view extensions: -->
            <xpath expr="//group[@name='sale_total']" position="attributes">
                <attribute
                    name="class"
                >oe_subtotal_footer order-0 order-lg-1</attribute>
            </xpath>
            <xpath
                expr="//group[@name='sale_total']/field[@name='tax_totals']"
                position="attributes"
            >
                <attribute name="colspan">2</attribute>
            </xpath>
            <field name="tax_totals" position="before">
                <field
                    name="amount_untaxed"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                />
                <field
                    name="amount_price_gross"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                    invisible="not fiscal_operation_id"
                />
                <field
                    name="amount_discount_value"
                    groups="l10n_br_sale.group_discount_per_value"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                />
                <field
                    name="amount_freight_value"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                    readonly="delivery_costs == 'line' and not force_compute_delivery_costs_by_total"
                    invisible="not fiscal_operation_id"
                />
                <field
                    name="amount_insurance_value"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                    readonly="delivery_costs == 'line' and not force_compute_delivery_costs_by_total"
                    invisible="not fiscal_operation_id"
                />
                <field
                    name="amount_other_value"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                    readonly="delivery_costs == 'line' and not force_compute_delivery_costs_by_total"
                    invisible="not fiscal_operation_id"
                />
            </field>
            <field name="tax_totals" position="before">
                <field
                    name="amount_tax_withholding"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                    invisible="not fiscal_operation_id and amount_tax_withholding == 0"
                />
            </field>
            <field name="tax_totals" position="after">
                <field
                    name="amount_financial_total"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                    invisible="not fiscal_operation_id"
                />
            </field>
            <group name="sale_shipping" position="inside">
                <field name="force_compute_delivery_costs_by_total" />
            </group>
            <field name="show_update_fpos" position="before">
                <field
                    name="fiscal_operation_id"
                    invisible="company_country_id != %(base.br)d"
                    readonly="state != 'draft'"
                />
                <field
                    name="ind_final"
                    invisible="not fiscal_operation_id"
                    required="fiscal_operation_id"
                />
                <field
                    name="ind_pres"
                    invisible="not fiscal_operation_id"
                    required="fiscal_operation_id"
                    readonly="state != 'draft'"
                />
            </field>
            <!-- order lines list view extensions: -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute
                    name="context"
                >{'default_fiscal_operation_id': fiscal_operation_id, 'default_partner_id': partner_id, 'default_company_id': company_id}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <control name="fiscal_fields" invisible="1" />
                <!-- this is a dynamic fiscal fields placeholder-->
                <control name="fiscal_taxes_fields" string="Taxes" invisible="1" />
                <!-- this is a dynamic fiscal fields placeholder-->
                <!-- The order lines list is an editable list, so it is the
                     edition view used by the Form test framework
                     (odoo/tests/form.py): the fields written through
                     so_form.order_line are looked up there. A field that is
                     only referenced by an expression of the view is otherwise
                     either missing from it or added by the framework with an
                     `invisible` modifier, which makes it unwritable in tests.
                     They are hence still declared, as hidden columns, so that
                     the tests can keep driving the per line fiscal operation
                     and the per line delivery costs: -->
                <field name="fiscal_operation_id" column_invisible="1" />
                <field name="freight_value" column_invisible="1" />
                <field name="insurance_value" column_invisible="1" />
                <field name="other_value" column_invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='discount']"
                position="attributes"
            >
                <attribute
                    name="column_invisible"
                >parent.fiscal_operation_id</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='tax_ids']"
                position="attributes"
            >
                <attribute
                    name="column_invisible"
                >parent.fiscal_operation_id</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='price_unit']"
                position="after"
            >
                <field
                    name="discount"
                    groups="!l10n_br_sale.group_discount_per_value"
                    column_invisible="not parent.fiscal_operation_id"
                />
                <field
                    name="discount_value"
                    groups="l10n_br_sale.group_discount_per_value"
                    column_invisible="not parent.fiscal_operation_id"
                />
                <field
                    name="fiscal_operation_line_id"
                    column_invisible="not parent.fiscal_operation_id"
                />
                <field
                    name="fiscal_tax_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    column_invisible="not parent.fiscal_operation_id"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='price_subtotal']"
                position="after"
            >
                <field
                    name="price_total"
                    column_invisible="parent.fiscal_operation_id"
                />
            </xpath>
            <!-- order lines form view extensions:  -->
            <xpath expr="//field[@name='order_line']/form" position="inside">
                <group name="fiscal_fields" invisible="1">
                    <!-- this is a dynamic fiscal fields placeholder-->
                </group>
            </xpath>
            <!-- discount management in line form: -->
            <xpath
                expr="//field[@name='order_line']/form//label[@for='discount']"
                position="before"
            >
                <field
                    name="discount_fixed"
                    groups="l10n_br_sale.group_total_discount"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='discount']"
                position="attributes"
            >
                <attribute
                    name="readonly"
                >user_discount_value or (user_total_discount and not discount_fixed)</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//div[@name='discount']"
                position="after"
            >
                <label for="discount_value" />
                <div name="discount_value">
                    <field
                        name="discount_value"
                        class="oe_inline"
                        readonly="not user_discount_value or (user_total_discount and not discount_fixed)"
                    />
                </div>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//label[@for='customer_lead']"
                position="before"
            >
                <field
                    name="fiscal_operation_id"
                    options="{'no_create': True}"
                    readonly="state in ('sale', 'done', 'cancel')"
                    required="parent.fiscal_operation_id"
                    invisible="not parent.fiscal_operation_id"
                />
                <field
                    name="fiscal_operation_line_id"
                    options="{'no_create': True}"
                    readonly="state in ('sale', 'done', 'cancel')"
                    required="parent.fiscal_operation_id and product_id"
                    invisible="not parent.fiscal_operation_id"
                />
                <field
                    name="cfop_id"
                    options="{'no_create': True}"
                    invisible="tax_icms_or_issqn == 'issqn' or not parent.fiscal_operation_id"
                />
                <field
                    name="service_type_id"
                    options="{'no_create': True}"
                    invisible="tax_icms_or_issqn == 'icms' or not parent.fiscal_operation_id"
                />
                <field
                    name="city_taxation_code_id"
                    invisible="tax_icms_or_issqn == 'icms' or not parent.fiscal_operation_id"
                    options="{'no_create': True}"
                />
                <field
                    name="national_taxation_code_id"
                    invisible="tax_icms_or_issqn == 'icms' or not parent.fiscal_operation_id"
                    options="{'no_create': True}"
                />
                <field
                    name="cnae_id"
                    invisible="tax_icms_or_issqn == 'icms' or not parent.fiscal_operation_id"
                    options="{'no_create': True}"
                />
                <field
                    name="nbs_id"
                    invisible="tax_icms_or_issqn == 'icms' or not parent.fiscal_operation_id"
                    options="{'no_create': True}"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='tax_ids']"
                position="attributes"
            >
                <attribute name="invisible">parent.fiscal_operation_id</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form/div[@groups='base.group_no_one' and field/@name='invoice_lines']"
                position="attributes"
            >
                <attribute name="invisible">parent.fiscal_operation_id</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='price_unit']"
                position="after"
            >
                <label
                    for="fiscal_quantity"
                    string="Fiscal Quantity"
                    invisible="not parent.fiscal_operation_id"
                />
                <div invisible="not parent.fiscal_operation_id">
                    <field
                        context="{'partner_id':parent.partner_id, 'quantity':fiscal_quantity, 'pricelist':parent.pricelist_id, 'uom':uot_id, 'uom_qty_change':True, 'company_id': parent.company_id}"
                        name="fiscal_quantity"
                        class="oe_inline"
                    />
                    <field name="uot_id" invisible="1" force_save="1" />
                    <field
                        name="uot_id"
                        force_save="1"
                        groups="uom.group_uom"
                        class="oe_inline oe_no_button"
                        readonly="state in ('sale', 'done', 'cancel')"
                        required="not display_type"
                    />
                </div>
                <field name="fiscal_price" invisible="not parent.fiscal_operation_id" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form/field[@name='name']"
                position="after"
            >
                <notebook invisible="display_type or not parent.fiscal_operation_id">
                    <page name="fiscal_taxes" string="Taxes" />
                    <!-- this is a dynamic fiscal fields placeholder-->
                    <page
                        string="Invoice Lines"
                        groups="base.group_no_one"
                        invisible="display_type"
                    >
                        <div>
                            <label for="invoice_lines" />
                            <field name="invoice_lines" />
                        </div>
                    </page>
                    <page name="amounts" string="Amounts">
                        <group>
                            <group>
                                <field name="fiscal_amount_untaxed" />
                                <field name="amount_fiscal" />
                                <field name="fiscal_amount_tax" />
                                <field name="estimate_tax" readonly="1" />
                            </group>
                            <group>
                                <field name="fiscal_amount_total" />
                                <field name="amount_tax_withholding" readonly="1" />
                                <field name="amount_taxed" />
                            </group>
                        </group>
                    </page>
                    <page name="others" string="Others">
                        <group>
                            <field
                                name="freight_value"
                                readonly="delivery_costs == 'total' or force_compute_delivery_costs_by_total"
                            />
                            <field
                                name="insurance_value"
                                readonly="delivery_costs == 'total' or force_compute_delivery_costs_by_total"
                            />
                            <field
                                name="other_value"
                                readonly="delivery_costs == 'total' or force_compute_delivery_costs_by_total"
                            />
                        </group>
                    </page>
                    <page name="fiscal_line_extra_info" string="Extra Info" />
                    <page name="accounting" string="Accounting">
                        <group>
                            <field
                                name="tax_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                context="{'search_view_ref': 'account.account_tax_view_search'}"
                                domain="[('type_tax_use','=','sale'),('company_id','=',parent.company_id)]"
                                readonly="qty_invoiced &gt; 0"
                            />
                        </group>
                    </page>
                </notebook>
            </xpath>
            <!-- order bottom form view extensions: -->
            <field name="note" position="attributes">
                <attribute name="invisible">fiscal_operation_id</attribute>
            </field>
            <field name="note" position="after">
                <group invisible="not fiscal_operation_id">
                    <field name="copy_note" />
                    <field
                        name="note"
                        placeholder="Terms and conditions... (note: you can setup default ones in the Configuration menu)"
                        style="min-width: 590px;"
                    />
                    <field
                        name="manual_customer_additional_data"
                        style="min-width: 590px;"
                    />
                    <field
                        name="manual_fiscal_additional_data"
                        style="min-width: 590px;"
                    />
                </group>
            </field>
            <xpath expr="//group[@name='sale_total']" position="after">
                <group style="width: 65%%" groups="l10n_br_sale.group_total_discount">
                    <label for="discount_rate" />
                    <div>
                    <field
                        name="discount_rate"
                        class="oe_inline"
                        readonly="state not in ['draft', 'sent']"
                    />%%</div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
