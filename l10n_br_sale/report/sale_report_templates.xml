<?xml version="1.0" encoding="utf-8" ?>
<!-- oca-hooks:disable=file-not-used -->
<odoo>
    <template
        id="report_saleorder_document_l10n_br_sale"
        inherit_id="sale.report_saleorder_document"
        priority="100"
    >
        <!-- Substituição do campo usado para Impostos no Brasil -->
        <xpath
            expr="//td[@t-if='display_discount']/following-sibling::td[1]"
            position="replace"
        >
            <!-- Pedido referente a uma Empresa Brasileira altera os impostos padrões para os do Brasil. -->
            <td
                t-if="doc.company_id.country_id.phone_code == 55"
                name="td_taxes"
                class="text-right"
            >
                <t
                    t-foreach="line.fiscal_tax_ids.filtered(lambda x: x.percent_amount or x.value_amount)"
                    t-as="tax"
                >
                    <!-- Usando o phone_code porque tanto code == 'br' ou code == br não funcionaram -->
                    <small>
                        <span t-esc="tax.name" />
                        <br />
                    </small>
                </t>
            </td>
            <!-- Pedido de empresas de outros países mantem o campo padrão de impostos-->
            <td
                t-if="doc.company_id.country_id.phone_code != 55"
                name="td_taxes"
                class="text-right"
            >
                <span
                    t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))"
                />
            </td>
        </xpath>
        <xpath
            expr="//t[@t-set='address']/p[@t-if='doc.partner_id.vat']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >doc.partner_id.vat and not doc.company_id._get_report_option('report_partner_fiscal_data')</attribute>
        </xpath>
        <xpath expr="//t[@t-set='address']/p[last()]" position="after">
            <t
                t-if="doc.company_id._get_report_option('report_partner_fiscal_data')"
                t-call="l10n_br_fiscal.report_partner_fiscal_data"
            >
                <t t-set="partner" t-value="doc.partner_id" />
            </t>
        </xpath>
        <xpath expr="//div[@id='informations']" position="inside">
            <t t-call="l10n_br_fiscal.report_fiscal_operation" />
        </xpath>
        <xpath
            expr="//td[@name='td_name']/span[@t-field='line.name']"
            position="before"
        >
            <t t-call="l10n_br_fiscal.report_line_product_code" />
        </xpath>
        <xpath expr="//td[@name='td_name']/span[@t-field='line.name']" position="after">
            <t t-call="l10n_br_fiscal.report_line_fiscal_details" />
        </xpath>
        <xpath expr="//div[@name='total']//table" position="before">
            <t t-set="fiscal_totals" t-value="doc._get_report_fiscal_totals()" />
        </xpath>
        <xpath
            expr="//div[@name='total']//t[@t-call='sale.document_tax_totals']"
            position="attributes"
        >
            <attribute name="t-if">not fiscal_totals</attribute>
        </xpath>
        <xpath
            expr="//div[@name='total']//t[@t-call='sale.document_tax_totals']"
            position="after"
        >
            <t t-if="fiscal_totals" t-call="l10n_br_fiscal.report_fiscal_totals">
                <t t-set="currency" t-value="doc.currency_id" />
            </t>
        </xpath>
        <xpath expr="//div[@name='total']//t[@t-set='tax_totals']" position="before">
            <tr t-if="doc.amount_freight_value">
                <td name="td_amount_freight_label">
                    <strong>Freight</strong>
                </td>
                <td name="td_amount_freight_value" class="text-end">
                    <span t-field="doc.amount_freight_value" />
                </td>
            </tr>

            <tr t-if="doc.amount_insurance_value">
                <td name="td_amount_insurance_label">
                    <strong>Insurance</strong>
                </td>
                <td name="td_amount_insurance_value" class="text-end">
                    <span t-field="doc.amount_insurance_value" />
                </td>
            </tr>

            <tr t-if="doc.amount_other_value">
                <td name="td_amount_costs_label">
                    <strong>Other Costs</strong>
                </td>
                <td name="td_amount_other_value" class="text-end">
                    <span t-field="doc.amount_other_value" />
                </td>
            </tr>
        </xpath>
        <!-- Inclusão de outros Totais usados no Brasil -->
        <!-- TODO migrate overriding _compute_tax_totals_json for v15 -->
