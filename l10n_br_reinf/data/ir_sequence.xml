<odoo noupdate="1">

    <record id="sequence_reinf_event" model="ir.sequence">
        <field name="name">EFD-Reinf Event</field>
        <field name="code">l10n_br_reinf.event</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="sequence_reinf_batch" model="ir.sequence">
        <field name="name">EFD-Reinf Batch</field>
        <field name="code">l10n_br_reinf.batch</field>
        <field name="prefix">REINF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False" />
    </record>

</odoo>
