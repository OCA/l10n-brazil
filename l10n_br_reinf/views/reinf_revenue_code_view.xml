<odoo>

    <record id="reinf_revenue_code_tree" model="ir.ui.view">
        <field name="model">l10n_br_reinf.revenue.code</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="periodicity" />
                <field name="date_start" optional="show" />
                <field name="date_end" optional="show" />
            </tree>
        </field>
    </record>

    <record id="reinf_revenue_code_form" model="ir.ui.view">
        <field name="model">l10n_br_reinf.revenue.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <group>
                        <group name="identification">
                            <field name="code" />
                            <field name="name" />
                            <field name="periodicity" />
                            <field name="active" invisible="1" />
                        </group>
                        <group name="validity" string="Validity">
                            <field name="date_start" />
                            <field name="date_end" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="reinf_revenue_code_action" model="ir.actions.act_window">
        <field name="name">Revenue Codes</field>
        <field name="res_model">l10n_br_reinf.revenue.code</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first revenue code
            </p>
            <p>
                The revenue code is the code a withholding is collected under in
                a DARF, and the key the totalizers of the tax authority answer
                with.
            </p>
        </field>
    </record>

</odoo>
