<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_base_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='module_l10n_br_zip_setting']" position="after">
                <t invisible="not module_l10n_br_zip">
                    <setting id="cep_ws_provider_setting">
                        <field name="cep_ws_provider" required="module_l10n_br_zip" />
                    </setting>
                    <setting id="cep_update_days_setting">
                        <field
                            name="cep_update_days"
                            required="module_l10n_br_zip"
                        /> days
                    </setting>
                </t>
            </xpath>
        </field>
    </record>

</odoo>
