<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="l10n_br_zip_res_partner_form" model="ir.ui.view">
        <field name="name">l10n_br_base.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_br_base.l10n_br_base_res_partner_address" />
        <field name="priority" eval="33" />
        <field name="arch" type="xml">
            <field name="zip" position="after">
                <button
                    name="zip_search"
                    type="object"
                    invisible="country_id != %(base.br)d"
                    class="oi btn-sm btn-link mb4 oe_edit_only"
                    data-icon="search"
                    aria-label="Pesquisar CEP"
                    data-tooltip="Pesquisar CEP"
                />
            </field>
        </field>
    </record>
</odoo>
