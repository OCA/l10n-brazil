#. module: l10n_br_fiscal_notification
#: model:mail.template,body_html:l10n_br_fiscal_notification.fiscal_document_change_state_template
#: model:mail.template,body_html:l10n_br_fiscal_notification.fiscal_document_change_state_template_nfse
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                Hello <t t-out=\"object.partner_id.name\"/>,\n"
"                <br/><br/>\n"
"                The Fiscal Document <t t-out=\"object.document_number\"/> has changed:\n"
"                <br/>\n"
"                Document Number: <t t-out=\"object.document_number\"/>\n"
"                <br/>\n"
"                Document Serie: <t t-out=\"object.document_serie\"/>\n"
"                <br/>\n"
"                Document Key: <t t-out=\"object.document_key\"/>\n"
"                <br/>\n"
"                Document Status: <t t-out=\"dict(object.fields_get('state').get('state').get('selection')).get(object.state, '')\"/>\n"
"            </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                Olá <t t-out=\"object.partner_id.name\"/>,\n"
"                <br/><br/>\n"
"                O documento fiscal <t t-out=\"object.document_number\"/> foi "
"alterado:\n"
"                <br/>\n"
"                Número do documento: <t t-out=\"object.document_number\"/>\n"
"                <br/>\n"
"                Série do documento: <t t-out=\"object.document_serie\"/>\n"
"                <br/>\n"
"                Chave do documento: <t t-out=\"object.document_key\"/>\n"
"                <br/>\n"
"                Situação do documento: <t t-out=\"dict(object.fields_get"
"('state').get('state').get('selection')).get(object.state, '')\"/>\n"
"            </p>\n"
"            </div>\n"
"        "

