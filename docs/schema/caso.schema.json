{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "caso.schema.json",
  "title": "Caso de QA",
  "description": "Cada arquivo docs/casos/<familia>.yaml e uma lista de casos. Mesmo formato do catalogo ja em uso, mais 'requisitos'; o campo 'series' nao existe porque a branch e a serie. Regra do validador: estado coberto exige visto_em.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "titulo", "camada", "modulo", "nivel", "familia", "gatilhos", "execucao", "asserts", "fonte", "estado", "ratificado_por"],
    "properties": {
      "id": {"type": "string", "pattern": "^BR-[A-Z]+-[A-Z0-9]+-[0-9]{3}$"},
      "titulo": {"type": "string", "minLength": 1},
      "camada": {"type": "string"},
      "modulo": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "nivel": {"type": "string"},
      "familia": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "nucleo": {"type": "boolean"},
      "gatilhos": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tipo", "ref"],
          "properties": {
            "tipo": {"type": "string", "enum": ["caminho", "simbolo", "view_xpath", "xmlid"]},
            "ref": {"type": "string", "minLength": 1}
          }
        }
      },
      "precondicoes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xmlid": {"type": "string"},
            "descricao": {"type": "string"}
          }
        }
      },
      "execucao": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ui"],
        "properties": {
          "ui": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passos_humanos"],
            "properties": {
              "passos_humanos": {"type": "string", "minLength": 1},
              "script": {"type": "string"}
            }
          }
        }
      },
      "asserts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["via"],
          "properties": {
            "via": {"type": "string", "enum": ["rpc", "ui", "xml", "manual", "sql"]},
            "modelo": {"type": "string"},
            "campo": {"type": "string"},
            "esperado": {},
            "ref": {"type": "string"}
          }
        }
      },
      "evidencia": {"type": "string"},
      "visto_em": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
      "fonte": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "estado": {"type": "string"},
      "ratificado_por": {"type": ["string", "null"]},
      "requisitos": {
        "type": "array",
        "items": {"type": "string", "pattern": "^REQ-[a-z0-9][a-z0-9-]*-[0-9]{2}$"}
      },
      "notas": {"type": "string"}
    }
  }
}
