<!-- Siscomex numeric currency codes. The DUIMP/DI identify currencies by
     this numeric code, not by the ISO name. Only the most common import
     currencies are seeded here; complete the table from the official
     Siscomex currency table (Tabela de Moedas) when needed. -->
<odoo noupdate="1">

    <record id="base.USD" model="res.currency">
        <field name="siscomex_code">220</field>
    </record>
    <record id="base.EUR" model="res.currency">
        <field name="siscomex_code">978</field>
    </record>
    <record id="base.GBP" model="res.currency">
        <field name="siscomex_code">540</field>
    </record>
    <record id="base.JPY" model="res.currency">
        <field name="siscomex_code">470</field>
    </record>
    <record id="base.CNY" model="res.currency">
        <field name="siscomex_code">715</field>
    </record>

</odoo>
