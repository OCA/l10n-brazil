<odoo>
    <record id="duimp_tax_warning_wizard_form" model="ir.ui.view">
        <field name="name">l10n_br_duimp.tax_warning_wizard.form</field>
        <field name="model">l10n_br_duimp.tax_warning_wizard</field>
        <field name="arch" type="xml">
            <form string="Taxes not registered">
                <div class="alert alert-warning" role="alert">
                    <field name="message" readonly="1" nolabel="1" />
                </div>
                <field name="declaration_id" invisible="1" />
                <footer>
                    <button
                        name="action_confirm"
                        string="Generate Anyway"
                        class="btn-primary"
                        type="object"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
