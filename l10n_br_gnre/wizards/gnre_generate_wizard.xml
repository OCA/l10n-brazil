<odoo>
    <record id="gnre_generate_wizard_form" model="ir.ui.view">
        <field name="model">l10n_br_gnre.generate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <group>
                        <field name="fiscal_state_ids" widget="many2many_tags" />
                        <field name="obligation_count" />
                        <field name="guide_count" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_generate"
                        string="Gerar Guias"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="gnre_generate_wizard_action" model="ir.actions.act_window">
        <field name="name">Gerar Guias GNRE</field>
        <field name="res_model">l10n_br_gnre.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
