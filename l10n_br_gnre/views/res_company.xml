<odoo>
    <record id="res_company_form" model="ir.ui.view">
        <field name="name">res.company.form (in l10n_br_gnre)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='edoc']/group[@name='edoc']" position="after">
                <group name="gnre" string="GNRE">
                    <field name="gnre_environment" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
