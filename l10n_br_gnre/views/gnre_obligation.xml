<odoo>
    <record id="gnre_obligation_tree" model="ir.ui.view">
        <field name="model">l10n_br_gnre.obligation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_due" />
                <field name="fiscal_state_id" />
                <field name="revenue_code" />
                <field name="document_id" />
                <field name="amount_total" sum="Total" />
                <field name="guide_id" />
                <field name="state" widget="badge" />
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="gnre_obligation_form" model="ir.ui.view">
        <field name="model">l10n_br_gnre.obligation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_cancel"
                        string="Cancelar"
                        type="object"
                        attrs="{'invisible': [('state', 'not in', ['pending', 'grouped'])]}"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group string="Origem">
                            <field name="document_id" />
                            <field name="config_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group string="Recolhimento">
                            <field name="fiscal_state_id" />
                            <field name="revenue_code" />
                            <field name="detail_revenue_code" />
                            <field name="obligation_code" />
                            <field name="authority_partner_id" />
                        </group>
                        <group string="Valores">
                            <field name="amount_principal" />
                            <field name="amount_fcp" />
                            <field name="amount_fine" />
                            <field name="amount_interest" />
                            <field name="amount_total" />
                            <field name="currency_id" invisible="1" />
                        </group>
                        <group string="Período">
                            <field name="period_ref" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="date_due" />
                        </group>
                    </group>
                    <group string="Guia">
                        <field name="guide_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gnre_obligation_search" model="ir.ui.view">
        <field name="model">l10n_br_gnre.obligation</field>
        <field name="arch" type="xml">
            <search>
                <field name="fiscal_state_id" />
                <field name="revenue_code" />
                <field name="document_id" />
                <filter
                    name="pending"
                    string="Pendentes"
                    domain="[('state', '=', 'pending')]"
                />
                <group expand="0" string="Agrupar por">
                    <filter
                        name="group_state"
                        string="UF Favorecida"
                        context="{'group_by': 'fiscal_state_id'}"
                    />
                    <filter
                        name="group_due"
                        string="Vencimento"
                        context="{'group_by': 'date_due'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="gnre_obligation_action" model="ir.actions.act_window">
        <field name="name">Obrigações de GNRE</field>
        <field name="res_model">l10n_br_gnre.obligation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
