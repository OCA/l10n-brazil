<odoo>
    <record id="gnre_state_config_tree" model="ir.ui.view">
        <field name="model">l10n_br_gnre.state.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="fiscal_state_id" />
                <field name="tax_group_id" />
                        <field name="amount_source" />
                <field name="revenue_code" />
                <field name="mode" />
                <field name="due_days" />
                <field name="authority_partner_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="gnre_state_config_form" model="ir.ui.view">
        <field name="model">l10n_br_gnre.state.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Abrangência">
                            <field name="fiscal_state_id" />
                            <field name="tax_group_id" />
                        <field name="amount_source" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" />
                        </group>
                        <group string="Recolhimento">
                            <field name="revenue_code" />
                            <field name="detail_revenue_code" />
                            <field name="convenio" />
                            <field name="authority_partner_id" />
                        </group>
                        <group string="Apuração">
                            <field name="mode" />
                            <field name="period" />
                            <field name="due_days" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gnre_state_config_action" model="ir.actions.act_window">
        <field name="name">Regras de GNRE por UF</field>
        <field name="res_model">l10n_br_gnre.state.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
