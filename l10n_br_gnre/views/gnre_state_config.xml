<odoo>
    <record id="gnre_state_config_list" model="ir.ui.view">
        <field name="model">l10n_br_gnre.state.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="fiscal_state_id" />
                <field name="tax_group_id" />
                <field name="amount_source" />
                <field name="revenue_code" />
                <field name="mode" />
                <field name="due_days" />
                <field name="authority_partner_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="gnre_state_config_form" model="ir.ui.view">
        <field name="model">l10n_br_gnre.state.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_gnre_fetch_rules"
                        type="object"
                        string="Consultar Regras no Portal"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <group string="Abrangência">
                            <field name="fiscal_state_id" />
                            <field name="tax_group_id" />
                            <field name="amount_source" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" />
                        </group>
                        <group string="Recolhimento">
                            <field name="revenue_code" />
                            <field name="detail_revenue_code" />
                            <field name="convenio" />
                            <field name="recipient_required" />
                            <field name="authority_partner_id" />
                        </group>
                        <group string="Apuração">
                            <field name="mode" />
                            <field name="period" />
                            <field name="due_days" />
                        </group>
                        <group string="Exigências da UF">
                            <field name="origin_document_type" />
                            <field name="period_reference" />
                            <field name="payment_date_required" />
                            <field name="fcp_required" />
                        </group>
                    </group>
                    <field name="extra_field_ids">
                        <list editable="bottom">
                            <field name="code" />
                            <field name="name" />
                            <field name="field_type" />
                            <field name="source" />
                            <field name="fixed_value" />
                        </list>
                    </field>
                    <field name="portal_rules" invisible="not portal_rules" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="gnre_state_config_action" model="ir.actions.act_window">
        <field name="name">Regras de GNRE por UF</field>
        <field name="res_model">l10n_br_gnre.state.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
