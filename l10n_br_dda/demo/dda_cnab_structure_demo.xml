        <field name="bank_id" ref="l10n_br_base.res_bank_341" />
        <field
            name="payment_method_id"
            ref="l10n_br_account_payment_order.payment_mode_type_cnab240"
        />
        <field name="is_dda_return" eval="True" />
        <field name="conf_bank_start_pos">1</field>
        <field name="conf_bank_end_pos">3</field>
        <field name="conf_batch_start_pos">4</field>
        <field name="conf_batch_end_pos">7</field>
        <field name="conf_record_type_start_pos">8</field>
        <field name="conf_record_type_end_pos">8</field>
