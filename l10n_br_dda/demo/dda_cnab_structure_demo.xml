        <field name="conf_detail_end_pos">13</field>
        <field name="record_type_file_header_id">0</field>
        <field name="record_type_file_trailer_id">9</field>
        <field name="record_type_batch_header_id">1</field>
        <field name="record_type_batch_trailer_id">5</field>
        <field name="record_type_detail_id">3</field>
        <field name="state">approved</field>
