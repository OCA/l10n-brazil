<odoo>
    <record id="dda_import_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_br_dda.import.wizard.form</field>
        <field name="model">l10n_br_dda.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="cnab_structure_id" required="1" />
                    <field name="return_file" filename="filename" required="1" />
                    <field name="filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dda_import_wizard" model="ir.actions.act_window">
        <field name="name">Import DDA file</field>
        <field name="res_model">l10n_br_dda.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
