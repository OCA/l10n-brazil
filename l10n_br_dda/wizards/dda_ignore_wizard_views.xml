<odoo>

    <record id="dda_ignore_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_br_dda.ignore.wizard.form</field>
        <field name="model">l10n_br_dda.ignore.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="debit_ids" widget="many2many_tags" />
                    <field name="reason" placeholder="Why is the boleto ignored?" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Ignore"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
