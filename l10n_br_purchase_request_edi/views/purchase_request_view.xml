<odoo>
    <record id="purchase_request_form" model="ir.ui.view">
        <field name="name">l10n_br_purchase_request_edi.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_view_import_documents"
                    type="object"
                    help="Imported fiscal documents linked to this record"
                    groups="l10n_br_fiscal.group_user"
                    attrs="{'invisible': [('import_document_count', '=', 0)]}"
                    icon="fa-file-text-o"
                >
                    <field
                        name="import_document_count"
                        widget="statinfo"
                        string="Fiscal docs"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
