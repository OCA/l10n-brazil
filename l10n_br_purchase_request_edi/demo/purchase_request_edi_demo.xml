<?xml version="1.0" encoding="utf-8" ?>
<!--
    Demo of the purchase request link, in the company "Empresa Lucro Presumido",
    with the supplier of the purchases link.

    An approved purchase request for 10 units of a product, and the note
    35261011765432000100550010000040011400100017 of the supplier for 8 units of
    it, with no order. The reviewer opens the note, "Match with Orders", selects
    the request line and uses "Create order from request".
-->
<odoo noupdate="1">

    <record id="demo_product_request" model="product.template">
        <field name="name">Luva de proteção demo</field>
        <field name="detailed_type">consu</field>
        <field name="purchase_ok" eval="True" />
        <field name="ncm_id" ref="l10n_br_fiscal.ncm_00000000" />
    </record>

    <record id="demo_supplierinfo_request" model="product.supplierinfo">
        <field name="partner_id" ref="l10n_br_purchase_edi.demo_supplier" />
        <field name="product_tmpl_id" ref="demo_product_request" />
        <field
            name="product_id"
            search="[('product_tmpl_id', '=', ref('demo_product_request'))]"
        />
        <field name="product_code">DEMO-REQ-E</field>
        <field name="price">140.0</field>
    </record>

    <record id="demo_request" model="purchase.request">
        <field name="company_id" ref="l10n_br_base.empresa_lucro_presumido" />
        <field name="requested_by" ref="base.user_admin" />
        <field name="origin">Demonstração EDI</field>
        <field
            name="picking_type_id"
            search="[('code', '=', 'incoming'), ('warehouse_id.company_id', '=', ref('l10n_br_base.empresa_lucro_presumido'))]"
        />
    </record>
    <record id="demo_request_line" model="purchase.request.line">
        <field name="request_id" ref="demo_request" />
        <field
            name="product_id"
            search="[('product_tmpl_id', '=', ref('demo_product_request'))]"
        />
        <field name="name">Luva de proteção demo</field>
        <field name="product_qty">10</field>
        <field name="product_uom_id" ref="uom.product_uom_unit" />
        <field name="estimated_cost">1120.0</field>
        <field name="date_required" eval="DateTime.now()" />
    </record>
    <function model="purchase.request" name="button_to_approve">
        <value eval="[ref('demo_request')]" />
    </function>
    <function model="purchase.request" name="button_approved">
        <value eval="[ref('demo_request')]" />
    </function>

    <function model="l10n_br_fiscal.document" name="_edi_import_demo_files">
        <value>l10n_br_purchase_request_edi</value>
        <value
            eval="['demo/import/nfe_35261011765432000100550010000040011400100017.xml']"
        />
    </function>

</odoo>
