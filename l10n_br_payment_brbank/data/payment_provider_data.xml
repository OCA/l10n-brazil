        <field name="name">Banco Inter (Boleto)</field>
        <field name="code">brbank</field>
        <field name="brbank_adapter">inter</field>
        <field name="state">disabled</field>
        <field name="is_published" eval="False" />
        <field
            name="image_128"
            type="base64"
            file="l10n_br_payment_brbank/static/description/icon.png"
        />
        <field name="module_id" ref="base.module_l10n_br_payment_brbank" />
        <field
            name="payment_method_ids"
            eval="[Command.set([ref('payment.payment_method_boleto')])]"
