<odoo>
    <record id="account_payment_mode_form_brbank" model="ir.ui.view">
        <field name="name">account.payment.mode.form.brbank</field>
        <field name="model">account.payment.mode</field>
        <field name="inherit_id" ref="l10n_br_payment.account_payment_mode_form_view" />
        <field name="arch" type="xml">
            <field name="payment_provider_id" position="after">
                <field name="payment_provider_code" invisible="1" />
                <field name="brbank_sandbox_validated" invisible="1" />
                <field
                    name="brbank_capabilities"
                    invisible="payment_provider_code != 'brbank'"
                />
                <div
                    colspan="2"
                    class="text-warning"
                    invisible="payment_provider_code != 'brbank' or brbank_sandbox_validated"
                >
                    The bank adapter of this provider has not been validated in
                    the bank sandbox yet.
                </div>
            </field>
        </field>
    </record>
</odoo>
