<odoo>
    <template
        id="portal_invoice_page_brbank"
        inherit_id="l10n_br_payment.portal_invoice_page_boleto"
    >
        <xpath expr="//div[hasclass('o_boleto_actions')]" position="inside">
            <a
                t-if="boleto_tx.boleto_pdf"
                class="btn btn-light w-100"
                t-att-href="'/my/invoices/%s/brbank/%s?access_token=%s&amp;download=true' % (invoice.id, boleto_tx.id, invoice._portal_ensure_token())"
            >
                <i class="fa fa-download" /> Download boleto (PDF)
            </a>
        </xpath>
    </template>
</odoo>
