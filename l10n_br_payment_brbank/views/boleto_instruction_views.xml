<odoo>

    <record id="boleto_instruction_form" model="ir.ui.view">
        <field name="name">l10n_br.boleto.instruction.form</field>
        <field name="model">l10n_br.boleto.instruction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_send"
                        type="object"
                        string="Send to the bank"
                        class="oe_highlight"
                        states="draft"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field
                                name="transaction_id"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                                options="{'no_create': True}"
                            />
                            <field
                                name="command"
                                widget="radio"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                            />
                            <field
                                name="new_due_date"
                                attrs="{'invisible': [('command', '!=', 'prorrogacao')], 'required': [('command', '=', 'prorrogacao')], 'readonly': [('state', '!=', 'draft')]}"
                            />
                            <field name="currency_id" invisible="1" />
                            <field
                                name="amount"
                                attrs="{'invisible': [('command', '!=', 'abatimento')], 'required': [('command', '=', 'abatimento')], 'readonly': [('state', '!=', 'draft')]}"
                            />
                        </group>
                        <group>
                            <field name="provider_id" />
                            <field name="result_message" />
                            <field name="idempotency_key" groups="base.group_no_one" />
                            <field name="bank_response" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="boleto_instruction_tree" model="ir.ui.view">
        <field name="name">l10n_br.boleto.instruction.tree</field>
        <field name="model">l10n_br.boleto.instruction</field>
        <field name="arch" type="xml">
            <tree
                decoration-success="state == 'done'"
                decoration-danger="state in ('rejected', 'error')"
            >
                <field name="create_date" />
                <field name="transaction_id" />
                <field name="command" />
                <field name="new_due_date" optional="show" />
                <field name="currency_id" invisible="1" />
                <field name="amount" optional="show" />
                <field name="state" />
                <field name="result_message" />
            </tree>
        </field>
    </record>

    <record id="boleto_instruction_search" model="ir.ui.view">
        <field name="name">l10n_br.boleto.instruction.search</field>
        <field name="model">l10n_br.boleto.instruction</field>
        <field name="arch" type="xml">
            <search>
                <field name="transaction_id" />
                <field name="command" />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_failed"
                    string="Rejected or Error"
                    domain="[('state', 'in', ('rejected', 'error'))]"
                />
            </search>
        </field>
    </record>

    <record id="boleto_instruction_action" model="ir.actions.act_window">
        <field name="name">Boleto Instructions</field>
        <field name="res_model">l10n_br.boleto.instruction</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="boleto_instruction_menu"
        action="boleto_instruction_action"
        parent="account.menu_finance_receivables"
        sequence="120"
        groups="account.group_account_invoice"
    />

</odoo>
