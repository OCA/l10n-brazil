<odoo>

    <record id="payment_provider_form_brbank" model="ir.ui.view">
        <field name="name">payment.provider.form.brbank</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='provider_creation_warning']" position="after">
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': ['|', ('code', '!=', 'brbank'), ('brbank_sandbox_validated', '=', True)]}"
                >
                    This bank adapter has not been validated in the bank sandbox
                    yet. Test it with low amounts before using it in production.
                </div>
            </xpath>
            <group name="provider_credentials" position="inside">
                <group
                    name="brbank_adapter"
                    string="Bank"
                    attrs="{'invisible': [('code', '!=', 'brbank')]}"
                >
                    <field name="brbank_sandbox_validated" invisible="1" />
                    <field name="brbank_is_pix" invisible="1" />
                    <field name="brbank_supports_webhook" invisible="1" />
                    <field
                        name="brbank_adapter"
                        attrs="{'required': [('code', '=', 'brbank'), ('state', '!=', 'disabled')]}"
                    />
                    <field
                        name="brbank_pix_perfil"
                        attrs="{'invisible': [('brbank_is_pix', '=', False)], 'required': [('brbank_is_pix', '=', True), ('state', '!=', 'disabled')]}"
                    />
                    <field
                        name="brbank_connection_id"
                        attrs="{'required': [('code', '=', 'brbank'), ('state', '!=', 'disabled')]}"
                        context="{'default_adapter': brbank_adapter, 'default_pix_profile': brbank_pix_perfil, 'default_name': name}"
                    />
                    <field name="brbank_capabilities" />
                    <field name="brbank_supports_instruction" invisible="1" />
                    <field
                        name="brbank_rebate_account_id"
                        attrs="{'invisible': [('brbank_supports_instruction', '=', False)]}"
                    />
                    <field
                        name="brbank_nosso_numero_sequence_id"
                        attrs="{'invisible': [('brbank_nosso_numero_sequence_id', '=', False)]}"
                    />
                </group>
            </group>
        </field>
    </record>

</odoo>
