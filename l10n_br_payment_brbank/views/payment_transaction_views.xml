<odoo>

    <record id="payment_transaction_form_brbank" model="ir.ui.view">
        <field name="name">payment.transaction.form.brbank</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="brbank_supports_pdf" invisible="1" />
                <field name="brbank_supports_instruction" invisible="1" />
                <field name="brbank_supports_write_off" invisible="1" />
                <button
                    name="action_brbank_register"
                    type="object"
                    string="Register at the bank"
                    class="oe_highlight"
                    attrs="{'invisible': ['|', '|', ('provider_code', '!=', 'brbank'), ('provider_reference', '!=', False), ('state', '!=', 'draft')]}"
                />
                <button
                    name="action_brbank_check_status"
                    type="object"
                    string="Check at the bank"
                    attrs="{'invisible': ['|', ('provider_code', '!=', 'brbank'), ('provider_reference', '=', False)]}"
                />
                <button
                    name="action_brbank_download_pdf"
                    type="object"
                    string="Boleto PDF"
                    attrs="{'invisible': ['|', '|', ('provider_code', '!=', 'brbank'), ('provider_reference', '=', False), ('brbank_supports_pdf', '=', False)]}"
                />
                <button
                    name="action_brbank_new_instruction"
                    type="object"
                    string="Bank instruction"
                    attrs="{'invisible': ['|', '|', '|', ('provider_code', '!=', 'brbank'), ('provider_reference', '=', False), ('state', '!=', 'authorized'), ('brbank_supports_instruction', '=', False)]}"
                />
                <button
                    name="action_brbank_write_off"
                    type="object"
                    string="Write off at the bank"
                    confirm="The bank will cancel this boleto. Continue?"
                    attrs="{'invisible': ['|', '|', '|', ('provider_code', '!=', 'brbank'), ('provider_reference', '=', False), ('state', '!=', 'authorized'), ('brbank_supports_write_off', '=', False)]}"
                />
            </xpath>
            <xpath expr="//group[@name='boleto_info']" position="inside">
                <field
                    name="brbank_seu_numero"
                    attrs="{'invisible': [('provider_code', '!=', 'brbank')]}"
                />
                <field
                    name="brbank_nosso_numero"
                    attrs="{'invisible': [('brbank_nosso_numero', '=', False)]}"
                />
                <field
                    name="brbank_bank_status"
                    attrs="{'invisible': [('provider_code', '!=', 'brbank')]}"
                />
                <field
                    name="brbank_review_message"
                    class="text-warning"
                    attrs="{'invisible': [('brbank_review_message', '=', False)]}"
                />
                <field
                    name="brbank_paid_amount"
                    attrs="{'invisible': [('brbank_paid_amount', '=', 0)]}"
                />
                <field
                    name="brbank_paid_date"
                    attrs="{'invisible': [('brbank_paid_date', '=', False)]}"
                />
                <field
                    name="brbank_last_check"
                    attrs="{'invisible': [('provider_code', '!=', 'brbank')]}"
                />
            </xpath>
            <xpath expr="//group[@name='technical_info']" position="inside">
                <field
                    name="brbank_idempotency_key"
                    attrs="{'invisible': [('provider_code', '!=', 'brbank')]}"
                />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group
                    string="Bank Instructions"
                    name="brbank_instructions"
                    attrs="{'invisible': [('brbank_instruction_ids', '=', [])]}"
                >
                    <field name="brbank_instruction_ids" nolabel="1" colspan="2" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
