<odoo>
    <record id="invoice_form_brbank" model="ir.ui.view">
        <field name="name">account.move.form.brbank</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_br_account_due_list.invoice_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='receivable_move_line_tab']/field[@name='due_line_ids']"
                position="inside"
            >
                <tree>
                    <field name="currency_id" invisible="1" />
                    <field name="brbank_instruction_available" invisible="1" />
                    <field name="date_maturity" />
                    <field name="name" />
                    <field name="amount_currency" />
                    <field name="amount_residual_currency" />
                    <field name="reconciled" />
                    <button
                        name="action_brbank_new_instruction"
                        type="object"
                        string="Bank instruction"
                        icon="fa-university"
                        attrs="{'invisible': [('brbank_instruction_available', '=', False)]}"
                        groups="account.group_account_invoice"
                    />
                </tree>
            </xpath>
        </field>
    </record>
</odoo>
