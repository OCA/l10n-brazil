<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="payment_provider_cielo" model="payment.provider">
        <field name="name">Cielo</field>
        <field name="code">cielo</field>
        <field name="display_as">Credit Card (powered by Cielo)</field>
        <field
            name="image_128"
            type="base64"
            file="payment_cielo/static/src/img/cielo_icon.png"
        />
        <field name="inline_form_view_id" ref="inline_form" />
        <field name="module_id" ref="base.module_payment_cielo" />
        <field
            name="payment_icon_ids"
            eval="[(6, 0, [
                ref('payment.payment_icon_cc_visa'),
                ref('payment.payment_icon_cc_mastercard'),
                ref('payment.payment_icon_cc_american_express'),
                ref('payment.payment_icon_cc_diners_club_intl'),
                ref('payment.payment_icon_cc_discover'),
                ref('payment.payment_icon_cc_jcb'),
                ref('payment_cielo.payment_icon_elo'),
            ])]"
        />
    </record>
</odoo>
