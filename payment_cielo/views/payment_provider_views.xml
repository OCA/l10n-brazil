<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment_cielo.provider.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group attrs="{'invisible': [('code', '!=', 'cielo')]}">
                    <field name="cielo_merchant_id" password="True" />
                    <field name="cielo_merchant_key" password="True" />
                </group>
            </group>
            <group name="provider_config" position="inside">
                <group attrs="{'invisible': [('code', '!=', 'cielo')]}">
                    <field name="cielo_image_url" />
                </group>
            </group>
        </field>
    </record>

</odoo>
