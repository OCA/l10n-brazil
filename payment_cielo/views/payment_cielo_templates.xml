<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="inline_form">
        <div t-attf-id="o_cielo_form_{{provider_id}}" class="o_cielo_form">
            <div class="mb-3">
                <label
                    t-attf-for="o_cielo_card_{{provider_id}}"
                    class="col-form-label"
                >Card Number</label>
                <input
                    type="text"
                    t-attf-id="o_cielo_card_{{provider_id}}"
                    required="required"
                    maxlength="19"
                    inputmode="numeric"
                    class="form-control"
                />
            </div>
            <div class="mb-3">
                <label
                    t-attf-for="o_cielo_holder_{{provider_id}}"
                    class="col-form-label"
                >Card Holder</label>
                <input
                    type="text"
                    t-attf-id="o_cielo_holder_{{provider_id}}"
                    required="required"
                    maxlength="50"
                    class="form-control"
                />
            </div>
            <div class="row">
                <div class="col-sm-8 mb-3">
                    <label t-attf-for="o_cielo_month_{{provider_id}}">Expiration</label>
                    <div class="input-group">
                        <input
                            type="number"
                            t-attf-id="o_cielo_month_{{provider_id}}"
                            placeholder="MM"
                            min="1"
                            max="12"
                            required="required"
                            class="form-control"
                        />
                        <input
                            type="number"
                            t-attf-id="o_cielo_year_{{provider_id}}"
                            placeholder="YY"
                            min="0"
                            max="99"
                            required="required"
                            class="form-control"
                        />
                    </div>
                </div>
                <div class="col-sm-4 mb-3">
                    <label t-attf-for="o_cielo_code_{{provider_id}}">Card Code</label>
                    <input
                        type="number"
                        t-attf-id="o_cielo_code_{{provider_id}}"
                        max="9999"
                        required="required"
                        class="form-control"
                    />
                </div>
            </div>
        </div>
    </template>

</odoo>
