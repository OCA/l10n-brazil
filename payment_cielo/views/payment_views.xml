<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="provider_form_cielo" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <xpath expr='//page[@name="credentials"]' position='inside'>
                <group attrs="{'invisible': [('code', '!=', 'cielo')]}">
                    <field name="cielo_merchant_id" password="True" />
                    <field name="cielo_merchant_key" password="True" />
                </group>
            </xpath>
            <xpath expr='//group[@name="provider_config"]' position='after'>
                <group attrs="{'invisible': [('code', '!=', 'cielo')]}">
                    <field name="cielo_image_url" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
