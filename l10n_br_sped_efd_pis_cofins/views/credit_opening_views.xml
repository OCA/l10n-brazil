<odoo>
    <record id="credit_opening_import_form" model="ir.ui.view">
        <field name="name">l10n_br_pis_cofins.credit.opening.import.form</field>
        <field name="model">l10n_br_pis_cofins.credit.opening.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="file" filename="filename" />
                    <field name="filename" invisible="1" />
                </group>
                <div class="alert alert-info" role="alert">
                    Escolha o arquivo da última EFD Contribuições transmitida pelo
                    sistema anterior. O saldo de cada período de origem e tipo de
                    crédito (registros 1100 e 1500) vira um lançamento de saldo
                    inicial, válido a partir do mês seguinte ao do arquivo.
                </div>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Importar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="credit_opening_import_action" model="ir.actions.act_window">
        <field name="name">Importar saldo inicial da EFD Contribuições</field>
        <field name="res_model">l10n_br_pis_cofins.credit.opening.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="credit_opening_tree" model="ir.ui.view">
        <field name="name">l10n_br_pis_cofins.credit.opening.tree</field>
        <field name="model">l10n_br_pis_cofins.credit.opening</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_id" groups="base.group_multi_company" />
                <field name="tax_domain" />
                <field name="origin_period" />
                <field name="cod_cred" />
                <field name="orig_cred" />
                <field name="amount" sum="Total" />
                <field name="used_before" sum="Total" />
                <field name="balance" sum="Total" />
                <field name="cutoff_date" />
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="credit_opening_form" model="ir.ui.view">
        <field name="name">l10n_br_pis_cofins.credit.opening.form</field>
        <field name="model">l10n_br_pis_cofins.credit.opening</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Informe aqui o crédito de PIS e de COFINS que a empresa já
                        tinha acumulado antes de usar o sistema. Os valores vêm da
                        última EFD Contribuições transmitida pelo sistema anterior,
                        nos registros 1100 (PIS) e 1500 (COFINS): um lançamento para
                        cada período de origem e tipo de crédito. Esse saldo é usado
                        primeiro (é o crédito mais antigo) e a apuração do primeiro
                        mês no sistema parte dele. O sistema não faz lançamento
                        contábil: o saldo de impostos a recuperar deve estar no
                        balanço de abertura.
                    </div>
                    <group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="tax_domain" />
                            <field name="cutoff_date" />
                        </group>
                        <group>
                            <field name="origin_period" />
                            <field name="cod_cred" />
                            <field name="orig_cred" />
                            <field
                                name="cnpj_suc"
                                attrs="{'invisible': [('orig_cred', '!=', '02')], 'required': [('orig_cred', '=', '02')]}"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1" />
                        <field name="amount" />
                        <field name="used_before" />
                        <field name="balance" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="credit_opening_action" model="ir.actions.act_window">
        <field name="name">Saldo inicial de crédito de PIS/COFINS</field>
        <field name="res_model">l10n_br_pis_cofins.credit.opening</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_credit_opening_import"
        name="Importar saldo inicial da EFD Contribuições"
        parent="account.menu_finance_entries_actions"
        action="credit_opening_import_action"
        groups="account.group_account_manager"
        sequence="93"
    />

    <menuitem
        id="menu_credit_opening"
        name="Saldo inicial de crédito de PIS/COFINS"
        parent="account.menu_finance_entries_actions"
        action="credit_opening_action"
        groups="account.group_account_manager"
        sequence="92"
    />
</odoo>
