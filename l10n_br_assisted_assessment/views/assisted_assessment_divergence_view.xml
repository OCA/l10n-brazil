<odoo>
    <record id="view_assessment_divergence_list" model="ir.ui.view">
        <field name="name">l10n_br_assessment.divergence.list</field>
        <field name="model">l10n_br_assessment.divergence</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'open'">
                <field name="divergence_type" />
                <field name="line_type" />
                <field name="document_key" />
                <field name="document_id" />
                <field name="fisco_value" />
                <field name="local_value" />
                <field name="difference" />
                <field name="suggested_action" />
                <field name="notes" />
                <field name="state" />
                <field name="currency_id" column_invisible="1" />
                <button
                    name="action_mark_handled"
                    type="object"
                    icon="fa-check"
                    title="Mark as handled"
                    invisible="state != 'open'"
                />
                <button
                    name="action_mark_ignored"
                    type="object"
                    icon="fa-ban"
                    title="Ignore"
                    invisible="state != 'open'"
                />
            </list>
        </field>
    </record>
    <record id="view_assessment_divergence_form" model="ir.ui.view">
        <field name="name">l10n_br_assessment.divergence.form</field>
        <field name="model">l10n_br_assessment.divergence</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_mark_handled"
                        type="object"
                        string="Mark as handled"
                        class="btn-primary"
                        invisible="state != 'open'"
                    />
                    <button
                        name="action_mark_ignored"
                        type="object"
                        string="Ignore"
                        invisible="state != 'open'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="period_id" />
                            <field name="divergence_type" />
                            <field name="document_key" />
                            <field name="document_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="line_id" />
                            <field name="line_type" />
                            <field name="fisco_value" />
                            <field name="local_value" />
                            <field name="difference" />
                            <field name="suggested_action" />
                            <field name="notes" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_assessment_divergence_search" model="ir.ui.view">
        <field name="name">l10n_br_assessment.divergence.search</field>
        <field name="model">l10n_br_assessment.divergence</field>
        <field name="arch" type="xml">
            <search>
                <field name="document_key" />
                <field name="period_id" />
                <filter name="open" string="Open" domain="[('state', '=', 'open')]" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_type"
                        string="Type"
                        context="{'group_by': 'divergence_type'}"
                    />
                    <filter
                        name="group_action"
                        string="Suggested Action"
                        context="{'group_by': 'suggested_action'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_assessment_divergence" model="ir.actions.act_window">
        <field name="name">Divergences</field>
        <field name="res_model">l10n_br_assessment.divergence</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
