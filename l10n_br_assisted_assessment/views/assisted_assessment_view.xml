<odoo>
    <record id="view_assessment_period_list" model="ir.ui.view">
        <field name="name">l10n_br_assessment.period.list</field>
        <field name="model">l10n_br_assessment.period</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state == 'expired'"
                decoration-warning="state == 'diverged'"
            >
                <field name="name" />
                <field name="per_apur" />
                <field name="tribute" />
                <field name="date_available" />
                <field name="date_deadline" />
                <field name="fisco_balance" />
                <field name="difference" />
                <field name="open_divergence_count" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>
    <record id="view_assessment_period_form" model="ir.ui.view">
        <field name="name">l10n_br_assessment.period.form</field>
        <field name="model">l10n_br_assessment.period</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_request_debits"
                        type="object"
                        string="Request Debits"
                        confirm="Opening a request consumes the daily quota of the tax administration. Continue?"
                        invisible="state in ('confirmed', 'expired')"
                    />
                    <button
                        name="action_request_credits"
                        type="object"
                        string="Request Credits"
                        confirm="Opening a request consumes the daily quota of the tax administration. Continue?"
                        invisible="state in ('confirmed', 'expired')"
                    />
                    <button
                        name="action_download_ready_requests"
                        type="object"
                        string="Download"
                        class="btn-primary"
                        invisible="not has_notified_request"
                    />
                    <button
                        name="action_apply_downloaded_requests"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                        invisible="not has_downloaded_request"
                    />
                    <button
                        name="action_reconcile"
                        type="object"
                        string="Reconcile"
                        class="btn-primary"
                        invisible="state != 'received' or not directions_ready"
                    />
                    <button
                        name="action_reconcile"
                        type="object"
                        string="Reconcile"
                        confirm="Reconciling again clears the open divergences and builds them once more. Handled or ignored divergences stay as they are, and reopen only when the amounts changed. Continue?"
                        invisible="state not in ('reconciled', 'diverged') or not directions_ready"
                    />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                        confirm="Confirming the assessment constitutes the tax credit and implies acknowledgement of debt. Continue?"
                        invisible="state not in ('reconciled', 'diverged') or open_divergence_count"
                    />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                        invisible="state != 'diverged' or not open_divergence_count"
                    />
                    <field name="state" widget="statusbar" />
                    <field name="has_notified_request" invisible="1" />
                    <field name="has_downloaded_request" invisible="1" />
                    <field name="open_divergence_count" invisible="1" />
                    <field name="local_awaiting_download" invisible="1" />
                    <field name="directions_ready" invisible="1" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="directions_ready or state not in ('requested', 'received')"
                    >Debits and credits arrive in separate requests. Request the missing direction, or mark it as absent, before reconciling.</div>
                    <group>
                        <group name="period" string="Period">
                            <field name="per_apur" />
                            <field name="tribute" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="date_from" />
                            <field name="date_to" />
                        </group>
                        <group name="deadlines" string="Deadlines">
                            <field name="date_available" />
                            <field name="date_deadline" />
                            <field name="days_to_deadline" />
                            <field
                                name="date_confirmed"
                                invisible="not date_confirmed"
                            />
                        </group>
                        <group
                            name="fisco"
                            string="Presented by the Tax Administration"
                        >
                            <field
                                name="debit_delivery"
                                widget="badge"
                                decoration-success="debit_delivery == 'received'"
                                decoration-warning="debit_delivery == 'requested'"
                                decoration-info="debit_delivery == 'none'"
                            />
                            <field
                                name="credit_delivery"
                                widget="badge"
                                decoration-success="credit_delivery == 'received'"
                                decoration-warning="credit_delivery == 'requested'"
                                decoration-info="credit_delivery == 'none'"
                            />
                            <field
                                name="no_debits"
                                invisible="debit_delivery == 'received'"
                            />
                            <field
                                name="no_credits"
                                invisible="credit_delivery == 'received'"
                            />
                            <field name="fisco_debit" />
                            <field name="fisco_credit" />
                            <field name="previous_balance" />
                            <field name="fisco_balance" />
                        </group>
                        <group name="local" string="Bookkeeping">
                            <div
                                class="alert alert-info"
                                colspan="2"
                                role="alert"
                                invisible="not local_awaiting_download"
                            >Booked totals include every authorized document. Comparison waits until each direction is downloaded or marked as absent.</div>
                            <field name="local_debit" />
                            <field name="local_credit" />
                            <field name="local_balance" />
                            <field name="difference" />
                        </group>
                    </group>
                    <notebook>
                        <page name="divergences" string="Divergences">
                            <field
                                name="divergence_ids"
                                nolabel="1"
                                context="{'default_period_id': id}"
                            />
                        </page>
                        <page name="bookkeeping" string="Bookkeeping">
                            <field
                                name="bookkeeping_line_ids"
                                nolabel="1"
                                readonly="1"
                            />
                        </page>
                        <page name="lines" string="Assessment Lines">
                            <field name="line_ids" nolabel="1" readonly="1" />
                        </page>
                        <page name="requests" string="Requests">
                            <field name="all_request_ids" nolabel="1" readonly="1" />
                        </page>
                    </notebook>
                    <field name="currency_id" invisible="1" />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="view_assessment_period_search" model="ir.ui.view">
        <field name="name">l10n_br_assessment.period.search</field>
        <field name="model">l10n_br_assessment.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="per_apur" />
                <filter
                    name="pending"
                    string="Pending Action"
                    domain="[('state', 'not in', ('confirmed', 'expired'))]"
                />
                <filter
                    name="diverged"
                    string="With Divergences"
                    domain="[('state', '=', 'diverged')]"
                />
                <filter
                    name="confirmed"
                    string="Confirmed"
                    domain="[('state', '=', 'confirmed')]"
                />
                <filter
                    name="expired"
                    string="Expired"
                    domain="[('state', '=', 'expired')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_tribute"
                        string="Tribute"
                        context="{'group_by': 'tribute'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_assessment_period" model="ir.actions.act_window">
        <field name="name">Assisted Assessments</field>
        <field name="res_model">l10n_br_assessment.period</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
