<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_form_view" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n_sale_commission</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10" />
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//app[@name='sale_management']/block[@name='invoicing_setting_container']"
                position="inside"
            >
                <setting id="l10n_br_sale_commission_settings" string="Commission">
                    <field name="commission_product_id" options="{'no_create': True}" />
                    <div
                        class="content-group"
                        invisible="not commission_product_id"
                        name="commission_product_id_container"
                    >
                        <field name="allowed_product_ids" invisible="1" />
                    </div>
                </setting>
                <setting
                    id="l10n_br_sale_commission_fiscal_settings"
                    string="Brazilian Fiscal Document"
                >
                    <field name="commission_gen_br_fiscal_doc" />
                    <div
                        class="content-group"
                        invisible="not commission_gen_br_fiscal_doc"
                    >
                        <field
                            name="commission_document_type_id"
                            options="{'no_create': True}"
                        />
                        <field
                            name="commission_fiscal_operation_id"
                            options="{'no_create': True}"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
