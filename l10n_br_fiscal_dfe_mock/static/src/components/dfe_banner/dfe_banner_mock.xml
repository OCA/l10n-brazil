<templates xml:space="preserve">

    <!-- Mock controls on top of the DF-e banner. Only nfe uses dfe_mock_mode
         today, and only fiscal managers can flip it, so mock_available keeps
         everything below out of the way otherwise. -->
    <t t-inherit="l10n_br_fiscal_dfe.DfeBanner" t-inherit-mode="extension">
        <xpath expr="//div[@class='mb-3']" position="before">
            <t t-if="state.data.mock_available">
                <div
                    t-if="state.data.mock_mode"
                    class="o_dfe_mock_banner alert alert-warning d-flex align-items-center justify-content-between mb-3"
                    role="alert"
                >
                    <div class="d-flex align-items-center">
                        <i class="fa fa-flask me-2 fs-4" />
                        <span class="fw-bold">MOCK MODE ACTIVE</span>
                        <span class="ms-2">— <t t-esc="mockActiveMessage" /></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-dark text-nowrap o_dfe_mock_toggle"
                            t-on-click="onToggleMock"
                        >
                            <i class="fa fa-power-off me-1" />Disable Mock
                        </button>
                    </div>
                </div>
                <div
                    t-else=""
                    class="o_dfe_mock_banner alert alert-light border d-flex align-items-center justify-content-between mb-3"
                    role="alert"
                >
                    <span class="text-muted">
                        <i class="fa fa-flask me-2" />
                        <t t-esc="mockInactiveMessage" />
                    </span>
                    <button
                        type="button"
                        class="btn btn-sm btn-outline-secondary text-nowrap o_dfe_mock_toggle"
                        t-on-click="onToggleMock"
                    >
                        <i class="fa fa-flask me-1" />Enable Mock
                    </button>
                </div>
            </t>
        </xpath>
    </t>

</templates>
