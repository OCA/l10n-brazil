<odoo>
    <record id="line_cnab_preview_action" model="ir.actions.act_window">
        <field name="name">CNAB Preview</field>
        <field name="res_model">cnab.preview.wizard</field>
        <field name="binding_model_id" eval="False" />
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cnab_preview_wizard_form" />
        <field name="target">new</field>
        <field name="context">{'default_cnab_structure_id': cnab_structure_id}</field>
    </record>

    <record model="ir.ui.view" id="cnab_line_tree_view">
        <field name="model">l10n_br_cnab.line</field>
        <field name="arch" type="xml">
            <list default_order='cnab_structure_id, sequence ASC' create="false">
                <field name="state" column_invisible="True" />
                <field name="cnab_format" column_invisible="True" />
                <field name="sequence" readonly="state != 'draft'" />
                <field name="name" />
                <field name="type" readonly="state != 'draft'" />
                <field
                    name="batch_id"
                    invisible="cnab_format != '240'"
                    context="{'default_cnab_structure_id': cnab_structure_id}"
                    readonly="state != 'draft'"
                />
                <field name="cnab_structure_id" readonly="state != 'draft'" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="cnab_line_form_view">
        <field name="model">l10n_br_cnab.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        class="oe_highlight"
                        name="%(line_cnab_preview_action)d"
                        icon="fa-search-plus"
                        string="CNAB Preview"
                        type="action"
                        target="new"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <div class="oe_title">
                    <h1>
                        <field name="name" />
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="type" readonly="state != 'draft'" />
                        <field
                            name="segment_code"
                            invisible="type != 'segment'"
                            required="type == 'segment'"
                            readonly="state != 'draft'"
                        />
                        <field
                            name="batch_id"
                            invisible="cnab_format != '240'"
                            context="{'default_cnab_structure_id': cnab_structure_id}"
                            readonly="state != 'draft'"
                        />
                    </group>
                    <group>
                        <field name="communication_flow" readonly="state != 'draft'" />
                        <field name="requerid" readonly="state != 'draft'" />
                        <field name="sequence" readonly="state != 'draft'" />
                    </group>
                    <field name="current_view" invisible="True" />
                    <field name="cnab_structure_id" readonly="state != 'draft'" />
                    <field name="content_source_model_id" invisible="True" />
                    <field name="resource_ref" invisible="True" />
                    <field name="cnab_format" invisible="True" />
                </group>
                <notebook>
                    <page name="fields_info" string="Fields">
                        <button
                            name="action_general_view"
                            type="object"
                            string="Structure"
                            class="oe_highlight mx-1"
                            invisible="current_view == 'general'"
                        />
                        <button
                            name="action_sending_view"
                            type="object"
                            string="Map Sending"
                            class="oe_highlight mx-1"
                            invisible="current_view == 'sending' or communication_flow == 'return'"
                        />
                        <button
                            name="action_return_view"
                            type="object"
                            string="Map Return"
                            class="oe_highlight mx-1"
                            invisible="current_view == 'return' or communication_flow == 'sending'"
                        />
                        <separator
                            name="general_infos"
                            string="Structure"
                            invisible="current_view != 'general'"
                        />
                        <separator
                            name="sending_infos"
                            string="Map Sending"
                            invisible="current_view != 'sending'"
                        />
                        <separator
                            name="return_infos"
                            string="Map Return"
                            invisible="current_view != 'return'"
                        />
                        <field
                            name="field_ids"
                            mode='list'
                            widget='one2many'
                            context="{'default_cnab_line_id': id}"
                        >
                            <list default_order="start_pos" editable="bottom">
                                <field name="state" column_invisible="True" />
                                <field name="ref_name" column_invisible="True" />
                                <field
                                    name="computed_name"
                                    column_invisible="parent.current_view == 'general'"
                                />
                                <field
                                    name="name"
                                    column_invisible="parent.current_view != 'general'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="meaning"
                                    column_invisible="parent.current_view != 'general'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="start_pos"
                                    column_invisible="parent.current_view != 'general'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="end_pos"
                                    column_invisible="parent.current_view != 'general'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="assumed_comma"
                                    column_invisible="parent.current_view != 'general'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="type"
                                    column_invisible="parent.current_view != 'general'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="content_source_model_id"
                                    invisible="True"
                                />
                                <field
                                    name="default_value"
                                    column_invisible="parent.current_view == 'return'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="content_source_field"
                                    column_invisible="parent.current_view != 'sending'"
                                    readonly="state != 'draft'"
                                />
                                <button
                                    name="action_change_field"
                                    type="object"
                                    string="Change Field"
                                    class="oe_highlight oe_edit_only"
                                    column_invisible="parent.current_view == 'general'"
                                />
                                <field
                                    name="sending_dynamic_content"
                                    column_invisible="parent.current_view != 'sending'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="preview_field"
                                    column_invisible="not parent.resource_ref"
                                />
                                <field
                                    name="content_dest_field"
                                    column_invisible="parent.current_view != 'return'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="return_dynamic_content"
                                    column_invisible="parent.current_view != 'return'"
                                    readonly="state != 'draft'"
                                />
                                <field
                                    name="content_dest_model_id"
                                    column_invisible="True"
                                />
                                <field name="notes" readonly="state != 'draft'" />
                                <field
                                    name="cnab_group_id"
                                    readonly="state != 'draft'"
                                />
                                <field name="cnab_line_id" column_invisible="True" />
                            </list>
                        </field>
                    </page>
                    <page
                        name="optional_rules"
                        string="Optional Rules"
                        invisible="requerid"
                    >
                        <span class="o_form_label" modifiers="{}">Payment Ways</span>
                        <div
                            class="text-muted"
                            modifiers="{}"
                        >Choose the payment ways that are required to inform this line.</div>
                        <field
                            name="cnab_payment_way_ids"
                            widget="many2many"
                            options="{'no_create': True}"
                        />
                    </page>
                    <page name="fields_groups" string="Field Groups">
                        <field
                            name="group_ids"
                            mode='list'
                            widget='one2many'
                            context="{'default_cnab_line_id': id}"
                        >
                            <list>
                                <field name="state" column_invisible="True" />
                                <field name="name" readonly="state != 'draft'" />
                                <field name="field_ids" readonly="state != 'draft'" />
                                <field name="cnab_line_id" column_invisible="True" />
                            </list>
                        </field>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_cnab_line">
        <field name="name">CNAB Lines</field>
        <field name="res_model">l10n_br_cnab.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
