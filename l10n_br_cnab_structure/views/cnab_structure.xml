<odoo>
    <record id="cnab_preview_action" model="ir.actions.act_window">
        <field name="name">CNAB Preview</field>
        <field name="res_model">cnab.preview.wizard</field>
        <field name="binding_model_id" eval="False" />
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cnab_preview_wizard_form" />
        <field name="target">new</field>
        <field name="context">{'default_cnab_structure_id': active_id}</field>
    </record>

    <record model="ir.ui.view" id="cnab_structure_tree_view">
        <field name="model">l10n_br_cnab.structure</field>
        <field name="arch" type="xml">
            <list edit="0">
                <field name="state" column_invisible="True" />
                <field name="name" readonly="state != 'draft'" />
                <field name="payment_method_id" readonly="state != 'draft'" />
                <field name="cnab_format" column_invisible="True" />
                <field name="bank_id" readonly="state != 'draft'" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="cnab_structure_form_view">
        <field name="model">l10n_br_cnab.structure</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_review"
                        type="object"
                        string="Review"
                        class="oe_highlight"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        invisible="state != 'review'"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Reset To Draft"
                        class="oe_highlight"
                        invisible="state not in ('review', 'approved')"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            name="%(cnab_preview_action)d"
                            icon="fa-search-plus"
                            string="CNAB Preview"
                            type="action"
                            target="new"
                        />
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'" />
                            <field name="bank_id" readonly="state != 'draft'" />
                            <field
                                name="unique_seq_per_segment"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group>
                            <field
                                name="payment_method_id"
                                readonly="state != 'draft'"
                            />
                            <field name="cnab_format" invisible="True" />
                            <field name="payment_type" invisible="True" />
                            <field name="batch_ids" readonly="state != 'draft'" />
                            <field name="content_source_model_id" invisible="True" />
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Lines">
                            <field
                                name="line_ids"
                                mode='list'
                                widget='one2many'
                                context="{'default_cnab_structure_id': id}"
                            >
                                <list default_order="sequence">
                                    <field name="state" column_invisible="True" />
                                    <field name="cnab_format" column_invisible="True" />
                                    <field name="sequence" widget="handle" />
                                    <field name="type" readonly="state != 'draft'" />
                                    <field name="name" />
                                    <field
                                        name="batch_id"
                                        column_invisible="parent.cnab_format != '240'"
                                        readonly="state != 'draft'"
                                    />
                                    <field
                                        name="cnab_structure_id"
                                        readonly="state != 'draft'"
                                    />
                                </list>
                            </field>
                        </page>
                        <page name="conf_fields" string="Configuration Fields">
                            <group>
                                <group name="conf_positions" string="Positions">
                                    <label
                                        for="conf_bank_start_pos"
                                        string="Bank"
                                        required="cnab_format == '240'"
                                        invisible="cnab_format != '240'"
                                    />
                                    <div>
                                        <field
                                            name="conf_bank_start_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240'"
                                            invisible="cnab_format != '240'"
                                            readonly="state != 'draft'"
                                        />
                                        <field
                                            name="conf_bank_end_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240'"
                                            invisible="cnab_format != '240'"
                                            readonly="state != 'draft'"
                                        />
                                    </div>
                                    <label
                                        for="conf_record_type_start_pos"
                                        string="Record Type"
                                    />
                                    <div>
                                        <field
                                            name="conf_record_type_start_pos"
                                            style="width: 50%"
                                            required="1"
                                            readonly="state != 'draft'"
                                        />
                                        <field
                                            name="conf_record_type_end_pos"
                                            style="width: 50%"
                                            required="1"
                                            readonly="state != 'draft'"
                                        />
                                    </div>
                                    <label
                                        for="conf_batch_start_pos"
                                        string="Batch"
                                        required="cnab_format == '240'"
                                        invisible="cnab_format != '240'"
                                    />
                                    <div>
                                        <field
                                            name="conf_batch_start_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240'"
                                            invisible="cnab_format != '240'"
                                            readonly="state != 'draft'"
                                        />
                                        <field
                                            name="conf_batch_end_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240'"
                                            invisible="cnab_format != '240'"
                                            readonly="state != 'draft'"
                                        />
                                    </div>
                                    <label
                                        for="conf_payment_way_start_pos"
                                        string="Payment Way"
                                        required="cnab_format == '240' and payment_type == 'outbound'"
                                        invisible="cnab_format != '240' or payment_type != 'outbound'"
                                    />
                                    <div>
                                        <field
                                            name="conf_payment_way_start_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240' and payment_type == 'outbound'"
                                            invisible="cnab_format != '240' or payment_type != 'outbound'"
                                            readonly="state != 'draft'"
                                        />
                                        <field
                                            name="conf_payment_way_end_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240' and payment_type == 'outbound'"
                                            invisible="cnab_format != '240' or payment_type != 'outbound'"
                                            readonly="state != 'draft'"
                                        />
                                    </div>
                                    <label
                                        for="conf_detail_start_pos"
                                        string="Detail"
                                        required="cnab_format == '240'"
                                        invisible="cnab_format != '240'"
                                    />
                                    <div>
                                        <field
                                            name="conf_detail_start_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240'"
                                            invisible="cnab_format != '240'"
                                            readonly="state != 'draft'"
                                        />
                                        <field
                                            name="conf_detail_end_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240'"
                                            invisible="cnab_format != '240'"
                                            readonly="state != 'draft'"
                                        />
                                    </div>
                                    <label
                                        for="conf_segment_start_pos"
                                        string="Segment"
                                        required="cnab_format == '240'"
                                        invisible="cnab_format != '240'"
                                    />
                                    <div>
                                        <field
                                            name="conf_segment_start_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240'"
                                            invisible="cnab_format != '240'"
                                            readonly="state != 'draft'"
                                        />
                                        <field
                                            name="conf_segment_end_pos"
                                            style="width: 50%"
                                            required="cnab_format == '240'"
                                            invisible="cnab_format != '240'"
                                            readonly="state != 'draft'"
                                        />
                                    </div>
                                </group>
                                <group
                                    name="record_type_ids"
                                    string="Types Identification"
                                >
                                    <field
                                        name="record_type_file_header_id"
                                        required="1"
                                        readonly="state != 'draft'"
                                    />
                                    <field
                                        name="record_type_file_trailer_id"
                                        required="1"
                                        readonly="state != 'draft'"
                                    />
                                    <field
                                        name="record_type_batch_header_id"
                                        required="cnab_format == '240'"
                                        invisible="cnab_format != '240'"
                                        readonly="state != 'draft'"
                                    />
                                    <field
                                        name="record_type_batch_trailer_id"
                                        required="cnab_format == '240'"
                                        invisible="cnab_format != '240'"
                                        readonly="state != 'draft'"
                                    />
                                    <field
                                        name="record_type_detail_id"
                                        required="1"
                                        readonly="state != 'draft'"
                                    />
                                </group>
                            </group>
                        </page>
                        <page
                            name="payements_ways"
                            string="Payments Ways"
                            invisible="payment_type != 'outbound'"
                        >
                            <field
                                name="cnab_payment_way_ids"
                                mode='list'
                                widget='one2many'
                                context="{'default_cnab_structure_id': id}"
                            >
                                <list default_order="code" editable="bottom">
                                    <field name="code" />
                                    <field name="description" />
                                    <field name="clearinghouse_code" />
                                </list>
                            </field>
                        </page>
                        <page
                            name="payment_rules"
                            string="Payment Rules"
                            invisible="payment_type != 'outbound'"
                        >
                            <field
                                name="cnab_payment_rule_ids"
                                mode='list'
                                widget='one2many'
                                context="{'default_cnab_structure_id': id}"
                            >
                                <list default_order="sequence" editable="bottom">
                                    <field
                                        name="cnab_structure_id"
                                        column_invisible="1"
                                    />
                                    <field name="sequence" widget="handle" />
                                    <field name="match_bank_type" />
                                    <field name="match_partner_type" />
                                    <field name="payment_way_id" />
                                    <field name="service_type" />
                                </list>
                            </field>
                        </page>
                        <page
                            name="pix_config"
                            string="PIX"
                            invisible="payment_type != 'outbound'"
                        >
                            <span class="o_form_label" modifiers="{}">Key Types</span>
                            <field
                                name="cnab_pix_key_type_ids"
                                mode='list'
                                widget='one2many'
                                context="{'default_cnab_structure_id': id}"
                            >
                                <list default_order="code" editable="bottom">
                                    <field name="code" />
                                    <field name="description" />
                                    <field name="key_type" />
                                </list>
                            </field>
                            <span
                                class="o_form_label"
                                modifiers="{}"
                            >Transfer Types</span>
                            <field
                                name="cnab_pix_transfer_type_ids"
                                mode='list'
                                widget='one2many'
                                context="{'default_cnab_structure_id': id}"
                            >
                                <list default_order="code" editable="bottom">
                                    <field name="code" />
                                    <field name="description" />
                                    <field name="type_domain" />
                                </list>
                            </field>
                        </page>
                        <page name="occurrences" string="Ocurrences">
                            <field
                                name="cnab_occurrence_ids"
                                mode='list'
                                widget='one2many'
                                context="{'default_cnab_structure_id': id}"
                            >
                                <list default_order="code" editable="bottom">
                                    <field name="code" />
                                    <field name="description" />
                                    <field name="gen_liquidation_move" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_cnab_structure">
        <field name="name">CNAB Structures</field>
        <field name="view_id" ref="cnab_structure_tree_view" />
        <field name="res_model">l10n_br_cnab.structure</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
