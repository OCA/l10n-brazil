<odoo>
    <record model="ir.ui.view" id="cnab_line_fields_group_tree_view">
        <field name="model">cnab.line.field.group</field>
        <field name="arch" type="xml">
            <list default_order='cnab_line_id, id ASC' create="false">
                <field name="name" readonly="state != 'draft'" />
                <field name="cnab_line_id" readonly="state != 'draft'" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="cnab_line_field_group_form_view">
        <field name="model">cnab.line.field.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state != 'draft'" />
                        <field name="cnab_line_id" readonly="state != 'draft'" />
                        <field
                            name="field_ids"
                            mode='list'
                            widget='many2many'
                            context="{'default_cnab_line_id': cnab_line_id, 'default_cnab_group_id': id}"
                        >
                            <list>
                                <field name="state" column_invisible="True" />
                                <field name="name" readonly="state != 'draft'" />
                                <field name="start_pos" readonly="state != 'draft'" />
                                <field name="end_pos" readonly="state != 'draft'" />
                                <field name="cnab_line_id" column_invisible="True" />
                                <field name="cnab_group_id" column_invisible="True" />
                            </list>
                        </field>
                    </group>
                    <span class="o_form_label" modifiers="{}">Conditions</span>
                    <div
                        class="text-muted"
                        modifiers="{}"
                    >A field group will be informed in the cnab file based on the condition of a value of another field.</div>
                    <field
                        name="condition_ids"
                        nolabel="1"
                        context="{'default_cnab_group_id': id}"
                    >
                        <list editable="top">
                            <field name="state" column_invisible="True" />
                            <field name="cnab_group_id" column_invisible="True" />
                            <field name="cnab_line_id" column_invisible="True" />
                            <field name="field_id" readonly="state != 'draft'" />
                            <field name="operator" readonly="state != 'draft'" />
                            <field name="json_value" readonly="state != 'draft'" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_cnab_line_fields_group">
        <field name="name">CNAB Fields Group</field>
        <field name="res_model">cnab.line.field.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
