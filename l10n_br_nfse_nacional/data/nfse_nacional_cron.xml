<odoo noupdate="1">
    <record model="ir.cron" id="l10n_br_nfse_nacional_cron">
        <field
            name="name"
        >NFS-e Nacional (SEFIN): Check status of submitted documents</field>
        <field name="model_id" ref="model_l10n_br_fiscal_document" />
        <field name="state">code</field>
        <field name="code">model._cron_document_status_nfse_nacional()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall" />
    </record>
</odoo>
