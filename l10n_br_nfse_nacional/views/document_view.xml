<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_nfse_nacional.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <button name="action_document_invalidate" position="attributes">
                <attribute
                    name="invisible"
                >document_type == 'SE' or state_edoc in ('em_digitacao', 'autorizada', 'cancelada', 'denegada')</attribute>
            </button>
            <button name="action_document_cancel" position="after">
                <button
                    name="action_adn_check_status"
                    type="object"
                    string="Consultar Status"
                    groups="l10n_br_fiscal.group_user"
                    invisible="document_type != 'SE' or state_edoc != 'autorizada'"
                />
            </button>
        </field>
    </record>
    <record id="document_form_replace" model="ir.ui.view">
        <field name="name">l10n_br_nfse_nacional.document.form.replace</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_nfse.nfse_document_form_inherit" />
        <field name="arch" type="xml">
            <field name="nfse_replaced_document_id" position="after">
                <field name="nfse_provedor" invisible="1" />
                <field
                    name="nfse_replace_motive"
                    invisible="not nfse_replaced_document_id or nfse_provedor != 'nacional'"
                    readonly="state_edoc not in ('em_digitacao', 'a_enviar', 'rejeitada')"
                />
                <field
                    name="nfse_replace_reason"
                    invisible="not nfse_replaced_document_id or nfse_provedor != 'nacional'"
                    readonly="state_edoc not in ('em_digitacao', 'a_enviar', 'rejeitada')"
                />
            </field>
        </field>
    </record>
</odoo>
