<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_nfse_nacional.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <button name="action_document_invalidate" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('document_type', '=', 'SE'), ('state_edoc', 'in', ('em_digitacao', 'autorizada', 'cancelada', 'denegada'))]}</attribute>
            </button>
            <button name="action_document_cancel" position="after">
                <button
                    name="action_adn_check_status"
                    type="object"
                    string="Consultar Status"
                    groups="l10n_br_fiscal.group_user"
                    attrs="{'invisible': ['|', ('document_type', '!=', 'SE'), ('state_edoc', '!=', 'autorizada')]}"
                />
            </button>
        </field>
    </record>
</odoo>
