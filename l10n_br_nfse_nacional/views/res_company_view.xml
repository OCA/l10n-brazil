<odoo>
    <record id="nfse_nacional_res_company_form" model="ir.ui.view">
        <field name="name">
            l10n_br_nfse.res.company.form (in l10n_br_nfse_nacional)
        </field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_nfse.nfse_res_company_form" />
        <field name="arch" type="xml">
            <field name="provedor_nfse" position="after">
                <field
                    name="nfse_nacional_send_im"
                    invisible="provedor_nfse != 'nacional'"
                />
            </field>
        </field>
    </record>
</odoo>
