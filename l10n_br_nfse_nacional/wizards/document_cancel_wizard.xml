<odoo>
    <record id="document_cancel_wizard_form" model="ir.ui.view">
        <field name="name">l10n_br_nfse_nacional.document.cancel.wizard.form</field>
        <field name="model">l10n_br_fiscal.document.cancel.wizard</field>
        <field name="inherit_id" ref="l10n_br_fiscal_edi.document_cancel_wizard_form" />
        <field name="arch" type="xml">
            <field name="justification" position="before">
                <field name="document_type_code" invisible="1" />
                <field
                    name="nfse_nacional_motive"
                    attrs="{'invisible': [('document_type_code', '!=', 'SE')], 'required': [('document_type_code', '=', 'SE')]}"
                />
            </field>
        </field>
    </record>
</odoo>
