<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_caepi" model="ir.ui.view">
        <field name="name">product.template.form.caepi</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hr_employee_ppe.product_template_form_view" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ppe_certification']" position="after">
                <field
                    name="caepi_situacao"
                    attrs="{'invisible': [('ppe_certification', 'in', [False, ''])]}"
                />
            </xpath>
            <xpath
                expr="//field[@name='ppe_certification_expiry_date']"
                position="after"
            >
                <field
                    name="caepi_equipamento"
                    attrs="{'invisible': [('ppe_certification', 'in', [False, ''])]}"
                />
                <field
                    name="caepi_fabricante"
                    attrs="{'invisible': [('ppe_certification', 'in', [False, ''])]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
