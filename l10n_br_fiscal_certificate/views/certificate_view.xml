<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="certificate_certificate_view_search" model="ir.ui.view">
        <field name="name">certificate.certificate.search.l10n_br</field>
        <field name="model">certificate.certificate</field>
        <field
            name="inherit_id"
            ref="certificate.certificate_certificate_view_search"
        />
        <field name="arch" type="xml">
            <filter name="scope_general" position="after">
                <filter
                    string="Brazilian Fiscal"
                    name="scope_l10n_br"
                    domain="[('scope', '=', 'l10n_br')]"
                />
            </filter>
        </field>
    </record>

    <record id="certificate_certificate_view_list" model="ir.ui.view">
        <field name="name">certificate.certificate.list.l10n_br</field>
        <field name="model">certificate.certificate</field>
        <field name="inherit_id" ref="certificate.certificate_certificate_view_list" />
        <field name="arch" type="xml">
            <field name="subject_common_name" position="after">
                <!-- Only in the Brazilian fiscal views, the core list is kept as is -->
                <field
                    name="owner_cnpj_cpf"
                    optional="show"
                    column_invisible="context.get('default_scope') != 'l10n_br'"
                />
                <field
                    name="type"
                    optional="show"
                    column_invisible="context.get('default_scope') != 'l10n_br'"
                />
                <field
                    name="subtype"
                    optional="hide"
                    column_invisible="context.get('default_scope') != 'l10n_br'"
                />
                <field
                    name="date_end"
                    optional="show"
                    column_invisible="context.get('default_scope') != 'l10n_br'"
                />
            </field>
        </field>
    </record>

    <record id="certificate_certificate_view_form" model="ir.ui.view">
        <field name="name">certificate.certificate.form.l10n_br</field>
        <field name="model">certificate.certificate</field>
        <field name="inherit_id" ref="certificate.certificate_certificate_view_form" />
        <field name="arch" type="xml">
            <!-- Shown for the Brazilian companies only, where it defaults to
                 the Brazilian fiscal scope -->
            <field name="scope" position="attributes">
                <attribute name="invisible">country_code != 'BR'</attribute>
            </field>
            <field name="scope" position="after">
                <field
                    name="type"
                    invisible="scope != 'l10n_br'"
                    required="scope == 'l10n_br'"
                />
                <field
                    name="subtype"
                    invisible="scope != 'l10n_br'"
                    required="scope == 'l10n_br'"
                />
            </field>
            <field name="subject_common_name" position="after">
                <field
                    name="owner_cnpj_cpf"
                    invisible="scope != 'l10n_br' or not pem_certificate"
                />
                <field
                    name="issuer_name"
                    invisible="scope != 'l10n_br' or not pem_certificate"
                />
            </field>
        </field>
    </record>

    <record id="certificate_action" model="ir.actions.act_window">
        <field name="name">Certificates</field>
        <field name="res_model">certificate.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False" />
        <field name="domain" eval="False" />
        <field
            name="context"
        >{'default_scope': 'l10n_br', 'search_default_scope_l10n_br': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
              Add a new Certificate
            </p>
            <p>
              Brazilian fiscal A1 certificates (NF-e, CT-e, MDF-e and NFS-e).
            </p>
        </field>
    </record>

    <menuitem
        id="certificate_menu"
        action="certificate_action"
        groups="l10n_br_fiscal.group_manager"
        parent="l10n_br_fiscal.others_config_menu"
        sequence="40"
    />
</odoo>
