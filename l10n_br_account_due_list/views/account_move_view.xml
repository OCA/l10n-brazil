<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="invoice_form" model="ir.ui.view">
        <field name="name">l10n_br_account_due_list.invoice.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
                    string="Receivables"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                    name="receivable_move_line_tab"
                >
                    <field name="due_line_ids" />
                </page>
                <page
                    string="Payables"
                    invisible="move_type not in ('in_invoice', 'in_refund')"
                    name="payable_move_line_tab"
                >
                    <field name="due_line_ids" />
                </page>
                <page string="Payments" name="payment_move_line_tab">
                    <field name="payment_move_line_ids" />
                </page>
            </notebook>
        </field>
    </record>
    <record id="view_move_line_form_hide_full_reconcile" model="ir.ui.view">
        <field name="name">account.move.line.form.hide.full.reconcile</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form" />
        <field name="arch" type="xml">
            <label for="full_reconcile_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </label>
            <field name="full_reconcile_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
