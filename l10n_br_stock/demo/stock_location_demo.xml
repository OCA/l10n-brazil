<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Simples Nacional -->

    <record id="stock_location_sn_shelf_1" model="stock.location">
        <field name="name">Shelf 1</field>
        <field name="posx">0</field>
        <field
            name="location_id"
            model="stock.warehouse"
            eval="obj().env['stock.warehouse'].search([('company_id', '=', ref('l10n_br_base.empresa_simples_nacional'))], limit=1).lot_stock_id.id"
        />
        <field name="company_id" ref="l10n_br_base.empresa_simples_nacional" />
    </record>

