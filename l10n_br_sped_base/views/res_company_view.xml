<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_company_form" model="ir.ui.view">
        <field name="name">l10n_br_sped_base.res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="l10n_br_sped" string="SPED">
                    <group>
                        <group name="l10n_br_sped_registry">
                            <field name="l10n_br_nire_code" />
                            <field name="l10n_br_articles_filing_date" />
                            <field name="l10n_br_conversion_filing_date" />
                        </group>
                    </group>
                    <field name="l10n_br_sped_signer_ids">
                        <list>
                            <field name="sequence" widget="handle" />
                            <field name="name" />
                            <field name="cpf_cnpj" />
                            <field name="qualification" />
                            <field name="crc" />
                            <field name="legal_responsible" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
