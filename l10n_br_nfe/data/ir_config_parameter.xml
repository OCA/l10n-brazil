<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nfe_version_name" model="ir.config_parameter" forcecreate="True">
        <field name="key">l10n_br_nfe.version.name</field>
        <field name="value">Odoo Brasil OCA v14</field>
    </record>

    <!-- PR 4147: this branch proves the nfelib SOAP transmission, so it is
         enabled here by default. The legacy erpbrasil.edoc transmission stays
         the code default: drop this record (or set the parameter to False)
         to fall back to it. -->
    <record
        id="nfelib_soap_transmission"
        model="ir.config_parameter"
        forcecreate="True"
    >
        <field name="key">l10n_br_nfe.nfelib_soap_transmission</field>
        <field name="value">True</field>
    </record>
</odoo>
