<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- The anonymous consumer of the NFC-e: without this mark the NFC-e
         is issued with the dest tag holding only xNome, which is invalid. -->
    <record id="l10n_br_fiscal.res_partner_anonimo" model="res.partner">
        <field name="is_anonymous_consumer" eval="True" />
    </record>

</odoo>
