<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="danfe_profile_tree" model="ir.ui.view">
        <field name="name">l10n_br_nfe.danfe.profile.tree</field>
        <field name="model">l10n_br_nfe.danfe.profile</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="company_ids" widget="many2many_tags" />
                <field name="receipt_position" />
                <field name="carrier_receipt" />
                <field name="font_type" />
                <field name="font_size" />
            </tree>
        </field>
    </record>

    <record id="danfe_profile_form" model="ir.ui.view">
        <field name="name">l10n_br_nfe.danfe.profile.form</field>
        <field name="model">l10n_br_nfe.danfe.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field
                            name="company_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                        />
                    </group>
                    <group>
                        <group name="layout" string="Layout">
                            <field name="invoice_display" />
                            <field name="receipt_position" />
                            <field name="carrier_receipt" />
                            <field name="font_type" />
                            <field name="font_size" />
                        </group>
                        <group name="margins" string="Margins (mm)">
                            <field name="margin_top" string="Top" />
                            <field name="margin_right" string="Right" />
                            <field name="margin_bottom" string="Bottom" />
                            <field name="margin_left" string="Left" />
                        </group>
                        <group name="values" string="Values">
                            <field name="price_precision" />
                            <field name="quantity_precision" />
                            <field name="display_pis_cofins" />
                        </group>
                        <group name="product_description" string="Product Description">
                            <field name="display_product_additional_info" />
                            <field name="display_lot" />
                            <field
                                name="lot_prefix"
                                attrs="{'invisible': [('display_lot', '=', False)]}"
                            />
                            <field name="display_anp" />
                            <field name="display_anvisa" />
                        </group>
                        <group name="additional_info" string="Additional Information">
                            <field name="infcpl_semicolon_newline" />
                        </group>
                        <group name="footer_stamp" string="Footer Stamp">
                            <field
                                name="footer_stamp_logo"
                                string="Logo"
                                widget="image"
                                options="{'size': [0, 40]}"
                            />
                            <field name="footer_stamp_text" string="Text" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="danfe_profile_search" model="ir.ui.view">
        <field name="name">l10n_br_nfe.danfe.profile.search</field>
        <field name="model">l10n_br_nfe.danfe.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="danfe_profile_action" model="ir.actions.act_window">
        <field name="name">DANFE Profiles</field>
        <field name="res_model">l10n_br_nfe.danfe.profile</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a DANFE profile</p>
            <p>
                A profile holds the DANFE printing options. Add to the profile the
                companies that should print with it.
            </p>
        </field>
    </record>
</odoo>
