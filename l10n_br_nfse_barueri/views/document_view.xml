<odoo>
    <record id="document_form" model="ir.ui.view">
        <field name="name">l10n_br_nfse_barueri.document.form</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal_edi.document_form" />
        <field name="arch" type="xml">
            <button name="view_pdf" position="after">
                <field name="url_nfse_barueri" invisible="1" />
                <button
                    name="action_open_nfse_barueri"
                    type="object"
                    string="NFS-e na Prefeitura de Barueri"
                    groups="l10n_br_fiscal.group_user"
                    class="btn-primary"
                    invisible="not url_nfse_barueri"
                />
            </button>
        </field>
    </record>
</odoo>
