<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.dere.gov.br/schemas/evtRetornoBalan/v1_0_0"
           targetNamespace="http://www.dere.gov.br/schemas/evtRetornoBalan/v1_0_0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema.xsd"/>
  <xs:element name="DeRE">
    <xs:annotation>
      <xs:documentation>Envelope raiz dos eventos da DeRE.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
      <xs:element name="evtRetornoBalan">
        <xs:annotation>
          <xs:documentation>Retorno do evento Balancete Mensal.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
          <xs:element name="ideContrib" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de identificação do contribuinte.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="nrInsc" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número de inscrição do contribuinte (CNPJ raiz). Validação: Deve ser um CNPJ raiz válido de 8 posições.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="8"/>
                    <xs:pattern value="[0-9A-Z]{8}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ideStatus" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Situação do processamento do evento.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="cdRetorno" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Código indicativo do status do retorno.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="0">
                      <xs:annotation><xs:documentation>Erro</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Sucesso</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="descRetorno" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Descrição literal do status do retorno.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="Erro"/>
                    <xs:enumeration value="Sucesso"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ocorrencias" minOccurs="0" maxOccurs="10">
                <xs:annotation>
                  <xs:documentation>Informações de ocorrências registradas.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="codigo" minOccurs="1" maxOccurs="1">
                      <xs:annotation>
                        <xs:documentation>Código numérico da ocorrência</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="1"/>
                          <xs:maxLength value="6" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  <xs:element name="descricao" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Descrição detalhada da ocorrência (mensagem de erro ou aviso).</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:maxLength value="2048"/>
                        <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="tipo" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Classificação do tipo da ocorrência.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:enumeration value="1">
                          <xs:annotation><xs:documentation>Erro</xs:documentation></xs:annotation>
                        </xs:enumeration>
                        <xs:enumeration value="2">
                          <xs:annotation><xs:documentation>Aviso</xs:documentation></xs:annotation>
                        </xs:enumeration>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="localizacao" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Identificação do campo ou grupo onde a ocorrência foi detectada.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:maxLength value="2048"/>
                        <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="infoRecEv" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de processamento dos eventos.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="nrRecibo" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número do recibo do evento processado com sucesso. Validação: Preenchido somente quando {cdRetorno} = [1] (Sucesso).</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="31"/>
                    <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="seqEvento" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número sequencial de identificação que indica a versão do evento processado na base de dados. Nota: O controle sequencial é ininterrupto para a mesma chave de identificação. A exclusão de um evento não zera a contagem para futuras reinclusões. Exemplo: 1º Envio (Inclusão): seqEvento = [00]; 2º Envio (Alteração): seqEvento = [01]; 3º Envio (Exclusão): seqEvento = [02]; 4º Envio (Nova Inclusão): seqEvento = [03].</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="2"/>
                    <xs:pattern value="[0-9]{2}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="protocoloLote" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número do protocolo de entrega do lote.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="28"/>
                    <xs:pattern value="[12]\.20[0-9]{2}(0[1-9]|1[0-2])\.[0-9]{19}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="dhRecepcao" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Data e hora da recepção do evento (UTC). Máscara: AAAA-MM-DDThh:mm:ss.sssssssTZD</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:minLength value="25"/>
                    <xs:maxLength value="33"/>
                    <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d\.[0-9]{7}([\-\+](0[0-9]|10|11):00|([\+](12):00))"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="dhProcess" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Data e hora do início do processamento do evento (UTC). Máscara: AAAA-MM-DDThh:mm:ss.sssssssTZD</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:minLength value="25"/>
                    <xs:maxLength value="33"/>
                    <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d\.[0-9]{7}([\-\+](0[0-9]|10|11):00|([\+](12):00))"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="tpEv" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Sigla de identificação do tipo de evento. Exemplo: D-1101.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="6"/>
                    <xs:pattern value="D-[0-9]{4}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="hash" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Hashcode do arquivo processado.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="44"/>
                    <xs:pattern value="[A-Za-z0-9+/]{43}="/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="infoEvento" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações do evento processado.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="idePeriodo" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Grupo de identificação do período de referência das informações do evento.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="perApur" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Período de apuração, sendo o ano e mês da competência da declaração. Máscara: AAAA-MM Cálculo: Valor do campo {perApur} informado no evento de origem.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="7"/>
                        <xs:pattern value="20[0-9]{2}-(0[1-9]|1[0-2])"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="infoAdic" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Grupo destinado à prestação de informações complementares relativas ao evento processado.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="nrReciboPGCC" minOccurs="1" maxOccurs="1">
                      <xs:annotation>
                        <xs:documentation>
                          Número do recibo do evento D-1011 (Plano Geral de Contas Comentado) utilizado para o mapeamento das contas e totalização deste processamento.
                        </xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:whiteSpace value="preserve"/>
                          <xs:length value="31"/>
                          <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="infoTotBalan" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Informações de totalizadores do evento D-1101 - Balancete Mensal {evtBalancete}.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="gTotalCodTrib" minOccurs="0" maxOccurs="999">
                    <xs:annotation>
                      <xs:documentation>Totalização de informações por Código de Tributação.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:sequence>
                      <xs:element name="codTrib" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Código de tributação para fins de IBS, CBS e IS. Preenchimento: Listagem de valores únicos de {codTrib} informados no evento D-1101 ({evtBalancete}).</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="9"/>
                            <xs:pattern value="[1-9][0-9]{8}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="indTribISS" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Indicador de sujeição ou vinculação ao ISSQN. Preenchimento: Se não informado, atribuir [0].</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:enumeration value="0">
                              <xs:annotation><xs:documentation>Não sujeita ao ISS</xs:documentation></xs:annotation>
                            </xs:enumeration>
                            <xs:enumeration value="1">
                              <xs:annotation><xs:documentation>Sujeita ao ISS</xs:documentation></xs:annotation>
                            </xs:enumeration>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vApurTot" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Somatório de todas as ocorrências de {vApur} do evento D-1101 ({evtBalancete}) para o {codTrib} e {indTribISS} informados. Cálculo: SOMA({vApur.codTrib} = {codTrib})</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="4"/>
                            <xs:maxLength value="18"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vTotSaldoInic" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Somatório de todas as ocorrências de {vSaldoInic} do evento D-1101 ({evtBalancete}) para o {codTrib} informado. Preenchimento: Campo retornado apenas se {codTrib} = [220110001; 220210001; 220310001]. Cálculo: SOMA({vSaldoInic.codTrib} = [220110001; 220210001; 220310001])</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="4"/>
                            <xs:maxLength value="18"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vTotSaldoFinal" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Somatório de todas as ocorrências de {vSaldoFinal} do evento D-1101 ({evtBalancete}) para o {codTrib} informado. Preenchimento: Campo retornado apenas se {codTrib} = [220110001; 220210001; 220310001]. Cálculo: SOMA({vSaldoFinal.codTrib} = [220110001; 220210001; 220310001])</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="4"/>
                            <xs:maxLength value="18"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          </xs:sequence>
          <xs:attribute name="id" use="required">
            <xs:annotation>
              <xs:documentation>Identificação única do evento (campo id do evento transmitido pelo contribuinte, a que se refere este retorno).</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:whiteSpace value="preserve"/>
                <xs:length value="42"/>
                <xs:pattern value="DeRE[0-9]{4}[1-2][A-Z0-9]{14}[0-9]{19}"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
        <xs:element ref="ds:Signature"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
