<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.dere.gov.br/schemas/evtDebOpOfPublic/v0_0_2"
           targetNamespace="http://www.dere.gov.br/schemas/evtDebOpOfPublic/v0_0_2"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema.xsd"/>
  <xs:element name="DeRE">
    <xs:annotation>
      <xs:documentation>Envelope raiz dos eventos da DeRE.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
      <xs:element name="evtDebOpOfPublic">
        <xs:annotation>
          <xs:documentation>Evento débito mensal de operações com títulos de dívida com oferta pública.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
          <xs:element name="ideEvento" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de identificação do evento.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="tpOper" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Tipo de operação do evento. Nota: A alteração substitui integralmente as informações do evento enviado anteriormente.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Inclusão</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Alteração</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="3">
                      <xs:annotation><xs:documentation>Exclusão</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="motExcl" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Motivo da exclusão. Código do motivo que justifica a exclusão do evento. Preenchimento: Exclusivo e obrigatório se {tpOper} = [3].</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Determinação judicial ou administrativa</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Envio indevido (fato inexistente)</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="3">
                      <xs:annotation><xs:documentation>Erro na identificação (CNPJ/período incorretos)</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="9">
                      <xs:annotation><xs:documentation>Outro</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="nrProc" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Informar o número do processo administrativo/judicial. Preenchimento: Obrigatório se {motExcl} = [1]. Validação: Deve ser um número de processo válido e existente no evento D-1021.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:maxLength value="21"/>
                    <xs:pattern value="[0-9A-Za-z]+"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="nrRecibo" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Caso seja um evento de alteração/retificação ou exclusão, preencher com o número do recibo do arquivo a ser alterado/retificado ou excluído.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="31"/>
                    <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="tpAmb" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Identificação do ambiente para o qual os dados estão sendo transmitidos.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Produção</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Produção restrita</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="aplicEmi" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Identificação do aplicativo emissor do evento.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Emissão com aplicativo da empresa</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Aplicativo governamental</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="verAplic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Versão do aplicativo emissor do evento.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:maxLength value="20"/>
                    <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ideContrib" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de identificação do contribuinte.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="nrInsc" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número de inscrição do contribuinte (CNPJ raiz). Validação: Deve ser um CNPJ raiz válido de 8 posições.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="8"/>
                    <xs:pattern value="[0-9A-Z]{8}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="idePeriodo" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Período de referência das informações do evento.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="perApur" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Informar o período de apuração, sendo o ano e mês da competência da declaração. Máscara: AAAA-MM Validação: Se {tpOper} = [1], só pode existir um único {perApur} para cada {nrInsc}. Quando informado {nrRecibo}, o {perApur} deve ser exatamente o mesmo existente no {nrRecibo} (caracteres 6 a 11 do recibo).</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="7"/>
                    <xs:pattern value="20[0-9]{2}-(0[1-9]|1[0-2])"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="infoDebOpOfPublic" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de títulos de dívida com oferta pública.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="semTitulos" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Indicação da inexistência de títulos de dívida com oferta pública movimentados no período. Preenchimento: Deve ser preenchido exclusivamente quando o contribuinte não possuir movimento com títulos de dívida com oferta pública a detalhar no período de apuração ({perApur}).</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Sem movimento com títulos de dívida com oferta pública neste período</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="infoTitulos" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Informações do título de dívida com oferta pública.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="detTitulo" minOccurs="1" maxOccurs="10000">
                    <xs:annotation>
                      <xs:documentation>Detalhamento do título.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:sequence>
                      <xs:element name="descFundo" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Descrição do nome do fundo. Validação: Obrigatório se aquisição se der por meio de fundos de investimento com composição mínima de 95% de títulos de dívida.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:maxLength value="255"/>
                            <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="CNPJDevedor" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Número de inscrição no CNPJ do devedor emitente do título de dívida. Validação: Deve ser um CNPJ válido com 14 posições.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="14"/>
                            <xs:pattern value="[0-9A-Z]{12}[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vSaldoContIni" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Representa o valor do título sobre o qual haverá a incidência dos juros no período. Preenchimento: Deve ser igual ao {vSaldoContFin} do período anterior para o mesmo {idTitulo} (exceto na primeira competência do declarante).</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vEntradas" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor total das entradas (compras de novos títulos) da mesma emissão e série de ativos no período de apuração.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vSaidas" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor total das saídas (vendas de títulos e amortizações) da mesma emissão e série de ativos, no período de apuração.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vJurosRec" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor dos juros recebidos relativos à mesma emissão e série de ativos, no período de apuração.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vJurosApropr" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor total da receita de juros e demais rendimentos financeiros auferidos sobre o título no período.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vSaldoContFin" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor final do agrumento de títulos. Cálculo: {vSaldoContFin} = {vSaldoContIni} + {vEntradas} - {vSaidas} - {vJurosRec} + {vJurosApropr}</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vSelic" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor equivalente à variação da taxa Selic no período. Representa o teto tributável para a operação.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vPisCofins" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor da dedução relativa ao PIS/COFINS incidente sobre a receita tributada. Nota: Informar apenas a parcela passível de dedução da base de cálculo do IBS/CBS.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vApur" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor base sobre o qual serão aplicadas as regras definidas pelo código de tributação ({codTrib}). Cálculo: {vApur} = (MENORENTRE({vSelic} e {vJurosAprop})) - {vPisCofins}</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="6"/>
                            <xs:maxLength value="20"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{4}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      </xs:sequence>
                      <xs:attribute name="idTitulo" use="required">
                        <xs:annotation>
                          <xs:documentation>Código de identificação global do título no padrão ISO 6166 (ISIN). Preenchimento: Deve ser informado sem espaços ou caracteres especiais, contendo exatamente 12 caracteres alfanuméricos.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="12"/>
                            <xs:pattern value="[A-Z]{2}[0-9A-Z]{9}[0-9]"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:attribute>
                      <xs:attribute name="cCta" use="required">
                        <xs:annotation>
                          <xs:documentation>Código da conta analítica (como informada no evento D-1011.{cCta}). Preenchimento: Não informar contas sintéticas. Nota: Devem estar no PGCC vigente no último dia do {perApur} todas as contas que tiveram movimentação no período, ainda que tenham sido criadas ou encerradas no período. Validação: O {cCta} deve existir e estar vigente na tabela PGCC do contribuinte no último dia do {perApur} correspondente.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:maxLength value="53"/>
                            <xs:pattern value="[0-9A-Za-z]+"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:attribute>
                    </xs:complexType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          </xs:sequence>
          <xs:attribute name="id" use="required">
            <xs:annotation>
              <xs:documentation>Identificador que representa unicamente o evento.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:whiteSpace value="preserve"/>
                <xs:length value="42"/>
                <xs:pattern value="DeRE[0-9]{4}[1-2][0-9A-Z]{14}[0-9]{19}"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
        <xs:element ref="ds:Signature"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
