<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.dere.gov.br/schemas/evtServRemTarifa/v0_0_1"
           targetNamespace="http://www.dere.gov.br/schemas/evtServRemTarifa/v0_0_1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema.xsd"/>
  <xs:element name="DeRE">
    <xs:annotation>
      <xs:documentation>Envelope raiz dos eventos da DeRE.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
      <xs:element name="evtServRemTarifa">
        <xs:annotation>
          <xs:documentation>Evento de identificação e detalhamento de tarifas. Validação: Evento exclusivo e obrigatório para o registro de operações cujos códigos de base de cálculo ({codBC}) correspondam a um dos seguintes valores: [4210].</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
          <xs:element name="ideEvento" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de identificação do evento.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="finEvt" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Finalidade do evento.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="11">
                      <xs:annotation><xs:documentation>Registro original</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="31">
                      <xs:annotation><xs:documentation>Devolução</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="41">
                      <xs:annotation><xs:documentation>Cancelamento</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="tpAmb" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Identificação do ambiente para o qual os dados estão sendo transmitidos.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Produção</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Produção restrita</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="aplicEmi" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Identificação do aplicativo emissor do evento.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Emissão com aplicativo da empresa</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation><xs:documentation>Aplicativo governamental</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="verAplic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Versão do aplicativo emissor do evento.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:maxLength value="20"/>
                    <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ideContrib" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de identificação do contribuinte.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="nrInsc" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número de inscrição do contribuinte (CNPJ raiz). Validação: Deve ser um CNPJ raiz válido de 8 posições.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="8"/>
                    <xs:pattern value="[0-9A-Z]{8}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="idePeriodo" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Período de referência das informações do evento.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="perApur" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Período de apuração, sendo o ano e mês da competência da declaração. Máscara: AAAA-MM</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="7"/>
                    <xs:pattern value="20[0-9]{2}-(0[1-9]|1[0-2])"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="dhEmi" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Data e hora de emissão do documento fiscal. Máscara: AAAA-MM-DDThh:mm:ss.sssTZD</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="29"/>
                    <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d\.[0-9]{3}([\-\+](0[0-9]|10|11):00|([\+](12):00))"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="infoOper" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações das operações.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="gOper" minOccurs="1" maxOccurs="1000">
                <xs:annotation>
                  <xs:documentation>Grupo de operações por adquirente.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="chDeRE" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Chave de acesso de agrupamento de operações da DeRE.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="53"/>
                        <xs:pattern value="[0-9A-Z]{10}[1-59][0-9A-Z]{24}20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])(0[1-9]|[12][0-9]|3[01])[0-9]{8}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="codBC" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Código identificador da base de cálculo, conforme [[Tabela 12 – Códigos de Bases de Cálculo]]. Validação: Deve ser um código da listagem abaixo: [4210].</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="4"/>
                        <xs:pattern value="[1-9][0-9A-Z]{3}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="chOperRef" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Chave da operação objeto de cancelamento ou devolução. Preenchimento: Exclusivo e obrigatório se {finEvt} = [31; 41]. Validação: Deve ser uma chave válida e existente no banco de dados.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="53"/>
                        <xs:pattern value="[0-9A-Z]{10}[1-59][0-9A-Z]{24}20[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])(0[1-9]|[12][0-9]|3[01])[0-9]{8}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="idePartes" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Grupo de identificação e qualificação das partes envolvidas.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:sequence>
                      <xs:element name="infoAdq" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Informações de identificação do adquirente.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                          <xs:sequence>
                          <xs:element name="CPF" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Número de inscrição no CPF do adquirente, se pessoa física. Preenchimento: Vedado se o campo {CNPJ} ou grupo {adqExterior} forem informados. Validação: Deve ser um CPF válido.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:length value="11"/>
                                <xs:pattern value="[0-9]{11}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="CNPJ" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Número de inscrição no CNPJ do adquirente, se pessoa jurídica. Preenchimento: Vedado se o campo {CPF} ou o grupo {adqExterior} forem informados. Validação: Deve ser um CNPJ válido.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:length value="14"/>
                                <xs:pattern value="[0-9A-Z]{12}[0-9]{2}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="cMun" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Código IBGE do município do endereço do adquirente, conforme informações existentes na base cadastral do declarante. Preenchimento: Obrigatório se {CPF} ou {CNPJ forem informados. Vedado nos demais casos. Validação: Deve ser um código existente na tabela de municípios do IBGE.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:length value="7"/>
                                <xs:pattern value="[0-9]{7}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="adqExterior" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Identificação do adquirente residente ou domiciliado no exterior. Preenchimento: Exclusivo e obrigatório quando o adquirente da operação for residente ou domiciliado no exterior e não possuir inscrição ativa no CPF ou CNPJ no território nacional.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                              <xs:element name="NIF" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Número de Identificação Fiscal (NIF) do adquirente estrangeiro, fornecido por órgão de administração tributária no exterior. Preenchimento: 1. Exclusivo e obrigatório se o {cNaoNIF} não for informado; 2. Formato alfanumérico, sem máscaras ou caracteres especiais.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:maxLength value="20"/>
                                    <xs:pattern value="[0-9A-Z]+"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="cNaoNIF" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Código do motivo para a não informação do NIF do adquirente estrangeiro. Preenchimento: Exclusivo e obrigatório se o {NIF} não for informado.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:enumeration value="1">
                                      <xs:annotation><xs:documentation>Dispensado de NIF</xs:documentation></xs:annotation>
                                    </xs:enumeration>
                                    <xs:enumeration value="2">
                                      <xs:annotation><xs:documentation>Não exigência de NIF</xs:documentation></xs:annotation>
                                    </xs:enumeration>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="nrDocIdent" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Número do documento de identificação oficial no exterior (passaporte, carteira de identidade estrangeira ou documento oficial equivalente). Preenchimento: 1. Exclusivo e obrigatório se {cNaoNIF} for informado; 2. Formato alfanumérico, sem máscaras ou caracteres especiais.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:maxLength value="20"/>
                                    <xs:pattern value="[0-9A-Z]+"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="cPais" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Código de identificação do país de domicílio fiscal (emissor do NIF) ou de residência física do adquirente residente no exterior, conforme coluna “A2” da [[Tabela 15 – Tabela de Países]]. Exemplo: [US; PT; AR].</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:length value="2"/>
                                    <xs:pattern value="[A-Z]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="dadosOper" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Grupo de informação das operações por adquirente.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:sequence>
                      <xs:element name="detOper" minOccurs="1" maxOccurs="999">
                        <xs:annotation>
                          <xs:documentation>Detalhamento das informações da operação individualizada.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                          <xs:sequence>
                          <xs:element name="seqRef" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Número sequencial ({seq}) da chave-filha da operação de origem registrada anteriormente na DeRE, à qual se vincula a presente operação (ex: devolução, cancelamento etc.). Preenchimento: Exclusivo e obrigatório se o campo {chOperRef} for preenchido. Validação: O sequencial informado deve constar como ativo e associado à chave-mãe referenciada ({chOperRef}) na base de dados da DeRE.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:length value="3"/>
                                <xs:pattern value="00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="dhOper" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Data e hora da operação (UTC). Máscara: AAAA-MM-DDThh:mm:ss.sssTZD Validação: Deve estar compreendida no período de apuração ({perApur}) deste evento.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:length value="29"/>
                                <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d\.[0-9]{3}([\-\+](0[0-9]|10|11):00|([\+](12):00))"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="qualifOper" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Grupo destinado aos atributos e qualificadores específicos da transação.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                              <xs:element name="indPresenc" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Indicador que define se o serviço prestado foi fruído presencialmente por pessoa física. Preenchimento: Obrigatório se {CPF} for informado.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:enumeration value="0">
                                      <xs:annotation><xs:documentation>Não (serviço prestado de forma remota, eletrônica ou online)</xs:documentation></xs:annotation>
                                    </xs:enumeration>
                                    <xs:enumeration value="1">
                                      <xs:annotation><xs:documentation>Sim (serviço fruído presencialmente)</xs:documentation></xs:annotation>
                                    </xs:enumeration>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="cMunOper" minOccurs="0" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Código do município correspondente ao local do estabelecimento onde o serviço foi prestado, conforme tabela do IBGE. Preenchimento: Obrigatório se {indPresenc} = [1]. Validação: Deve ser um código existente na tabela de municípios do IBGE.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:length value="7"/>
                                    <xs:pattern value="[0-9]{7}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="gBC" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Grupo de aferição da base de cálculo do IBS e da CBS.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                              <xs:element name="vBCApur" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor da base de cálculo líquida correspondente à operação, obtido após a exclusão dos tributos que não integram a base de cálculo (ISS e PIS/COFINS), deduzidas as parcelas e custos permitidos pela legislação e aplicado o gross-down para exclusão dos tributos embutidos, se aplicável.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="gTributos" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Grupo de totalização de tributos incidentes sobre a operação.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                              <xs:element name="vBCTrib" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor da base de cálculo oferecida à tributação. Cálculo: {vBCTrib} = {vBCApur}</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="pIBSMunTrib" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Alíquota do IBS municipal incidente sobre a operação.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="8"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{2,4}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vIBSMunTrib" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor do IBS Municipal. Cálculo: {vIBSMunTrib} = {vBCTrib} * ({pIBSMunTrib} / 100)</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="pIBSUFTrib" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Alíquota do IBS estadual incidente sobre a operação.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="8"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{2,4}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vIBSUFTrib" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor do IBS Estadual. Cálculo: {vIBSUFTrib} = {vBCTrib} * ({pIBSUFTrib} / 100)</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="pCBSTrib" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Alíquota da CBS incidente sobre a operação.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="8"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{2,4}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vCBSTrib" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor da CBS. Cálculo: {vCBSTrib} = {vBCTrib} * ({pCBSTrib} / 100)</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          </xs:sequence>
                          <xs:attribute name="seq" use="required">
                            <xs:annotation>
                              <xs:documentation>Número sequencial de identificação da operação individualizada dentro deste agrupamento. Preenchimento: Deve ser preenchido de forma incremental e cronológica (de [001] a [999]). Nota: Este sequencial é utilizado pela base de dados, substituindo o sufixo [000] da chave-mãe do agrupamento (chDeRE) para compor a chave única da transação (chave-filha).</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:length value="3"/>
                                <xs:pattern value="00[1-9]|0[1-9][0-9]|[1-9][0-9]{2}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:attribute>
                        </xs:complexType>
                      </xs:element>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          </xs:sequence>
          <xs:attribute name="id" use="required">
            <xs:annotation>
              <xs:documentation>Identificador que representa unicamente o evento.</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:whiteSpace value="preserve"/>
                <xs:length value="42"/>
                <xs:pattern value="DeRE[0-9]{4}[1-2][0-9A-Z]{14}[0-9]{19}"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
        <xs:element ref="ds:Signature"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
