<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.dere.gov.br/schemas/evtRetornoMensal/v0_0_2"
           targetNamespace="http://www.dere.gov.br/schemas/evtRetornoMensal/v0_0_2"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema.xsd"/>
  <xs:element name="DeRE">
    <xs:annotation>
      <xs:documentation>Envelope raiz dos eventos da DeRE.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
      <xs:element name="evtRetornoMensal">
        <xs:annotation>
          <xs:documentation>Retorno Totalizador – Fechamento Mensal.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
          <xs:element name="ideContrib" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de identificação do contribuinte.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="nrInsc" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número de inscrição do contribuinte (CNPJ raiz). Validação: Deve ser um CNPJ raiz válido de 8 posições.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="8"/>
                    <xs:pattern value="[0-9A-Z]{8}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ideStatus" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Situação do processamento do evento.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="cdRetorno" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Código indicativo do status do retorno.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="0">
                      <xs:annotation><xs:documentation>Erro</xs:documentation></xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="1">
                      <xs:annotation><xs:documentation>Sucesso</xs:documentation></xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="descRetorno" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Descrição literal do status do retorno.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:enumeration value="Erro"/>
                    <xs:enumeration value="Sucesso"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ocorrencias" minOccurs="0" maxOccurs="10">
                <xs:annotation>
                  <xs:documentation>Informações de ocorrências registradas.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="codigo" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Código numérico da ocorrência.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:maxLength value="6"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="descricao" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Descrição detalhada da ocorrência (mensagem de erro ou aviso).</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:maxLength value="2048"/>
                        <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="tipo" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Classificação do tipo da ocorrência.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:enumeration value="1">
                          <xs:annotation><xs:documentation>Erro</xs:documentation></xs:annotation>
                        </xs:enumeration>
                        <xs:enumeration value="2">
                          <xs:annotation><xs:documentation>Aviso</xs:documentation></xs:annotation>
                        </xs:enumeration>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="localizacao" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Identificação do campo ou grupo onde a ocorrência foi detectada.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:maxLength value="2048"/>
                        <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="infoRecEv" minOccurs="1" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações de processamento dos eventos.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="nrRecibo" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número do recibo do evento processado com sucesso. Preenchimento: Preenchido somente quando {cdRetorno} = [1] (Sucesso).</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="31"/>
                    <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="seqEvento" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número sequencial de identificação que indica a versão do evento processado na base de dados. Nota: O controle sequencial é ininterrupto para a mesma chave de identificação. Como o evento D-1199 admite apenas a operação de Inclusão ({tpOper} = [1]), as versões subsequentes ({seqEvento} maior que [00]) decorrem obrigatoriamente de novas transmissões de Fechamento efetuadas após o período ter sido reaberto por um evento de Reabertura de Período de Apuração (D-1198). Exemplo: 1º Envio (Inclusão): seqEvento = [00]; 2º Envio (Nova Inclusão): seqEvento = [01]; 3º Envio (Nova Inclusão): seqEvento = [02].</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="2"/>
                    <xs:pattern value="[0-9]{2}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="protocoloLote" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Número do protocolo de entrega do lote.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="28"/>
                    <xs:pattern value="[12]\.20[0-9]{2}(0[1-9]|1[0-2])\.[0-9]{19}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="dhRecepcao" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Data e hora da recepção do evento (UTC). Máscara: AAAA-MM-DDThh:mm:ss.sssssssTZD</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:minLength value="25"/>
                    <xs:maxLength value="33"/>
                    <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d\.[0-9]{7}([\-\+](0[0-9]|10|11):00|([\+](12):00))"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="dhProcess" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Data e hora do início do processamento do evento (UTC). Máscara: AAAA-MM-DDThh:mm:ss.sssssssTZD</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:minLength value="25"/>
                    <xs:maxLength value="33"/>
                    <xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d\.[0-9]{7}([\-\+](0[0-9]|10|11):00|([\+](12):00))"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="tpEv" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Sigla de identificação do tipo de evento. Exemplo: D-1199.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="6"/>
                    <xs:pattern value="D-[0-9]{4}"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="hash" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Hashcode do arquivo processado.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:whiteSpace value="preserve"/>
                    <xs:length value="44"/>
                    <xs:pattern value="[0-9A-Za-z+/]{43}="/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="infoEvento" minOccurs="0" maxOccurs="1">
            <xs:annotation>
              <xs:documentation>Informações do evento processado.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
              <xs:element name="idePeriodo" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Grupo de identificação do período de referência das informações do evento.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="perApur" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Período de apuração, sendo o ano e mês da competência da declaração. Máscara: AAAA-MM Cálculo: Valor do campo {perApur} informado no evento de origem.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="7"/>
                        <xs:pattern value="20[0-9]{2}-(0[1-9]|1[0-2])"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="infoAdic" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Grupo destinado ao retorno de informações complementares relativas ao evento processado.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="nrReciboBalancete" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Número do recibo do evento D-1101 (Balancete Mensal) utilizado para a totalização deste processamento.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="31"/>
                        <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="nrReciboAplicFin" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Número do recibo do evento D-1106 (Detalhamento de Aplicações Financeiras) utilizado para a totalização deste processamento.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="31"/>
                        <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="nrReciboRelDedu" minOccurs="0" maxOccurs="99">
                    <xs:annotation>
                      <xs:documentation>Número do recibo do evento D-1121 (Relação de Deduções Utilizadas na Apuração) utilizado para a totalização deste processamento.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="31"/>
                        <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="nrReciboOperTitPub" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Número do recibo do evento D-2101 (Operações com Título de Oferta Pública) utilizado para a totalização deste processamento.</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:length value="31"/>
                        <xs:pattern value="[0-9]{4}-20[0-9]{2}(0[1-9]|1[0-2])-[0-9A-Z]{19}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="infoTotFinanceiro" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Informações relativas a totalizadores dos Serviços Financeiros.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="detBC" minOccurs="1" maxOccurs="100">
                    <xs:annotation>
                      <xs:documentation>Detalhamento da base de cálculo.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:sequence>
                      <xs:element name="codBC" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Código identificador da base de cálculo, conforme [[Tabela 12 – Códigos de Bases de Cálculo]].</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:length value="4"/>
                            <xs:pattern value="[1-9][0-9A-Z]{3}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="xDetBC" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Descrição da base de cálculo.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:maxLength value="1024"/>
                            <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="gCoeficientes" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Grupo de detalhamento dos coeficientes de rateio e de reversão calculados pelo sistema para a formação desta base de cálculo.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                          <xs:sequence>
                          <xs:element name="pRateioDespCapt" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Coeficiente utilizado para ratear as despesas de captação de recursos entre as atividades financeiras que permitem essa dedução.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:minLength value="10"/>
                                <xs:maxLength value="12"/>
                                <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{8}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="pRevDedAtoCoop" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Coeficiente utilizado para reverter as deduções de despesas vinculadas a receitas decorrentes de atos cooperados (sujeitas à alíquota zero).</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:minLength value="10"/>
                                <xs:maxLength value="12"/>
                                <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{8}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="pExportIaV" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Coeficiente aplicado para reverter deduções de despesas vinculadas a receitas de exportação das atividades previstas nos incisos I a V do caput do art. 182 da LC 214/2025.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:minLength value="10"/>
                                <xs:maxLength value="12"/>
                                <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{8}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="pExportVI" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Coeficiente aplicado para reverter deduções de despesas vinculadas a receitas de exportação das atividades previstas no inciso VI do caput do art. 182 da LC 214/2025.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:minLength value="10"/>
                                <xs:maxLength value="12"/>
                                <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{8}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="pExportIX" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Coeficiente aplicado para reverter deduções de despesas vinculadas a receitas de exportação das atividades previstas no inciso IX do caput do art. 182 da LC 214/2025.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:minLength value="10"/>
                                <xs:maxLength value="12"/>
                                <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{8}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="pExportXI" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Coeficiente aplicado para reverter deduções de despesas vinculadas a receitas de exportação das atividades previstas no inciso XI do caput do art. 182 da LC 214/2025.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:minLength value="10"/>
                                <xs:maxLength value="12"/>
                                <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{8}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="pExportXIII" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Coeficiente aplicado para reverter deduções de despesas vinculadas a receitas de exportação das atividades previstas no inciso XIII do caput do art. 182 da LC 214/2025.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:minLength value="10"/>
                                <xs:maxLength value="12"/>
                                <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{8}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="pExportXIV" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Coeficiente aplicado para reverter deduções de despesas vinculadas a receitas de exportação das atividades previstas no inciso XIV do caput do art. 182 da LC 214/2025.</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
                                <xs:minLength value="10"/>
                                <xs:maxLength value="12"/>
                                <xs:pattern value="(0|[1-9][0-9]{0,2})\.[0-9]{8}"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      <xs:element name="memoriaCalculo" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Descrição textual dos valores intermediários usados no cálculo. Todos os valores apresentados serão arredondados para oito casas decimais.</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:maxLength value="4096"/>
                            <xs:pattern value="([!-ÿ][ -ÿ]*[!-ÿ]|[!-ÿ])"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="gBCIBS" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Detalhamento da base de cálculo do IBS.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                          <xs:sequence>
                          <xs:element name="vBCIBS" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Valor da base de cálculo do IBS. Cálculo: SE {tabCodBC.vBCIBS} >= [0.00], ENTÃO {vBCIBS} = {tabCodBC.vBCIBS}, SENÃO {vBCIBS} = [0.00]</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:whiteSpace value="preserve"/>
