                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      <xs:element name="infoBCN" minOccurs="0" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Grupo de informações de bases de cálculo negativas.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                          <xs:sequence>
                          <xs:element name="gBCNIBS" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Grupo de detalhamento de bases de cálculo negativas de IBS.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                              <xs:element name="codBCNRaiz" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Código identificador raiz da base de cálculo negativa, conforme [[Tabela 12 – Códigos de Bases de Cálculo]].</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:length value="5"/>
                                    <xs:pattern value="[1-9][0-9]{3}[IC]"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vSaldoAnt" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor do saldo anterior. Montante acumulado da base de cálculo negativa disponível no início do período de apuração atual, antes das compensações do mês.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vUtilPer" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor da base de cálculo negativa utilizado como dedução da base de cálculo do período de apuração atual. Cálculo: Igual a {vDedBCN}</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vSaldoFinal" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor do saldo remanescente de base de cálculo negativa a ser transportado para o próximo período de apuração. Cálculo: {vSaldoAnt} - {vUtilPer} + {vBCNIBS} (se houver)</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="qtdOrigens" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Quantidade de períodos de origem. Indica quantos períodos distintos compõem o saldo atual. Exemplo: Se o saldo é composto por bases negativas de jan/25 e mar/26, {qtdOrigens} = [2].</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:maxLength value="2"/>
                                    <xs:pattern value="[1-9][0-9]?"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="detBCN" minOccurs="0" maxOccurs="100">
                                <xs:annotation>
                                  <xs:documentation>Detalhamento da composição do saldo por período de origem.</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                  <xs:sequence>
                                  <xs:element name="codBCN" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Código identificador da base de cálculo negativa, conforme [[Tabela 12 – Códigos de Bases de Cálculo]].</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:length value="13"/>
                                        <xs:pattern value="[1-9][0-9]{3}[IC][0-9]{8}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="perOrigem" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Período de origem da base de cálculo negativa. Máscara: AAAA-MM</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:length value="7"/>
                                        <xs:pattern value="20[0-9]{2}-(0[1-9]|1[0-2])"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="vOrigemIni" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Valor inicial da base de cálculo negativa no respectivo período de origem.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:minLength value="4"/>
                                        <xs:maxLength value="18"/>
                                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="vSaldoAnt" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Valor da base de cálculo negativa disponível para uso neste período de apuração. Cálculo: SE {perOrigem} = {perApur}, ENTÃO {vSaldoAnt} = [0.00], SENÃO {vSaldoAnt} = {vSaldoFinal} do {perApur} imediatamente anterior.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:minLength value="4"/>
                                        <xs:maxLength value="18"/>
                                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="vUtilPer" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Valor da base de cálculo negativa utilizada neste período de apuração.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:minLength value="4"/>
                                        <xs:maxLength value="18"/>
                                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="vSaldoFinal" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Saldo remanescente desta base de cálculo negativa para os próximos períodos de apuração.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:minLength value="4"/>
                                        <xs:maxLength value="18"/>
                                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  </xs:sequence>
                                </xs:complexType>
                              </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="gBCNCBS" minOccurs="1" maxOccurs="1">
                            <xs:annotation>
                              <xs:documentation>Grupo de detalhamento de bases de cálculo negativas de CBS.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                              <xs:element name="codBCNRaiz" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Código identificador raiz da base de cálculo negativa, conforme [[Tabela 12 – Códigos de Bases de Cálculo]].</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:length value="5"/>
                                    <xs:pattern value="[1-9][0-9]{3}[IC]"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vSaldoAnt" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor do saldo anterior. Montante acumulado da base de cálculo negativa disponível no início do período de apuração atual, antes das compensações do mês.</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vUtilPer" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor da base de cálculo negativa utilizado como dedução da base de cálculo do período de apuração atual. Cálculo: Igual a {vDedBCN}</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="vSaldoFinal" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Valor do saldo remanescente de base de cálculo negativa a ser transportado para o próximo período de apuração. Cálculo: {vSaldoAnt} - {vUtilPer} + {vBCNCBS} (se houver)</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:minLength value="4"/>
                                    <xs:maxLength value="18"/>
                                    <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="qtdOrigens" minOccurs="1" maxOccurs="1">
                                <xs:annotation>
                                  <xs:documentation>Quantidade de períodos de origem. Indica quantos períodos distintos compõem o saldo atual. Exemplo: Se o saldo é composto por bases negativas de jan/25 e mar/26, {qtdOrigens} = [2].</xs:documentation>
                                </xs:annotation>
                                <xs:simpleType>
                                  <xs:restriction base="xs:string">
                                    <xs:whiteSpace value="preserve"/>
                                    <xs:maxLength value="2"/>
                                    <xs:pattern value="[1-9][0-9]?"/>
                                  </xs:restriction>
                                </xs:simpleType>
                              </xs:element>
                              <xs:element name="detBCN" minOccurs="0" maxOccurs="100">
                                <xs:annotation>
                                  <xs:documentation>Detalhamento da composição do saldo por período de origem.</xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                  <xs:sequence>
                                  <xs:element name="codBCN" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Código identificador da base de cálculo negativa, conforme [[Tabela 12 – Códigos de Bases de Cálculo]].</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:length value="13"/>
                                        <xs:pattern value="[1-9][0-9]{3}[IC][0-9]{8}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="perOrigem" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Período de origem da base de cálculo negativa. Máscara: AAAA-MM</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:length value="7"/>
                                        <xs:pattern value="20[0-9]{2}-(0[1-9]|1[0-2])"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="vOrigemIni" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Valor inicial da base de cálculo negativa no respectivo período de origem.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:minLength value="4"/>
                                        <xs:maxLength value="18"/>
                                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="vSaldoAnt" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Valor da base de cálculo negativa disponível para uso neste período de apuração. Cálculo: SE {perOrigem} = {perApur}, ENTÃO {vSaldoAnt} = [0.00], SENÃO {vSaldoAnt} = {vSaldoFinal} do {perApur} imediatamente anterior.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:minLength value="4"/>
                                        <xs:maxLength value="18"/>
                                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="vUtilPer" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Valor da base de cálculo negativa utilizada neste período de apuração.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:minLength value="4"/>
                                        <xs:maxLength value="18"/>
                                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  <xs:element name="vSaldoFinal" minOccurs="1" maxOccurs="1">
                                    <xs:annotation>
                                      <xs:documentation>Saldo remanescente desta base de cálculo negativa para os próximos períodos de apuração.</xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:whiteSpace value="preserve"/>
                                        <xs:minLength value="4"/>
                                        <xs:maxLength value="18"/>
                                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:element>
                                  </xs:sequence>
                                </xs:complexType>
                              </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="totalTributos" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Totalização dos tributos do Regime Específico de Concursos de Prognósticos.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:sequence>
                      <xs:element name="vIS" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor do Imposto Seletivo (IS). Cálculo: SOMA({infoTotProg.detBC.vIS})</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="4"/>
                            <xs:maxLength value="18"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vIBSMun" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor do IBS municipal. Cálculo: SOMA({infoTotProg.detBC.vIBSMun})</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="4"/>
                            <xs:maxLength value="18"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vIBSUF" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor do IBS estadual. Cálculo: SOMA({infoTotProg.detBC.vIBSUF})</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="4"/>
                            <xs:maxLength value="18"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vIBSTot" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor total do IBS. Cálculo: {totalTributos.vIBSMun} + {totalTributos.vIBSUF}</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="4"/>
                            <xs:maxLength value="18"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      <xs:element name="vCBS" minOccurs="1" maxOccurs="1">
                        <xs:annotation>
                          <xs:documentation>Valor da CBS. Cálculo: SOMA({infoTotProg.detBC.vCBS})</xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:whiteSpace value="preserve"/>
                            <xs:minLength value="4"/>
                            <xs:maxLength value="18"/>
                            <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:element>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="totalTributosGeral" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                  <xs:documentation>Totalização dos tributos do declarante.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                  <xs:element name="vIS" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Valor total do Imposto Seletivo (IS). Preenchimento: Corresponde ao campo {vIS} do grupo {totalTributos} do grupo {infoTotProg}. Cálculo: SOMA({totalTributos.vIS})</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:minLength value="4"/>
                        <xs:maxLength value="18"/>
                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="vIBSMun" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Valor total do IBS municipal. Preenchimento: Soma do campo {vIBSMun} de todas as ocorrências do grupo {totalTributos} dos grupos {infoTotFinanc}, {infoTotSaude} e {infoTotProg}. Cálculo: SOMA({totalTributos.vIBSMun})</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:minLength value="4"/>
                        <xs:maxLength value="18"/>
                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="vIBSUF" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Valor total do IBS estadual. Preenchimento: Soma do campo {vIBSUF} de todas as ocorrências do grupo {totalTributos} dos grupos {infoTotFinanc}, {infoTotSaude} e {infoTotProg}. Cálculo: SOMA({totalTributos.vIBSUF})</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:minLength value="4"/>
                        <xs:maxLength value="18"/>
                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="vIBSTot" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Valor total do IBS. Cálculo: SOMA({totalTributosGeral.vIBSMun}) + SOMA({totalTributosGeral.vIBSUF})</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:minLength value="4"/>
                        <xs:maxLength value="18"/>
                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="vCBS" minOccurs="1" maxOccurs="1">
                    <xs:annotation>
                      <xs:documentation>Valor total da CBS. Preenchimento: Soma do campo {vCBS} de todas as ocorrências do grupo {totalTributos} dos grupos {infoTotFinanc}, {infoTotSaude} e {infoTotProg}. Cálculo: SOMA({totalTributos.vCBS})</xs:documentation>
                    </xs:annotation>
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="preserve"/>
                        <xs:minLength value="4"/>
                        <xs:maxLength value="18"/>
                        <xs:pattern value="(0|[1-9][0-9]{0,14})\.[0-9]{2}"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          </xs:sequence>
          <xs:attribute name="id" use="required">
            <xs:annotation>
              <xs:documentation>Identificação única do evento (campo id do evento transmitido pelo contribuinte, a que se refere este retorno).</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:whiteSpace value="preserve"/>
                <xs:length value="42"/>
                <xs:pattern value="DeRE[0-9]{4}[1-2][0-9A-Z]{14}[0-9]{19}"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
        <xs:element ref="ds:Signature"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
