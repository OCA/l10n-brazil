<odoo>
    <!-- The CT-e service only searches by NSU: hide the search type radio -->
    <record id="view_dfe_specific_search_wizard_form_cte" model="ir.ui.view">
        <field name="name">dfe.specific.search.wizard.form.cte</field>
        <field name="model">dfe.specific.search.wizard</field>
        <field
            name="inherit_id"
            ref="l10n_br_fiscal_dfe.view_dfe_specific_search_wizard_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='search_type']" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('fiscal_type', '=', 'cte')]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
