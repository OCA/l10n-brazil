<odoo>
    <record id="cte_dfe_res_company_form" model="ir.ui.view">
        <field name="name">cte.dfe.res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='fiscal']/notebook" position="inside">
                <page name="cte_dfe" string="CT-e DF-e">
                    <group name="cte_dfe_settings" string="CT-e DF-e Settings">
                        <group>
                            <field name="cte_environment" />
                        </group>
                        <group>
                            <field name="cte_auto_fetch" />
                        </group>
                    </group>
                    <group name="cte_dfe_last_query" string="Last Query">
                        <group>
                            <field name="cte_last_nsu" />
                            <field name="cte_max_nsu" />
                            <field
                                name="cte_dfe_last_query"
                                string="Date"
                                readonly="1"
                                widget="datetime"
                            />
                        </group>
                        <group>
                            <field
                                name="cte_dfe_last_status"
                                string="Status"
                                readonly="1"
                            />
                            <field
                                name="cte_dfe_last_status_code"
                                string="Status Code"
                                readonly="1"
                            />
                            <field
                                name="cte_dfe_next_query"
                                string="Next Query"
                                readonly="1"
                                widget="datetime"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
