<odoo>
    <record id="dfe_distribution_log_tree" model="ir.ui.view">
        <field name="name">dfe.distribution.log.tree</field>
        <field name="model">l10n_br_fiscal_dfe.distribution_log</field>
        <field name="arch" type="xml">
            <tree
                create="false"
                edit="false"
                decoration-success="log_type == 'success'"
                decoration-muted="log_type == 'info'"
                decoration-warning="log_type == 'warning'"
                decoration-danger="log_type == 'error'"
            >
                <field name="create_date" string="Date" />
                <field name="log_type" />
                <field name="message" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="dfe_distribution_log_form" model="ir.ui.view">
        <field name="name">dfe.distribution.log.form</field>
        <field name="model">l10n_br_fiscal_dfe.distribution_log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Date" />
                            <field name="log_type" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <separator string="Message" />
                    <field name="message" nolabel="1" />
                    <notebook>
                        <page
                            string="SOAP Request"
                            name="request"
                            attrs="{'invisible': [('request_xml', '=', False)]}"
                        >
                            <field name="request_xml" nolabel="1" />
                        </page>
                        <page
                            string="SOAP Response"
                            name="response"
                            attrs="{'invisible': [('response_xml', '=', False)]}"
                        >
                            <field name="response_xml" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dfe_distribution_log_search" model="ir.ui.view">
        <field name="name">dfe.distribution.log.search</field>
        <field name="model">l10n_br_fiscal_dfe.distribution_log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    name="success"
                    string="Success"
                    domain="[('log_type', '=', 'success')]"
                />
                <filter
                    name="info"
                    string="Info"
                    domain="[('log_type', '=', 'info')]"
                />
                <filter
                    name="warning"
                    string="Warning"
                    domain="[('log_type', '=', 'warning')]"
                />
                <filter
                    name="error"
                    string="Error"
                    domain="[('log_type', '=', 'error')]"
                />
                <separator />
                <filter
                    name="has_soap"
                    string="With SOAP Data"
                    domain="[('request_xml', '!=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="dfe_distribution_log_action" model="ir.actions.act_window">
        <field name="name">Distribution Log</field>
        <field name="res_model">l10n_br_fiscal_dfe.distribution_log</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
