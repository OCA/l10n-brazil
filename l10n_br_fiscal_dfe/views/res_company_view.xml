<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_dfe" model="ir.ui.view">
        <field name="name">res.company.dfe.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <!-- Add a Smart Button to view generic DF-e Logs -->
            <xpath expr="//notebook/page[@name='fiscal']/notebook" position="inside">
                <page name="dfe" string="DF-e">
                    <button
                        name="%(l10n_br_fiscal_dfe.action_l10n_br_fiscal_dfe_distribution_log)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        string="DF-e Logs"
                        context="{'search_default_company_id': active_id}"
                    >
                    </button>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
