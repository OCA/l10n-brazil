    <record model="ir.ui.view" id="dfe_form">
        <field name="name">l10n_br_fiscal_dfe.dfe.form</field>
        <field name="model">l10n_br_fiscal_dfe.dfe</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="DF-e" create="false" edit="false" delete="false">
                <separator string="Access Key" />
                <field name="access_key" readonly="1" />

                <separator string="Document Info" />
                <group>
                    <group>
                        <field name="nsu" readonly="1" />
                        <field name="dfe_nfe_document_type" readonly="1" />
                        <field name="event_type_dfe_label" readonly="1" />
                        <field name="operation_type" readonly="1" />
                    </group>
                    <group>
                        <field name="company_id" readonly="1" />
                        <field name="dfe_document_id" readonly="1" />
                        <field name="attachment_id" readonly="1" />
                    </group>
                    <label for="xml_pretty" string="XML Attachment" />
                    <field
                        name="xml_pretty"
                        readonly="1"
                        widget="ace"
                        options="{'mode': 'xml'}"
                    />
                </group>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="dfe_tree">
        <field name="name">l10n_br_fiscal_dfe.dfe.tree</field>
        <field name="model">l10n_br_fiscal_dfe.dfe</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="nsu" />
                <field name="access_key" />
                <field name="dfe_nfe_document_type" string="DF-e" />
                <button
                    string="XML"
                    name="action_download_xml"
                    type="object"
                    icon="fa-download"
                />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="dfe_action">
        <field name="name">DF-e Records</field>
        <field name="res_model">l10n_br_fiscal_dfe.dfe</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
