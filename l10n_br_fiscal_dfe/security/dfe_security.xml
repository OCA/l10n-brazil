<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- Multi-company rule for DF-e Document -->
    <record id="l10n_br_fiscal_dfe_document_rule" model="ir.rule">
        <field name="name">DF-e Document multi-company</field>
        <field name="model_id" ref="model_l10n_br_fiscal_dfe_document" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Multi-company rule for DF-e Record (XML payload) -->
    <record id="l10n_br_fiscal_dfe_record_rule" model="ir.rule">
        <field name="name">DF-e Record multi-company</field>
        <field name="model_id" ref="model_l10n_br_fiscal_dfe_dfe" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Multi-company rule for DF-e Distribution Log -->
    <record id="l10n_br_fiscal_dfe_log_rule" model="ir.rule">
        <field name="name">DF-e Distribution Log multi-company</field>
        <field name="model_id" ref="model_l10n_br_fiscal_dfe_distribution_log" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
