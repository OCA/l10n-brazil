<odoo noupdate="0">
    <!-- Base Channel for all DF-e operations -->
    <record id="channel_dfe" model="queue.job.channel">
        <field name="name">dfe</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>

    <!-- Generic distribution queries run in the DF-e channel -->
    <record id="job_function_dfe_document_distribution" model="queue.job.function">
        <field name="model_id" ref="base.model_res_company" />
        <field name="method">_dfe_document_distribution</field>
        <field name="channel_id" ref="channel_dfe" />
    </record>
</odoo>
