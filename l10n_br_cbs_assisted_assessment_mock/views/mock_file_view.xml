<odoo>
    <record id="view_cbs_mock_file_list" model="ir.ui.view">
        <field name="name">l10n_br_cbs_assisted_assessment.mock.file.list</field>
        <field name="model">l10n_br_cbs_assisted_assessment.mock.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" />
                <field name="period_id" />
                <field name="service" />
                <field name="state" />
                <field name="ticket" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="view_cbs_mock_file_form" model="ir.ui.view">
        <field name="name">l10n_br_cbs_assisted_assessment.mock.file.form</field>
        <field name="model">l10n_br_cbs_assisted_assessment.mock.file</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="service" readonly="state == 'served'" />
                            <field name="period_id" readonly="state == 'served'" />
                            <field name="state" />
                            <field name="ticket" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state == 'served'"
                            />
                        </group>
                    </group>
                    <field name="payload" readonly="state == 'served'" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cbs_mock_file" model="ir.actions.act_window">
        <field name="name">CBS Mock Files</field>
        <field name="res_model">l10n_br_cbs_assisted_assessment.mock.file</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_cbs_mock_file"
        name="CBS Mock Files"
        parent="l10n_br_assisted_assessment.menu_assessment_root"
        action="action_cbs_mock_file"
        sequence="25"
        groups="l10n_br_assisted_assessment.group_manager"
    />
</odoo>
