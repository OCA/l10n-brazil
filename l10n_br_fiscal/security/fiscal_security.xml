<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="module_category_l10n_br_fiscal_management" model="ir.module.category">
        <field name="name">Brazilian Fiscal</field>
        <field
            name="description"
        >Extends Odoo to helps you manage your brazilian fiscal documents, taxes and etc...</field>
        <field name="sequence" eval="30" />
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Fiscal User</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Fiscal Manager</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('l10n_br_fiscal.group_user'))]"
        />
    </record>

    <record id="group_data_maintenance" model="res.groups">
        <field name="name">Fiscal Data Maitenance</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field
            name="group_ids"
            eval="[Command.link(ref('l10n_br_fiscal.group_manager')), Command.link(ref('l10n_br_fiscal.group_data_maintenance'))]"
        />
    </record>
</odoo>
