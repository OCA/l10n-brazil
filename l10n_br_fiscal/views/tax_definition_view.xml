<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tax_definition_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.definition.tree</field>
        <field name="model">l10n_br_fiscal.tax.definition</field>
        <field name="arch" type="xml">
            <tree>
                <field name="state" invisible="1" />
                <field name="tax_group_id" />
                <field name="is_taxed" />
                <field name="tax_id" />
                <field name="cst_code" />
                <field name="product_ids" widget="many2many_tags" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="tax_definition_icms_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.definition.icms.tree</field>
        <field name="model">l10n_br_fiscal.tax.definition</field>
        <field name="arch" type="xml">
            <tree
                decoration-info="state in ('draft', 'review')"
                decoration-muted="state == 'expired'"
            >
                <field name="id" optional="hide" />
                <field name="is_benefit" invisible="1" />
                <field name="tax_group_id" invisible="1" />
                <field name="state_from_id" />
                <field name="state_to_ids" widget="many2many_tags" />
                <field name="tax_id" />
                <field name="cst_code" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'review'"
                    decoration-danger="state == 'expired'"
                    optional="show"
                />
            </tree>
        </field>
    </record>

    <record id="tax_definition_icms_benefit_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.definition.icms.benefit.tree</field>
        <field name="model">l10n_br_fiscal.tax.definition</field>
        <field name="inherit_id" ref="tax_definition_icms_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="is_benefit" position="after">
                <field name="code" />
                <field name="description" />
            </field>
        </field>
    </record>

    <record id="tax_definition_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.definition.form</field>
        <field name="model">l10n_br_fiscal.tax.definition</field>
        <field name="arch" type="xml">
            <form string="Tax Definition">
                <field name="company_id" invisible="1" />
                <field name="icms_regulation_id" invisible="1" />
                <field name="tax_domain" invisible="1" />
                <header>
                    <button
                        name="action_review"
                        type="object"
                        states="draft"
                        string="Review"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <button
                        name="action_approve"
                        type="object"
                        states="review,expired"
                        string="Approve"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        states="review,approved"
                        string="Reset To Draft"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field
                            name="tax_group_id"
                            force_save="1"
                            attrs="{'readonly': [('icms_regulation_id', '!=', False)]}"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field name="type_in_out" invisible="1" />
                        <field name="is_taxed" />
                        <field
                            name="is_debit_credit"
                            attrs="{'invisible': [('is_taxed', '=', False)]}"
                        />
                        <field name="custom_tax" />
                        <field
                            name="tax_id"
                            attrs="{'invisible': [('custom_tax', '=', False)], 'required': [('custom_tax', '=', True)]}"
                        />
                        <field
                            name="cst_id"
                            force_save="1"
                            attrs="{'invisible': ['|', ('custom_tax', '=', False), ('tax_domain', 'not in', ('icms','icmssn', 'icmsst', 'ipi', 'pis', 'pisst', 'cofins', 'cofinsst', 'ibs', 'cbs', 'is'))], 'required': [('custom_tax', '=', True), ('tax_domain', 'in', ('icms','icmssn', 'icmsst', 'ipi', 'pis', 'pisst', 'cofins', 'cofinsst', 'ibs', 'cbs', 'is'))]}"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field
                            name="ipi_guideline_id"
                            attrs="{'invisible': [('tax_domain', '!=', 'ipi')]}"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field
                            name="is_benefit"
                            attrs="{'invisible': [('tax_domain', '!=', 'icms')]}"
                        />
                    </group>
                    <group
                        name="tax_benefit"
                        string="Tax Benefit"
                        attrs="{'invisible': [('is_benefit', '=', False)]}"
                    >
                        <field
                            name="code"
                            attrs="{'required': [('is_benefit', '!=', False)]}"
                        />
                        <field
                            name="description"
                            attrs="{'required': [('is_benefit', '!=', False)]}"
                        />
                        <field
                            name="benefit_type"
                            attrs="{'required': [('is_benefit', '!=', False)]}"
                        />
                        <field
                            name="icms_relief_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field name="icms_relief_type" />
                    </group>
                    <group name="state" string="State">
                        <field
                            name="state_from_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                            attrs="{'required': [('is_benefit', '=', True)]}"
                        />
                        <field name="state_to_ids" options="{'no_create': True}" />
                    </group>
                    <notebook>
                        <page name="ncms_page" string="NCM">
                            <group name="ncms" string="NCMs">
                                <label for="ncms" />
                                <div class="o_row">
                                    <field
                                        name="ncms"
                                        force_save="1"
                                        class="oe_inline"
                                    />
                                    <button
                                        name="action_search_ncms"
                                        type="object"
                                        class="oe_inline btn-sm btn-link mb4 fa fa-search oe_edit_only"
                                        aria-label="Search NCMs"
                                        title="Search NCMs"
                                    />
                                </div>
                                <field
                                    name="ncm_ids"
                                    options="{'no_create': True}"
                                    force_save="1"
                                    nolabel="1"
                                    colspan="2"
                                />
                                <field name="ncm_exception" />
                                <field name="not_in_ncms" />
                            </group>
                        </page>
                        <page name="nbm_page" string="NBM">
                            <group name="nbms" string="NBMs">
                                <label for="nbms" />
                                <div class="o_row">
                                    <field
                                        name="nbms"
                                        force_save="1"
                                        class="oe_inline"
                                    />
                                    <button
                                        name="action_search_nbms"
                                        type="object"
                                        class="oe_inline btn-sm btn-link mb4 fa fa-search oe_edit_only"
                                        aria-label="Search NBMs"
                                        title="Search NBMs"
                                    />
                                </div>
                                <field
                                    name="nbm_ids"
                                    options="{'no_create': True}"
                                    force_save="1"
                                    nolabel="1"
                                    colspan="2"
                                />
                                <field name="not_in_nbms" />
                            </group>
                        </page>
                        <page name="cests_page" string="CEST">
                            <group name="cests" string="CESTs">
                                <label for="cests" />
                                <div class="o_row">
                                    <field
                                        name="cests"
                                        force_save="1"
                                        class="oe_inline"
                                    />
                                    <button
                                        name="action_search_cests"
                                        type="object"
                                        class="oe_inline btn-sm btn-link mb4 fa fa-search oe_edit_only"
                                        aria-label="Search CESTs"
                                        title="Search CESTs"
                                    />
                                </div>
                                <field
                                    name="cest_ids"
                                    force_save="1"
                                    nolabel="1"
                                    colspan="2"
                                    options="{'no_create': True}"
                                />
                            </group>
                        </page>
                        <page
                            name="city_taxation_codes_page"
                            string="City Taxation Code"
                        >
                            <group
                                name="city_taxation_codes"
                                string="City Taxation Codes"
                            >
                                <field
                                    name="city_taxation_code_ids"
                                    force_save="1"
                                    nolabel="1"
                                    colspan="2"
                                />
                            </group>
                        </page>
                        <page
                            name="national_taxation_codes_page"
                            string="National Taxation Code"
                        >
                            <group
                                name="national_taxation_codes"
                                string="National Taxation Codes"
                            >
                                <field
                                    name="national_taxation_code_ids"
                                    force_save="1"
                                    nolabel="1"
                                    colspan="2"
                                />
                            </group>
                        </page>
                        <page name="service_types_page" string="Fiscal Service Type">
                            <group name="service_types" string="Fiscal Service Types">
                                <field
                                    name="service_type_ids"
                                    force_save="1"
                                    nolabel="1"
                                    colspan="2"
                                />
                            </group>
                        </page>
                        <page name="products_page" string="Product">
                            <group name="products" string="Products">
                                <field
                                    name="product_ids"
                                    force_save="1"
                                    nolabel="1"
                                    colspan="2"
                                />
                            </group>
                        </page>
                        <page name="fiscal_profile_page" string="Fiscal Profile">
                            <group name="fiscal_profile" string="Fiscal Profile">
                                <field name="ind_final" />
                            </group>
                        </page>
                        <page name="help" string="Help">
                            <div class="alert alert-info" role="alert">
                                <strong>A tax definition is an exception rule</strong>:
                                it says "in this situation, this tax behaves like
                                this" (is not levied, is suspended, uses another
                                rate...). Where there is no exception rule, the
                                default taxes of the company apply and, in normal
                                regime companies, those of the NCM of the product and
                                of the ICMS regulation.
                            </div>
                            <h4>Where a rule can be and which one prevails</h4>
                            <p>The system gathers the rules from several places, in
                            this order. Each step can override what came from the
                            previous one:</p>
                            <div style="max-width:560px;">
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:8px 14px; margin:4px 0; background:#f8f9fa;"
                                >1. Default taxes of the <strong>company</strong> <small
                                        class="text-muted"
                                    >(according to the tax framework)</small></div>
                                <div style="text-align:center;"><i
                                        class="fa fa-arrow-down"
                                        title="Then"
                                    /></div>
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:8px 14px; margin:4px 0; background:#f8f9fa;"
                                >2. <strong>NCM</strong> of the product and <strong
                                    >ICMS regulation</strong> by state <small
                                        class="text-muted"
                                    >(normal regime companies)</small></div>
                                <div style="text-align:center;"><i
                                        class="fa fa-arrow-down"
                                        title="Then"
                                    /></div>
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:8px 14px; margin:4px 0; background:#f8f9fa;"
                                >3. Rules of the <strong>operation line</strong> <small
                                        class="text-muted"
                                    >(e.g. shipment without PIS/COFINS)</small></div>
                                <div style="text-align:center;"><i
                                        class="fa fa-arrow-down"
                                        title="Then"
                                    /></div>
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:8px 14px; margin:4px 0; background:#f8f9fa;"
                                >4. Rules of the <strong>CFOP</strong></div>
                                <div style="text-align:center;"><i
                                        class="fa fa-arrow-down"
                                        title="Then"
                                    /></div>
                                <div
                                    style="border:1px solid #b8e0b8; border-radius:8px; padding:8px 14px; margin:4px 0; background:#eaf7ea;"
                                >5. Rules of the <strong>fiscal profile of the
                                    partner</strong> <small
                                        class="text-muted"
                                    >(the final word)</small></div>
                            </div>
                            <h4>Good practices</h4>
                            <ul>
                                <li>Fill in only the conditions you need (destination
                                state, NCM, CEST, product...). A blank condition
                                applies to all cases.</li>
                                <li>Avoid, in the same place, two rules for the same
                                tax that apply to the same situation. A single, well
                                delimited rule is easier to understand and
                                maintain.</li>
                                <li>Review and <strong>approve</strong> the rule as soon
                                as you finish configuring it. In the ICMS regulation,
                                only approved rules apply.</li>
                                <li>To retire a rule that no longer applies, set it to
                                <strong>Expired</strong>.</li>
                                <li>Before creating a new rule, try to understand where
                                the current value comes from: often the right change
                                is in the product record (NCM) or in the operation,
                                not here.</li>
                            </ul>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>
