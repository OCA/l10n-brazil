<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_icms_benefit_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.icms.benefit.tree</field>
        <field name="model">l10n_br_fiscal.icms.benefit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="type" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="view_icms_benefit_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.icms.benefit.form</field>
        <field name="model">l10n_br_fiscal.icms.benefit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="type" />
                        <field name="description" widget="text" />
                        <field
                            name="state_id"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_icms_benefit" model="ir.actions.act_window">
        <field name="name">ICMS Benefit</field>
        <field name="res_model">l10n_br_fiscal.icms.benefit</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
