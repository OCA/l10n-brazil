<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tax_classification_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.classification.search</field>
        <field name="model">l10n_br_fiscal.tax.classification</field>
        <field name="arch" type="xml">
            <search string="Tax Classification">
                <field name="code" />
                <field name="name" />
                <field name="description" />
                <group expand="0" string="Group By...">
                    <filter
                        string="IBS Tax"
                        name="tax_ibs_id"
                        domain="[]"
                        context="{'group_by' : 'tax_ibs_id'}"
                    />
                    <filter
                        string="CBS Tax"
                        name="tax_cbs_id"
                        domain="[]"
                        context="{'group_by' : 'tax_cbs_id'}"
                    />
                    <filter
                        string="IS Tax"
                        name="tax_is_id"
                        domain="[]"
                        context="{'group_by' : 'tax_is_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="tax_classification_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.classification.tree</field>
        <field name="model">l10n_br_fiscal.tax.classification</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="tax_ibs_id" />
                <field name="tax_cbs_id" />
                <field name="tax_is_id" />
                <field name="effective_date" />
            </tree>
        </field>
    </record>

    <record id="tax_classification_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.classification.form</field>
        <field name="model">l10n_br_fiscal.tax.classification</field>
        <field name="arch" type="xml">
            <form string="Tax Classification">
                <sheet>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="effective_date" />
                        </group>
                        <group>
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="description"
                            placeholder="Detailed description of the tax classification"
                        />
                    </group>
                    <notebook>
                        <page string="Taxes" name="taxes">
                            <group>
                                <field name="tax_ibs_id" />
                                <field name="tax_cbs_id" />
                                <field name="tax_is_id" />
                            </group>
                        </page>
                        <page string="Products" name="products">
                            <field name="product_tmpl_ids" readonly="1">
                                <tree>
                                    <field name="name" />
                                    <field name="default_code" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tax_classification" model="ir.actions.act_window">
        <field name="name">Tax Classification</field>
        <field name="res_model">l10n_br_fiscal.tax.classification</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tax classification
            </p>
            <p>
                Tax classifications are used to determine how products and services
                will be taxed by the new taxes (IBS, CBS, IS) that will come into
                effect from 2026.
            </p>
        </field>
    </record>

</odoo>
