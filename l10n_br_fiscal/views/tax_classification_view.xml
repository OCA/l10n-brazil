<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tax_classification_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.classification.search</field>
        <field name="model">l10n_br_fiscal.tax.classification</field>
        <field name="arch" type="xml">
            <search string="Tax Classification">
                <field name="code" />
                <field name="name" />
                <field name="description" />
            </search>
        </field>
    </record>

    <record id="tax_classification_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.classification.tree</field>
        <field name="model">l10n_br_fiscal.tax.classification</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="tax_classification_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.tax.classification.form</field>
        <field name="model">l10n_br_fiscal.tax.classification</field>
        <field name="arch" type="xml">
            <form string="Tax Classification">
                <sheet>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                        </group>
                        <group>
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="description"
                            placeholder="Descrição cClassTrib - Detailed description of the tax classification"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tax_classification" model="ir.actions.act_window">
        <field name="name">Tax Classification</field>
        <field name="res_model">l10n_br_fiscal.tax.classification</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tax classification
            </p>
            <p>
                Tax classifications (cClassTrib) from Brazilian Tax Reform (LC 214/2025).
                Each classification has a code, name, and description. The tax treatment
                (IBS, CBS, IS) is defined separately in Tax Definition.
            </p>
        </field>
    </record>

</odoo>
