<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="operation_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.search</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="arch" type="xml">
            <search string="Fiscal Operation">
                <field name="code" />
                <field name="name" />
                <group expand="0" string="Group By...">
                    <filter
                        string="Fiscal Operation Type"
                        name="fiscal_operation_type"
                        domain="[]"
                        context="{'group_by' : 'fiscal_operation_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="operation_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.tree</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="fiscal_operation_type" />
                <field name="fiscal_type" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="operation_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.form</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="arch" type="xml">
            <form string="Fiscal Operation">
                <field name="id" invisible="1" />
                <header>
                    <button
                        name="action_review"
                        type="object"
                        states="draft"
                        string="Review"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <button
                        name="action_approve"
                        type="object"
                        states="review,expired"
                        string="Approve"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        states="review,approved"
                        string="Reset To Draft"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <h1 class="o_row row no-gutters d-flex">
                        <div class="col-10">
                            <label for="name" class="oe_edit_only" />
                            <div class="o_row d-flex">
                                <field name="name" class="oe_inline" />
                            </div>
                        </div>
                    </h1>
                    <group>
                        <group>
                            <field name="fiscal_operation_type" />
                            <field name="fiscal_type" />
                            <field name="code" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="edoc_purpose" />
                        </group>
                        <group>
                            <field name="default_price_unit" />
                            <field name="return_fiscal_operation_id" />
                            <field name="inverse_fiscal_operation_id" />
                        </group>
                    </group>
                    <notebook>
                        <page name="operation_line" string="Operation Line">
                            <field
                                name="line_ids"
                                context="{'default_fiscal_operation_id': id, 'default_fiscal_type': fiscal_type, 'default_fiscal_operation_type': fiscal_operation_type, 'form_view_ref': 'l10n_br_fiscal.operation_line_form' , 'show_code_only': 1}"
                            />
                        </page>
                        <page name="operation_document_type" string="Fiscal Documents">
                            <field
                                name="document_type_ids"
                                context="{'default_fiscal_operation_id': id}"
                            >
                                <tree>
                                    <field name="document_type_id" />
                                    <field name="document_serie_id" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="company_id" invisible="1" />
                                        <field
                                            name="document_type_id"
                                            options="{'no_create': True, 'no_create_edit': True}"
                                        />
                                        <field
                                            name="document_serie_id"
                                            context="{'default_document_type_id': document_type_id, 'default_company_id': company_id}"
                                        />
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="comment_ids" />
                        </page>
                        <page name="help" string="Ajuda">
                            <div class="alert alert-info" role="alert">
                                <strong>A operação fiscal diz ao sistema o que a sua
                                empresa está fazendo</strong>: vendendo, comprando,
                                devolvendo, transferindo entre filiais, mandando
                                mercadoria para industrialização... É a partir dela que
                                o sistema preenche sozinho o CFOP, os impostos e as
                                mensagens da nota fiscal.
                            </div>
                            <h4>Como funciona</h4>
                            <div
                                style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin:12px 0;"
                            >
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:10px 14px; background:#f8f9fa;"
                                >
                                    1. Você cria um pedido ou uma fatura<br /><small
                                        class="text-muted"
                                    >venda, compra, transferência...</small>
                                </div>
                                <div style="font-size:20px;">→</div>
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:10px 14px; background:#f8f9fa;"
                                >
                                    2. Escolhe a operação<br /><small
                                        class="text-muted"
                                    >ex.: "Venda", "Bonificação"</small>
                                </div>
                                <div style="font-size:20px;">→</div>
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:10px 14px; background:#f8f9fa;"
                                >
                                    3. O sistema escolhe a linha certa<br /><small
                                        class="text-muted"
                                    >conforme o cliente, o produto e o regime da sua empresa</small>
                                </div>
                                <div style="font-size:20px;">→</div>
                                <div
                                    style="border:1px solid #b8e0b8; border-radius:8px; padding:10px 14px; background:#eaf7ea;"
                                >
                                    4. A nota sai pronta<br /><small
                                        class="text-muted"
                                    >CFOP, impostos e mensagens preenchidos</small>
                                </div>
                            </div>
                            <h4>Boas práticas</h4>
                            <ul>
                                <li><strong>Antes de criar uma operação nova</strong>,
                                veja se já existe uma parecida. As operações mais
                                comuns (venda, compra, devolução, transferência,
                                bonificação, simples remessa, industrialização por
                                encomenda...) já vêm cadastradas.</li>
                                <li>Se precisar de uma variação, <strong>duplique uma
                                operação parecida</strong> e ajuste a cópia. É mais
                                seguro do que começar do zero.</li>
                                <li>A <strong>operação de retorno</strong> liga a ida à
                                volta: a "Venda", por exemplo, aponta para a
                                "Devolução de Venda". É ela que o sistema usa para
                                preencher a operação quando você devolve um
                                documento.</li>
                                <li>Só operações <strong>aprovadas</strong> aparecem nos
                                documentos. Deixe a operação em rascunho enquanto
                                estiver configurando e aprove quando terminar: as
                                linhas são aprovadas junto.</li>
                                <li><strong>Várias empresas no mesmo banco?</strong>
                                Uma operação sem empresa preenchida vale para todas.
                                O que muda conforme o regime de cada empresa (CST no
                                regime normal, CSOSN no Simples Nacional) vem dos
                                impostos padrão da própria empresa e das linhas
                                específicas de cada regime, quando a operação tiver.
                                Se uma empresa precisa de um comportamento só dela,
                                duplique a operação e preencha o campo Empresa na
                                cópia: a mudança não afeta as outras.</li>
                            </ul>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>
