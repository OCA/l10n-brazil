<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="operation_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.search</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="arch" type="xml">
            <search string="Fiscal Operation">
                <field name="code" />
                <field name="name" />
                <group expand="0" string="Group By...">
                    <filter
                        string="Fiscal Operation Type"
                        name="fiscal_operation_type"
                        domain="[]"
                        context="{'group_by' : 'fiscal_operation_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="operation_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.tree</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="fiscal_operation_type" />
                <field name="fiscal_type" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="operation_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.form</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="arch" type="xml">
            <form string="Fiscal Operation">
                <field name="id" invisible="1" />
                <header>
                    <button
                        name="action_review"
                        type="object"
                        states="draft"
                        string="Review"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <button
                        name="action_approve"
                        type="object"
                        states="review,expired"
                        string="Approve"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        states="review,approved"
                        string="Reset To Draft"
                        class="oe_highlight"
                        groups="l10n_br_fiscal.group_manager"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <h1 class="o_row row no-gutters d-flex">
                        <div class="col-10">
                            <label for="name" class="oe_edit_only" />
                            <div class="o_row d-flex">
                                <field name="name" class="oe_inline" />
                            </div>
                        </div>
                    </h1>
                    <group>
                        <group>
                            <field name="fiscal_operation_type" />
                            <field name="fiscal_type" />
                            <field name="code" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="edoc_purpose" />
                        </group>
                        <group>
                            <field name="default_price_unit" />
                            <field name="return_fiscal_operation_id" />
                            <field name="inverse_fiscal_operation_id" />
                        </group>
                    </group>
                    <notebook>
                        <page name="operation_line" string="Operation Line">
                            <field
                                name="line_ids"
                                context="{'default_fiscal_operation_id': id, 'default_fiscal_type': fiscal_type, 'default_fiscal_operation_type': fiscal_operation_type, 'form_view_ref': 'l10n_br_fiscal.operation_line_form' , 'show_code_only': 1}"
                            />
                        </page>
                        <page name="operation_document_type" string="Fiscal Documents">
                            <field
                                name="document_type_ids"
                                context="{'default_fiscal_operation_id': id}"
                            >
                                <tree>
                                    <field name="document_type_id" />
                                    <field name="document_serie_id" />
                                </tree>
                                <form>
                                    <group>
                                        <field name="company_id" invisible="1" />
                                        <field
                                            name="document_type_id"
                                            options="{'no_create': True, 'no_create_edit': True}"
                                        />
                                        <field
                                            name="document_serie_id"
                                            context="{'default_document_type_id': document_type_id, 'default_company_id': company_id}"
                                        />
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="comment_ids" />
                        </page>
                        <page name="help" string="Help">
                            <div class="alert alert-info" role="alert">
                                <strong>The fiscal operation tells the system what your
                                company is doing</strong>: selling, buying, returning,
                                transferring between branches, sending goods for
                                industrialization... The system uses it to fill in the
                                CFOP, the taxes and the messages of the invoice by
                                itself.
                            </div>
                            <h4>How it works</h4>
                            <div
                                style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin:12px 0;"
                            >
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:10px 14px; background:#f8f9fa;"
                                >
                                    1. You create an order or an invoice<br /><small
                                        class="text-muted"
                                    >sale, purchase, transfer...</small>
                                </div>
                                <div style="font-size:20px;"><i
                                        class="fa fa-arrow-right"
                                        title="Next step"
                                    /></div>
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:10px 14px; background:#f8f9fa;"
                                >
                                    2. You pick the operation<br /><small
                                        class="text-muted"
                                    >e.g. "Venda" (sale), "Bonificação" (bonus)</small>
                                </div>
                                <div style="font-size:20px;"><i
                                        class="fa fa-arrow-right"
                                        title="Next step"
                                    /></div>
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:10px 14px; background:#f8f9fa;"
                                >
                                    3. The system picks the right line<br /><small
                                        class="text-muted"
                                    >according to the customer, the product and the tax framework of your company</small>
                                </div>
                                <div style="font-size:20px;"><i
                                        class="fa fa-arrow-right"
                                        title="Next step"
                                    /></div>
                                <div
                                    style="border:1px solid #b8e0b8; border-radius:8px; padding:10px 14px; background:#eaf7ea;"
                                >
                                    4. The invoice comes out ready<br /><small
                                        class="text-muted"
                                    >CFOP, taxes and messages filled in</small>
                                </div>
                            </div>
                            <h4>Good practices</h4>
                            <ul>
                                <li><strong>Before creating a new operation</strong>,
                                check whether a similar one already exists. The most
                                common operations (sale, purchase, return, transfer,
                                bonus, simple shipment, industrialization on
                                order...) are already registered.</li>
                                <li>If you need a variation, <strong>duplicate a
                                similar operation</strong> and adjust the copy. It is
                                safer than starting from scratch.</li>
                                <li>The <strong>return operation</strong> links the way
                                out to the way back: "Venda" (sale), for example,
                                points to "Devolução de Venda" (sale return). The system uses it to fill in the
                                operation when you return a document.</li>
                                <li>Only <strong>approved</strong> operations show up
                                in documents. Keep the operation in draft while you
                                configure it and approve it when you are done: its
                                lines are approved together.</li>
                                <li><strong
                                    >Several companies in the same database?</strong>
                                An operation with no company set is valid for all of
                                them. What changes with the tax framework of each
                                company (CST in the normal regime, CSOSN in the
                                Simples Nacional) comes from the default taxes of the
                                company itself and from the lines specific to each
                                framework, when the operation has them. If a company
                                needs a behavior of its own, duplicate the operation
                                and fill in the Company field on the copy: the change
                                does not affect the others.</li>
                            </ul>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>
