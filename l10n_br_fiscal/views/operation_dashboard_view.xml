<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="operation_dashboard_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.dashboard.search</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="period_today"
                    string="Today"
                    context="{'dashboard_period': 'today'}"
                />
                <filter
                    name="period_week"
                    string="Last 7 days"
                    context="{'dashboard_period': 'week'}"
                />
                <filter
                    name="period_month"
                    string="This month"
                    context="{'dashboard_period': 'month'}"
                />
                <separator />
                <filter
                    name="with_activity"
                    string="With Activity"
                    domain="[('dashboard_active', '=', True)]"
                />
                <separator />
                <filter
                    name="outgoing"
                    string="Outgoing"
                    domain="[('fiscal_operation_type', '=', 'out')]"
                />
                <filter
                    name="incoming"
                    string="Incoming"
                    domain="[('fiscal_operation_type', '=', 'in')]"
                />
            </search>
        </field>
    </record>

    <record id="operation_dashboard_kanban" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.dashboard.kanban</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="arch" type="xml">
            <kanban
                create="false"
                can_open="0"
                highlight_color="color"
                class="o_kanban_dashboard"
            >
                <field name="kanban_dashboard" />
                <templates>
                    <t t-name="card">
                        <t
                            t-set="dashboard"
                            t-value="JSON.parse(record.kanban_dashboard.raw_value)"
                        />
                        <div t-att-class="dashboard.active ? '' : 'opacity-50'">
                            <div
                                class="d-flex justify-content-between align-items-baseline"
                            >
                                <a
                                    class="fs-5 fw-bold"
                                    type="object"
                                    name="open_action"
                                >
                                    <field name="name" />
                                </a>
                                <field
                                    name="fiscal_operation_type"
                                    class="badge rounded-pill text-bg-light flex-shrink-0 ms-2"
                                />
                            </div>
                            <div class="row mt-3">
                                <div class="col-6" name="pending">
                                    <div class="small text-muted">Pending</div>
                                    <a
                                        t-if="dashboard.number_error"
                                        class="d-flex text-danger fw-bold"
                                        type="object"
                                        name="open_action"
                                        context="{'dashboard_bucket': 'error'}"
                                    >
                                        Rejected
                                        <span
                                        class="ms-auto"
                                        t-out="dashboard.number_error"
                                    />
                                    </a>
                                    <a
                                        t-if="dashboard.number_processing"
                                        t-att-class="'d-flex' + (dashboard.processing_late ? ' text-warning fw-bold' : '')"
                                        type="object"
                                        name="open_action"
                                        context="{'dashboard_bucket': 'processing'}"
                                    >
                                        Processing
                                        <span
                                        class="ms-auto"
                                        t-out="dashboard.number_processing"
                                    />
                                    </a>
                                    <a
                                        t-if="dashboard.number_2confirm"
                                        class="d-flex text-primary"
                                        type="object"
                                        name="open_action"
                                        context="{'dashboard_bucket': '2confirm'}"
                                    >
                                        To send
                                        <span
                                        class="ms-auto"
                                        t-out="dashboard.number_2confirm"
                                    />
                                    </a>
                                    <span
                                        t-if="!dashboard.number_error and !dashboard.number_processing and !dashboard.number_2confirm"
                                        class="text-muted"
                                    >Nothing pending</span>
                                </div>
                                <div class="col-6" name="period">
                                    <div
                                        class="small text-muted"
                                        t-out="dashboard.period"
                                    />
                                    <a
                                        class="d-flex text-success"
                                        type="object"
                                        name="open_action"
                                        context="{'dashboard_bucket': 'authorized'}"
                                    >
                                        Authorized
                                        <span
                                        class="ms-auto"
                                        t-out="dashboard.number_authorized"
                                    />
                                    </a>
                                    <div
                                        class="text-end fw-bold"
                                        t-out="dashboard.amount_authorized"
                                    />
                                    <a
                                        t-if="dashboard.number_cancelled"
                                        class="d-flex text-muted"
                                        type="object"
                                        name="open_action"
                                        context="{'dashboard_bucket': 'cancelled'}"
                                    >
                                        Cancellations
                                        <span
                                        class="ms-auto"
                                        t-out="dashboard.number_cancelled"
                                    />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-12 o_kanban_card_manage_section">
                                    <h5 class="o_kanban_card_manage_title">Actions</h5>
                                    <a
                                        role="menuitem"
                                        class="dropdown-item"
                                        type="object"
                                        name="action_create_new"
                                    >New Document</a>
                                    <a
                                        role="menuitem"
                                        class="dropdown-item"
                                        type="object"
                                        name="open_action"
                                    >View All</a>
                                </div>
                            </div>
                            <div
                                t-if="widget.editable"
                                class="o_kanban_card_manage_settings row"
                            >
                                <field
                                    class="col-8"
                                    name="color"
                                    widget="kanban_color_picker"
                                />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
