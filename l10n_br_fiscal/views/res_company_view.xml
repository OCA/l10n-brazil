<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fiscal_res_company_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <notebook>
                <page
                    name="fiscal"
                    string="Fiscal"
                    groups="l10n_br_fiscal.group_manager"
                >
                    <notebook>
                        <page name="tax_framework" string="Tax Framework">
                            <field name="id" invisible="1" />
                            <group string="CNAE and Legal Nature">
                                <field
                                    name="legal_nature_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                                <field
                                    name="cnae_main_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                                <field
                                    name="cnae_secondary_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                            </group>
                            <group string="Tax Framework">
                                <field name="tax_framework" />
                                <field name="accountant_id" />
                                <field
                                    name="accounting_office"
                                    domain="[('is_company', '=', True)]"
                                />
                                <field
                                    name="technical_support_id"
                                    domain="[('is_company', '=', True)]"
                                />
                            </group>
                            <group
                                name="simples"
                                string="Simples Nacional"
                                attrs="{'invisible': [('tax_framework', '=', '3')]}"
                            >
                                <group>
                                    <field name="annual_revenue" />
                                    <field name="payroll_amount" />
                                </group>
                                <group>
                                    <field name="coefficient_r" />
                                    <field name="coefficient_r_percent" />
                                    <field name="simplified_tax_id" />
                                    <field name="simplified_tax_range_id" />
                                </group>
                                <group
                                    colspan="2"
                                    string="Current Effective Taxes for Simples Nacional"
                                >
                                    <field
                                        colspan="2"
                                        nolabel="1"
                                        name="simplified_tax_ids"
                                        context="{'simplified_tax_company_id': id}"
                                    >
                                        <tree create="0" delete="0">
                                            <field name="name" string="Annex" />
                                            <field name="current_range_id" />
                                            <field name="current_effective_tax" />
                                            <field
                                                name="tax_irpj_percent"
                                                digits="[16, 2]"
                                            />
                                            <field
                                                name="tax_csll_percent"
                                                digits="[16, 2]"
                                            />
                                            <field
                                                name="tax_cofins_percent"
                                                digits="[16, 2]"
                                            />
                                            <field
                                                name="tax_pis_percent"
                                                digits="[16, 2]"
                                            />
                                            <field
                                                name="tax_cpp_percent"
                                                digits="[16, 2]"
                                            />
                                            <field
                                                name="tax_icms_percent"
                                                digits="[16, 2]"
                                            />
                                            <field
                                                name="tax_iss_percent"
                                                digits="[16, 2]"
                                            />
                                            <field
                                                name="tax_ipi_percent"
                                                digits="[16, 2]"
                                            />
                                        </tree>
                                    </field>
                                </group>
                            </group>
                            <group
                                name="normal"
                                string="Regime Normal"
                                attrs="{'invisible': [('tax_framework', '!=', '3')]}"
                            >
                                <group>
                                    <field
                                        name="profit_calculation"
                                        attrs="{'required': [('tax_framework', '=', '3')]}"
                                    />
                                </group>
                                <group>
                                    <field name="is_industry" />
                                    <field
                                        name="industry_type"
                                        attrs="{'invisible': [('is_industry', '=', False)], 'required': [('is_industry', '=', True)]}"
                                    />
                                </group>
                            </group>
                        </page>
                        <page name="taxes" string="Taxes">
                            <group name="normal_taxes" string="Default Taxes">
                                <group name="piscofins_taxes" string="PIS/COFINS">
                                    <field
                                        name="piscofins_id"
                                        required="1"
                                        domain="{'3': [('piscofins_type', '=', 'company'), ('id', '!=', %(l10n_br_fiscal.tax_pis_cofins_simples_nacional)d)]}.get(tax_framework, [('piscofins_type', '=', 'company'), ('id', '=', %(l10n_br_fiscal.tax_pis_cofins_simples_nacional)d)])"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                    />
                                    <field name="tax_pis_wh_id" />
                                    <field name="tax_cofins_wh_id" />
                                </group>
                                <group name="ipi_taxes" string="IPI">
                                    <field
                                        name="ripi"
                                        attrs="{'invisible': [('tax_framework', '!=', '3')]}"
                                    />
                                    <field
                                        name="tax_ipi_id"
                                        attrs="{'invisible': [('tax_framework', '=', '3'), ('ripi', '=', True)], 'required': [('tax_framework', '!=', '3')]}"
                                        domain="{'3': [('id', '!=', %(l10n_br_fiscal.tax_ipi_outros)d), ('tax_group_id', '=', %(l10n_br_fiscal.tax_group_ipi)d)]}.get(tax_framework, [('id', '=', %(l10n_br_fiscal.tax_ipi_outros)d)])"
                                    />
                                    <div
                                        class="text-muted"
                                        colspan="2"
                                        attrs="{'invisible': [('ripi', '=', False)]}"
                                    >IPI tax will be calculed by Product NCM and Fiscal Operation.</div>
                                </group>
                                <group name="icms_taxes" string="ICMS">
                                    <field
                                        name="tax_icms_id"
                                        attrs="{'invisible': [('tax_framework', '=', '3')], 'required': [('tax_framework', 'in', ('1', '2'))]}"
                                        domain="{'3': [('tax_group_id', '=', %(l10n_br_fiscal.tax_group_icms)d)]}.get(tax_framework, [('tax_group_id', '=', %(l10n_br_fiscal.tax_group_icmssn)d)])"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                    />
                                    <field
                                        name="icms_regulation_id"
                                        attrs="{'invisible': [('tax_framework', '!=', '3')], 'required': [('tax_framework', '=', '3')]}"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                    />
                                </group>
                                <group name="issqn_taxes" string="ISSQN">
                                    <field name="tax_issqn_id" />
                                    <field name="tax_issqn_wh_id" />
                                </group>
                                <group name="csll_taxes" string="CSLL">
                                    <field name="tax_csll_id" />
                                    <field name="tax_csll_wh_id" />
                                </group>
                                <group name="irpj_taxes" string="IRPJ">
                                    <field name="tax_irpj_id" />
                                    <field name="tax_irpj_wh_id" />
                                </group>
                                <group name="inss_taxes" string="INSS">
                                    <field name="tax_inss_id" />
                                    <field name="tax_inss_wh_id" />
                                </group>
                                <group
                                    name="ibs_cbs_taxes_classification"
                                    string="IBS/CBS Tax Classification"
                                >
                                    <field name="tax_classification_id" />
                                </group>
                            </group>
                            <group name="advanced_taxes" string="Advanced Taxes">
                                <field
                                    name="tax_definition_ids"
                                    nolabel="1"
                                    context="{'tree_view_ref': 'l10n_br_fiscal.tax_definition_tree','form_view_ref': 'l10n_br_fiscal.tax_definition_form', 'default_company_id': id}"
                                    colspan="2"
                                />
                            </group>
                        </page>
                        <page name="delivery_costs" string="Delivery Costs">
                            <group>
                                <group>
                                    <field name="delivery_costs" />
                                    <div
                                        class="text-muted"
                                    >Define if Delivery Costs (Freight, Insurance and Other Costs) should be informed by Line or by Total</div>
                                </group>
                            </group>
                        </page>
                        <page name="edoc" string="Documentos Eletrônicos">
                            <group name="edoc">
                                <group>
                                    <field name="processador_edoc" />
                                    <field name="document_save_disk" />
                                    <field name="document_type_id" />
                                </group>
                                <group />
                            </group>
                        </page>
                        <page name="fiscal_help" string="Help">
                            <div class="alert alert-info" role="alert">
                                <strong>The tax framework of the company is the
                                central key of the tax calculation.</strong>
                                Everything that depends on the framework (the invoice
                                codes, CST or CSOSN, PIS/COFINS and ICMS) adjusts
                                itself from what is configured here.
                            </div>
                            <h4>Changed framework? The change is made here</h4>
                            <div
                                style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin:12px 0;"
                            >
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:10px 14px; background:#f8f9fa;"
                                >
                                    Moved from <strong>Simples</strong> to
                                    <strong>Presumed Profit</strong>?<br />
                                    <small class="text-muted">Change the tax
                                    framework to "3 - Regime Normal" and the profit
                                    calculation to Presumed.</small>
                                </div>
                                <div
                                    style="border:1px solid #ccc; border-radius:8px; padding:10px 14px; background:#f8f9fa;"
                                >
                                    From <strong>Presumed Profit</strong> to
                                    <strong>Real Profit</strong>?<br />
                                    <small class="text-muted">Change only the profit
                                    calculation to Real. The default PIS/COFINS of
                                    the company switches by itself from cumulative to
                                    non-cumulative.</small>
                                </div>
                            </div>
                            <p>Operations that have lines by tax framework
                            <strong>do not need to be reconfigured</strong>: they
                            recognize the framework of the company and start issuing
                            with the right codes (CSOSN in the Simples, CST in the
                            normal regime) from the next invoice. Review with the
                            accountant only the operations created for a specific
                            framework.</p>
                            <ul>
                                <li><strong>Simples Nacional</strong> company: fill
                                in the gross revenue of the last 12 months and the
                                payroll. With them and the main CNAE, the system
                                computes the annex, the range and the R factor, and
                                the DAS percentage comes from them.</li>
                                <li>Confirm the change of framework with your
                                accountant: the cutoff date matters, and invoices
                                already issued are not recalculated.</li>
                            </ul>
                        </page>
                    </notebook>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
