<odoo>
    <record id="uom_uom_form_view" model="ir.ui.view">
        <field name="name">uom.uom.form (in l10n_br_fiscal)</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_form" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" required="1" />
            </field>
            <field name="name" position="after">
                <field name="description" required="1" />
            </field>
        </field>
    </record>

    <record id="uom_uom_tree_view" model="ir.ui.view">
        <field name="name">uom.uom.tree (in l10n_br_fiscal)</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_list" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" required="1" />
            </field>
            <field name="name" position="after">
                <field name="description" required="1" />
            </field>
        </field>
    </record>
</odoo>
