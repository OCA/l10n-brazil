<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="event_type_search" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.event.type.search</field>
        <field name="model">l10n_br_fiscal.event.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
                <field name="actor" />
                <field name="document_type_ids" />
            </search>
        </field>
    </record>

    <record id="event_type_tree" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.event.type.tree</field>
        <field name="model">l10n_br_fiscal.event.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="actor" />
                <field name="document_type_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <record id="event_type_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.event.type.form</field>
        <field name="model">l10n_br_fiscal.event.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="description" />
                        <field name="actor" />
                        <field name="document_type_ids" widget="many2many_tags" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
