<odoo>
    <!--
      The accountant of the demo company of the presumed profit. It is here,
      next to the accountant_id field, so that every demo document of the
      localization is created with it: the CT-e and the MDF-e authorize the
      company accountant in autXML when the document is created.
    -->
    <record id="demo_accountant" model="res.partner">
        <field name="name">Contador de Demonstracao</field>
        <field name="is_company" eval="False" />
        <field name="cnpj_cpf">730.144.582-28</field>
        <field name="zip">01311-000</field>
        <field name="street_name">Avenida Paulista</field>
        <field name="street_number">1</field>
        <field name="district">Bela Vista</field>
        <field name="phone">11999999999</field>
        <field name="email">contador@example.com</field>
        <field name="country_id" ref="base.br" />
        <field name="state_id" ref="base.state_br_sp" />
        <field name="city_id" ref="l10n_br_base.city_3550308" />
    </record>
    <record id="l10n_br_base.empresa_lucro_presumido" model="res.company">
        <field name="accountant_id" ref="demo_accountant" />
    </record>
</odoo>
