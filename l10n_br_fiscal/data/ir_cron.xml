<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="l10n_br_fiscal_ncm_scheduler_cron" forcecreate="True" model="ir.cron">
        <field name="name">Update NCM Estimate Taxes</field>
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_l10n_br_fiscal_ncm" />
        <field name="code">model._scheduled_update()</field>
        <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 04:00:00')" />
    </record>

    <record id="l10n_br_fiscal_nbs_scheduler_cron" forcecreate="True" model="ir.cron">
        <field name="name">Update NBS Estimate Taxes</field>
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <field name="model_id" ref="model_l10n_br_fiscal_nbs" />
        <field name="code">model._scheduled_update()</field>
    </record>
</odoo>
