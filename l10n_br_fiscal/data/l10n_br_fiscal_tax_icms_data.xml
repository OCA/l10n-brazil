<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="True">

  <record id="tax_icms_regulation" model="l10n_br_fiscal.icms.regulation">
    <field name="name">Regulamento do ICMS</field>
    <field name="icms_imported_tax_id" ref="l10n_br_fiscal.tax_icms_4" />
  </record>

  <!-- ICMS - Simples Faturamento -->
  <record
        id="tax_icms_definition_simples_faturamento"
        model="l10n_br_fiscal.tax.definition"
    >
    <field name="is_taxed" eval="True" />
    <field name="is_debit_credit" eval="True" />
    <field name="custom_tax" eval="True" />
    <field name="tax_id" ref="l10n_br_fiscal.tax_icms_0" />
    <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_icms" />
    <field name="cst_id" ref="l10n_br_fiscal.cst_icms_90" />
    <field
            name="fiscal_operation_line_id"
            ref="l10n_br_fiscal.fo_simples_faturamento_simples_faturamento"
        />
    <field name="state">approved</field>
  </record>

  <!-- PIS - Entrega Futura: a receita já foi reconhecida na nota de simples
       faturamento, então a remessa posterior não é nova receita -> CST 49
       (Outras Operações de Saída), não CST 06 (alíquota zero). -->
  <record id="tax_pis_definition_entrega_futura" model="l10n_br_fiscal.tax.definition">
    <field name="is_taxed" eval="False" />
    <field name="is_debit_credit" eval="True" />
    <field name="custom_tax" eval="True" />
    <field name="tax_id" ref="l10n_br_fiscal.tax_pis_outros" />
    <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_pis" />
    <field name="cst_id" ref="l10n_br_fiscal.cst_pis_49" />
    <field
            name="fiscal_operation_line_id"
            ref="l10n_br_fiscal.fo_entrega_futura_entrega_futura"
        />
    <field name="state">approved</field>
  </record>

  <!-- COFINS - Entrega Futura: idem PIS (CST 49). -->
  <record
        id="tax_cofins_definition_entrega_futura"
        model="l10n_br_fiscal.tax.definition"
    >
    <field name="is_taxed" eval="False" />
    <field name="is_debit_credit" eval="True" />
    <field name="custom_tax" eval="True" />
    <field name="tax_id" ref="l10n_br_fiscal.tax_cofins_outros" />
    <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_cofins" />
    <field name="cst_id" ref="l10n_br_fiscal.cst_cofins_49" />
    <field
            name="fiscal_operation_line_id"
            ref="l10n_br_fiscal.fo_entrega_futura_entrega_futura"
        />
    <field name="state">approved</field>
  </record>

  <!-- IPI - Simples Faturamento: sem destaque (o IPI é fato gerador na remessa
       física, não no faturamento). Faltava no core. -->
  <record
        id="tax_ipi_definition_simples_faturamento"
        model="l10n_br_fiscal.tax.definition"
    >
    <field name="is_taxed" eval="False" />
    <field name="is_debit_credit" eval="True" />
    <field name="custom_tax" eval="True" />
    <field name="tax_id" ref="l10n_br_fiscal.tax_ipi_nt" />
    <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_ipi" />
    <field name="cst_id" ref="l10n_br_fiscal.cst_ipi_53" />
    <field
            name="fiscal_operation_line_id"
            ref="l10n_br_fiscal.fo_simples_faturamento_simples_faturamento"
        />
    <field name="state">approved</field>
  </record>

  <!-- IPI - Entrega Futura (remessa de produção 5116): REMOVIDO. O IPI passa a
       ser destacado na remessa física, onde está o fato gerador (saída do
       estabelecimento industrial); o zeramento anterior (CST 51) estava errado.
       O IPI cai no default do produto.
       Escolha de parametrização: o RIPI (Decreto 7.212/2010, art. 407, VII e
       parágrafo 3, e art. 410) também admite o destaque antecipado na nota de
       simples faturamento, e nesse caso a remessa sai sem destaque. Quem faturar
       assim precisa inverter as duas definições (destacar no simples
       faturamento e zerar na remessa).
       Bases existentes: ver o script de migração deste módulo. -->

</odoo>
