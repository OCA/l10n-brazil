<!--
  Remessa de peça defeituosa ao fabricante em garantia, pela oficina ou
  estabelecimento autorizado. ICMS isento (CST 40, Convênio ICMS 27/07), sem IPI
  (CST 53) e sem PIS/COFINS (CST 08, não há receita). O código de benefício (cBenef)
  é de cada UF e fica para a implantação.
-->
<odoo noupdate="1">
    <record id="comment_remessa_garantia" model="l10n_br_fiscal.comment">
        <field name="name">Remessa em garantia</field>
        <field
            name="comment"
        >Remessa de peça defeituosa ao fabricante em virtude de garantia - isenção do ICMS (Convênio ICMS 27/07).</field>
        <field name="comment_type">fiscal</field>
        <field name="object">l10n_br_fiscal.document.mixin</field>
    </record>
    <record id="fo_remessa_garantia" model="l10n_br_fiscal.operation">
        <field name="code">REM-GAR</field>
        <field name="name">Remessa de peça defeituosa em garantia</field>
        <field name="fiscal_operation_type">out</field>
        <field name="fiscal_type">other</field>
        <field name="state">approved</field>
        <field name="comment_ids" eval="[(6, 0, [ref('comment_remessa_garantia')])]" />
    </record>
    <record id="fo_remessa_garantia_line" model="l10n_br_fiscal.operation.line">
        <field name="fiscal_operation_id" ref="fo_remessa_garantia" />
        <field name="name">Remessa em garantia</field>
        <field name="cfop_internal_id" ref="l10n_br_fiscal.cfop_5949" />
        <field name="cfop_external_id" ref="l10n_br_fiscal.cfop_6949" />
        <field name="cfop_export_id" ref="l10n_br_fiscal.cfop_7949" />
        <field name="tax_icms_or_issqn">icms</field>
        <field name="state">approved</field>
    </record>
    <record id="fo_rem_garantia_icms" model="l10n_br_fiscal.tax.definition">
        <field name="fiscal_operation_line_id" ref="fo_remessa_garantia_line" />
        <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_icms" />
        <field name="is_taxed" eval="False" />
        <field name="is_debit_credit" eval="True" />
        <field name="custom_tax" eval="True" />
        <field name="tax_id" ref="l10n_br_fiscal.tax_icms_isento" />
        <field name="cst_id" ref="l10n_br_fiscal.cst_icms_40" />
        <field name="state">approved</field>
    </record>
    <record id="fo_rem_garantia_ipi" model="l10n_br_fiscal.tax.definition">
        <field name="fiscal_operation_line_id" ref="fo_remessa_garantia_line" />
        <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_ipi" />
        <field name="is_taxed" eval="False" />
        <field name="is_debit_credit" eval="True" />
        <field name="custom_tax" eval="True" />
        <field name="tax_id" ref="l10n_br_fiscal.tax_ipi_nt" />
        <field name="cst_id" ref="l10n_br_fiscal.cst_ipi_53" />
        <field name="state">approved</field>
    </record>
    <record id="fo_rem_garantia_pis" model="l10n_br_fiscal.tax.definition">
        <field name="fiscal_operation_line_id" ref="fo_remessa_garantia_line" />
        <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_pis" />
        <field name="is_taxed" eval="False" />
        <field name="is_debit_credit" eval="True" />
        <field name="custom_tax" eval="True" />
        <field name="tax_id" ref="l10n_br_fiscal.tax_pis_seminc" />
        <field name="cst_id" ref="l10n_br_fiscal.cst_pis_08" />
        <field name="state">approved</field>
    </record>
    <record id="fo_rem_garantia_cofins" model="l10n_br_fiscal.tax.definition">
        <field name="fiscal_operation_line_id" ref="fo_remessa_garantia_line" />
        <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_cofins" />
        <field name="is_taxed" eval="False" />
        <field name="is_debit_credit" eval="True" />
        <field name="custom_tax" eval="True" />
        <field name="tax_id" ref="l10n_br_fiscal.tax_cofins_seminc" />
        <field name="cst_id" ref="l10n_br_fiscal.cst_cofins_08" />
        <field name="state">approved</field>
    </record>
    <!-- Simples Nacional: linha irmã para empresa com company_tax_framework=1 -->
    <record id="fo_remessa_garantia_line_sn" model="l10n_br_fiscal.operation.line">
        <field name="fiscal_operation_id" ref="fo_remessa_garantia" />
        <field name="name">Remessa em garantia - Simples Nacional</field>
        <field name="company_tax_framework">1</field>
        <field name="cfop_internal_id" ref="l10n_br_fiscal.cfop_5949" />
        <field name="cfop_external_id" ref="l10n_br_fiscal.cfop_6949" />
        <field name="cfop_export_id" ref="l10n_br_fiscal.cfop_7949" />
        <field name="tax_icms_or_issqn">icms</field>
        <field name="state">approved</field>
    </record>
    <record
        id="fo_remessa_garantia_line_sn_icmssn"
        model="l10n_br_fiscal.tax.definition"
    >
        <field name="fiscal_operation_line_id" ref="fo_remessa_garantia_line_sn" />
        <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_icmssn" />
        <field name="is_taxed" eval="False" />
        <field name="is_debit_credit" eval="True" />
        <field name="custom_tax" eval="True" />
        <field name="tax_id" ref="l10n_br_fiscal.tax_icms_sn_nt" />
        <field name="cst_id" ref="l10n_br_fiscal.cst_icmssn_400" />
        <field name="state">approved</field>
    </record>
    <record id="fo_rem_garantia_ipi_sn" model="l10n_br_fiscal.tax.definition">
        <field name="fiscal_operation_line_id" ref="fo_remessa_garantia_line_sn" />
        <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_ipi" />
        <field name="is_taxed" eval="False" />
        <field name="is_debit_credit" eval="True" />
        <field name="custom_tax" eval="True" />
        <field name="tax_id" ref="l10n_br_fiscal.tax_ipi_nt" />
        <field name="cst_id" ref="l10n_br_fiscal.cst_ipi_53" />
        <field name="state">approved</field>
    </record>
    <record id="fo_rem_garantia_pis_sn" model="l10n_br_fiscal.tax.definition">
        <field name="fiscal_operation_line_id" ref="fo_remessa_garantia_line_sn" />
        <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_pis" />
        <field name="is_taxed" eval="False" />
        <field name="is_debit_credit" eval="True" />
        <field name="custom_tax" eval="True" />
        <field name="tax_id" ref="l10n_br_fiscal.tax_pis_seminc" />
        <field name="cst_id" ref="l10n_br_fiscal.cst_pis_08" />
        <field name="state">approved</field>
    </record>
    <record id="fo_rem_garantia_cofins_sn" model="l10n_br_fiscal.tax.definition">
        <field name="fiscal_operation_line_id" ref="fo_remessa_garantia_line_sn" />
        <field name="tax_group_id" ref="l10n_br_fiscal.tax_group_cofins" />
        <field name="is_taxed" eval="False" />
        <field name="is_debit_credit" eval="True" />
        <field name="custom_tax" eval="True" />
        <field name="tax_id" ref="l10n_br_fiscal.tax_cofins_seminc" />
        <field name="cst_id" ref="l10n_br_fiscal.cst_cofins_08" />
        <field name="state">approved</field>
    </record>
</odoo>
