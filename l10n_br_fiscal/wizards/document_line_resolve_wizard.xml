<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="document_line_resolve_wizard_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.document.line.resolve.wizard.form</field>
        <field name="model">l10n_br_fiscal.document.line.resolve.wizard</field>
        <field name="arch" type="xml">
            <form string="Resolve Imported Line">
                <field name="line_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="fiscal_operation_suggested" invisible="1" />
                <group>
                    <field name="mode" widget="radio" options="{'horizontal': True}" />
                </group>
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': [('price_warning', '=', False)]}"
                >
                    <field name="price_warning" readonly="1" nolabel="1" />
                </div>
                <div
                    class="alert alert-info"
                    role="alert"
                    attrs="{'invisible': [('cfop_warning', '=', False)]}"
                >
                    <field name="cfop_warning" readonly="1" nolabel="1" />
                </div>
                <group>
                    <group string="Declared By The Counterparty (from the file)">
                        <field name="partner_name" />
                        <field name="partner_product_code" string="Code" />
                        <field name="partner_uom_code" string="Unit" />
                        <field name="partner_quantity" string="Quantity" />
                        <field name="partner_price_unit" string="Unit Price" />
                        <field name="partner_ncm_code" string="NCM" />
                        <field name="partner_cfop_id" string="CFOP" />
                    </group>
                    <group string="Internal Mapping (review and confirm)">
                        <field
                            name="product_id"
                            attrs="{'invisible': [('mode', '=', 'create')], 'required': [('mode', '=', 'link')]}"
                            options="{'no_create_edit': True}"
                        />
                        <field
                            name="import_uom_id"
                            string="Internal UoM"
                            options="{'no_create': True, 'no_open': True}"
                            attrs="{'required': [('mode', '=', 'create')]}"
                        />
                        <field
                            name="import_uom_factor"
                            string="Factor (supplier -&gt; internal)"
                        />
                        <field
                            name="fiscal_operation_id"
                            string="Inbound Fiscal Operation"
                            options="{'no_create': True}"
                        />
                        <div
                            colspan="2"
                            class="text-muted"
                            attrs="{'invisible': [('fiscal_operation_suggested', '=', False)]}"
                        >
                            Operation suggested by the inverse CFOP. Adjust it if needed.
                        </div>
                    </group>
                </group>
                <group string="Conversion Preview">
                    <group>
                        <field
                            name="internal_quantity"
                            string="Internal Quantity"
                            readonly="1"
                        />
                        <field
                            name="internal_price_unit"
                            string="Internal Unit Price"
                            readonly="1"
                        />
                    </group>
                    <group>
                        <field
                            name="total_check"
                            string="Total (preserved)"
                            readonly="1"
                        />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_resolve"
                        type="object"
                        string="Resolve"
                        class="btn-primary"
                    />
                    <button
                        name="action_resolve_next"
                        type="object"
                        string="Resolve And Next Pending"
                        class="btn-secondary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
