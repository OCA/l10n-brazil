<odoo>

    <record id="view_l10n_br_fiscal_document_line_import_wizard" model="ir.ui.view">
        <field name="name">l10n.br.fiscal.document.line.import.wizard.form</field>
        <field name="model">l10n_br_fiscal.document.line.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Fiscal Document Line">
                <sheet>
                    <group name="xml_doc">
                        <field name="document_line_id" />
                        <group>
                            <field name="document_code" readonly="1" force_save="1" />
                        </group>
                        <group>
                            <field name="document_ean" readonly="1" force_save="1" />
                        </group>
                        <group cols="4" colspan="4">
                            <field name="document_name" readonly="1" force_save="1" />
                        </group>
                        <group>
                            <field name="document_qty" readonly="1" force_save="1" />
                            <field name="document_uom" readonly="1" force_save="1" />
                        </group>
                        <group>
                            <field name="document_ncm_id" readonly="1" force_save="1" />
                            <field
                                name="document_cfop_id"
                                readonly="1"
                                force_save="1"
                            />
                        </group>
                    </group>
                    <group name="fiscal_document">
                        <group name="product" string="Product">
                            <field
                                name="import_ncm_id"
                                required="1"
                                attrs="{'readonly': [('import_product_id', '!=', False)]}"
                            />
                            <field
                                name="import_product_fiscal_type"
                                required="1"
                                attrs="{'readonly': [('import_product_id', '!=', False)]}"
                            />

                            <div
                                class="alert alert-warning mt8"
                                role="alert"
                                colspan="4"
                                attrs="{'invisible': [('import_product_id', '!=', False)]}"
                            >
                                <p>
                                    <i class="fa fa-info-circle" title="Info" />
                                    <strong
                                    > Please select an existing product or create a new one</strong>
                                </p>
                            </div>

                            <label
                                for="import_product_id"
                                string="Select Existing Product"
                                colspan="1"
                            />
                            <div class="d-flex align-items-center" colspan="1">
                                <field
                                    name="import_product_id"
                                    placeholder="Search or select a product..."
                                    nolabel="1"
                                />
                            </div>

                            <label
                                for="action_create_product"
                                string="Or"
                                colspan="1"
                                attrs="{'invisible': [('import_product_id', '!=', False)]}"
                            />
                            <div
                                colspan="1"
                                attrs="{'invisible': [('import_product_id', '!=', False)]}"
                            >
                                <button
                                    name="action_create_product"
                                    string="Create New Product"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-plus"
                                />
                            </div>
                            <label
                                for="action_create_product"
                                string="Or"
                                colspan="1"
                                attrs="{'invisible': [('import_product_id', '=', False)]}"
                            />
                            <div
                                colspan="1"
                                attrs="{'invisible': [('import_product_id', '=', False)]}"
                            >
                                <button
                                    name="action_create_product"
                                    string="Create New Product"
                                    type="object"
                                    confirm="Warning: This will remove the currently linked product!"
                                    class="btn-primary"
                                    icon="fa-plus"
                                />
                            </div>
                        </group>

                        <group name="line" string="Document Line">
                            <field name="product_supplierinfo_id" invisible="1" />
                            <div
                                name="uom_factor_info"
                                class="text-muted"
                                colspan="2"
                                attrs="{'invisible': [('product_supplierinfo_id', '=', False)]}"
                            >
                                <p>
                                    <i class="fa fa-info" />
                                    <em> Using automatic UoM factor from product
                                        supplier information.</em>
                                </p>
                            </div>
                            <field
                                name="import_qty"
                                required="1"
                                force_save="1"
                                attrs="{'readonly': [('product_supplierinfo_id', '!=', False)]}"
                            />
                            <field
                                name="import_uom_id"
                                required="1"
                                force_save="1"
                                attrs="{'readonly': [('import_product_id', '!=', False)]}"
                            />
                            <field name="import_cfop_id" required="1" />
                        </group>

                        <group>

                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_previous_product"
                        type="object"
                        string="Confirm and Previous"
                        class="btn-warning"
                        icon="fa-arrow-left"
                    />
                    <button
                        name="action_done"
                        type="object"
                        string="Confirm and Close"
                        class="btn-primary"
                        icon="fa-check"
                    />
                    <button
                        name="action_next_product"
                        type="object"
                        string="Confirm and Next"
                        class="btn-success"
                        icon="fa-arrow-right"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-danger"
                        icon="fa-times"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="l10n_br_fiscal_document_line_import_wizard_act_window"
    >
        <field name="name">Document Line Import Wizard</field> <!-- TODO -->
        <field name="res_model">l10n_br_fiscal.document.line.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

</odoo>
