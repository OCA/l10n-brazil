<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_l10n_br_dere" model="ir.module.category">
        <field name="name">DeRE</field>
        <field name="description">Brazilian specific-regime declaration (DeRE)</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">DeRE User</field>
        <field name="category_id" ref="l10n_br_dere.module_category_l10n_br_dere" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('account.group_account_user'))]"
        />
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">DeRE Manager</field>
        <field name="category_id" ref="l10n_br_dere.module_category_l10n_br_dere" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('l10n_br_dere.group_user'))]"
        />
    </record>
    <record id="base.user_admin" model="res.users">
        <field
            name="groups_id"
            eval="[Command.link(ref('l10n_br_dere.group_manager'))]"
        />
    </record>
    <record id="declaration_company_rule" model="ir.rule">
        <field name="name">DeRE declaration multi-company</field>
        <field name="model_id" ref="model_l10n_br_dere_declaration" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="event_company_rule" model="ir.rule">
        <field name="name">DeRE event multi-company</field>
        <field name="model_id" ref="model_l10n_br_dere_event" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="batch_company_rule" model="ir.rule">
        <field name="name">DeRE batch multi-company</field>
        <field name="model_id" ref="model_l10n_br_dere_batch" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="pgcc_company_rule" model="ir.rule">
        <field name="name">DeRE PGCC multi-company</field>
        <field name="model_id" ref="model_l10n_br_dere_pgcc_account" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="trial_company_rule" model="ir.rule">
        <field name="name">DeRE trial line multi-company</field>
        <field name="model_id" ref="model_l10n_br_dere_trial_line" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
