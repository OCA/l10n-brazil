<odoo>
    <record id="view_dere_tax_code_tree" model="ir.ui.view">
        <field name="name">l10n_br_dere.tax.code.list</field>
        <field name="model">l10n_br_dere.tax.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="description" optional="hide" />
                <field name="legal_ref" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="view_dere_tax_code_form" model="ir.ui.view">
        <field name="name">l10n_br_dere.tax.code.form</field>
        <field name="model">l10n_br_dere.tax.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="description" />
                        <field name="legal_ref" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dere_tax_code" model="ir.actions.act_window">
        <field name="name">DeRE Taxation Codes</field>
        <field name="res_model">l10n_br_dere.tax.code</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
