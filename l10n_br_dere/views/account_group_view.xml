<odoo>
    <record id="view_account_group_form" model="ir.ui.view">
        <field name="name">account.group.form.l10n.br.dere</field>
        <field name="model">account.group</field>
        <field name="inherit_id" ref="account.view_account_group_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page name="dere" string="DeRE" groups="l10n_br_dere.group_user">
                        <group>
                            <group>
                                <field name="l10n_br_dere_cta_interna" />
                                <field name="l10n_br_dere_dbr_mista" />
                                <field name="l10n_br_dere_cta" />
                                <field name="l10n_br_dere_cta_sup" />
                                <field name="l10n_br_dere_nivel_cta" />
                            </group>
                            <group>
                                <field name="l10n_br_dere_cta_ref" />
                                <field name="l10n_br_dere_nat_cta" />
                                <field name="l10n_br_dere_cod_nat" />
                                <field name="l10n_br_dere_desc_cta" />
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="view_account_group_list" model="ir.ui.view">
        <field name="name">account.group.list.l10n.br.dere</field>
        <field name="model">account.group</field>
        <field name="inherit_id" ref="account.view_account_group_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="l10n_br_dere_cta_ref" optional="hide" />
                <field name="l10n_br_dere_cod_nat" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
