<odoo>
    <record id="view_dere_activity_tree" model="ir.ui.view">
        <field name="name">l10n_br_dere.activity.list</field>
        <field name="model">l10n_br_dere.activity</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="table_code" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="view_dere_activity_form" model="ir.ui.view">
        <field name="name">l10n_br_dere.activity.form</field>
        <field name="model">l10n_br_dere.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="table_code" />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dere_activity" model="ir.actions.act_window">
        <field name="name">DeRE Activities</field>
        <field name="res_model">l10n_br_dere.activity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
