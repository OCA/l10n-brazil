<odoo>
    <record id="view_dere_batch_form" model="ir.ui.view">
        <field name="name">l10n_br_dere.batch.form</field>
        <field name="model">l10n_br_dere.batch</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button
                        name="action_consult"
                        type="object"
                        string="Consult"
                        class="btn-primary"
                        invisible="state != 'sent' or not protocol"
                    />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="protocol" readonly="1" />
                            <field name="tp_amb" readonly="1" />
                            <field name="declaration_id" readonly="1" />
                            <field name="table_period_id" readonly="1" />
                        </group>
                        <group>
                            <field name="next_consult_at" readonly="1" />
                            <field name="consult_attempts" readonly="1" />
                        </group>
                    </group>
                    <field name="event_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="event_type" />
                            <field name="state" />
                            <field name="nr_recibo" />
                        </list>
                    </field>
                    <notebook>
                        <page string="XML" name="xml">
                            <field
                                name="xml_pretty"
                                string="XML"
                                widget="ace"
                                options="{'mode': 'xml'}"
                                readonly="1"
                            />
                        </page>
                        <page string="Response" name="response">
                            <field
                                name="response_pretty"
                                string="Response"
                                widget="ace"
                                options="{'mode': 'xml'}"
                                readonly="1"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
