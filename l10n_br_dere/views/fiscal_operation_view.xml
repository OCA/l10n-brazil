<odoo>
    <record id="view_fiscal_operation_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.operation.form.l10n.br.dere</field>
        <field name="model">l10n_br_fiscal.operation</field>
        <field name="inherit_id" ref="l10n_br_fiscal.operation_form" />
        <field name="arch" type="xml">
            <xpath expr="//group/group[2]" position="inside">
                <field
                    name="l10n_br_dere_deductible"
                    groups="l10n_br_dere.group_user"
                />
                <field
                    name="l10n_br_dere_tp_ativ"
                    invisible="not l10n_br_dere_deductible"
                    groups="l10n_br_dere.group_user"
                />
            </xpath>
        </field>
    </record>
</odoo>
