<odoo>
    <record id="view_dere_event_tree" model="ir.ui.view">
        <field name="name">l10n_br_dere.event.list</field>
        <field name="model">l10n_br_dere.event</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="event_type" />
                <field name="declaration_id" />
                <field name="state" />
                <field name="event_id_attr" />
                <field name="protocol" />
                <field name="nr_recibo" />
                <field name="cd_retorno" />
            </list>
        </field>
    </record>
    <record id="view_dere_event_form" model="ir.ui.view">
        <field name="name">l10n_br_dere.event.form</field>
        <field name="model">l10n_br_dere.event</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="declaration_id" readonly="state != 'draft'" />
                            <field name="event_type" readonly="state != 'draft'" />
                            <field name="tp_oper" readonly="state != 'draft'" />
                            <field name="tp_amb" readonly="state != 'draft'" />
                            <field name="ver_aplic" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="event_id_attr" readonly="1" />
                            <field name="protocol" readonly="1" />
                            <field name="nr_recibo" readonly="1" />
                            <field name="cd_retorno" readonly="1" />
                            <field name="desc_retorno" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="XML" name="xml">
                            <field
                                name="xml_content"
                                widget="text"
                                readonly="state != 'draft'"
                            />
                            <field name="xml_hash" readonly="1" />
                        </page>
                        <page string="Occurrences" name="occurrences">
                            <field name="occurrence_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="codigo" />
                                    <field name="tipo" />
                                    <field name="descricao" />
                                    <field name="localizacao" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="action_dere_event" model="ir.actions.act_window">
        <field name="name">DeRE Events</field>
        <field name="res_model">l10n_br_dere.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
