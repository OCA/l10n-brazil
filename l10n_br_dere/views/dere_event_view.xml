<odoo>
    <record id="view_dere_event_tree" model="ir.ui.view">
        <field name="name">l10n_br_dere.event.list</field>
        <field name="model">l10n_br_dere.event</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="event_type" />
                <field name="tp_oper" optional="show" />
                <field name="declaration_id" />
                <field name="table_period_id" optional="hide" />
                <field name="state" />
                <field name="event_id_attr" />
                <field name="protocol" />
                <field name="nr_recibo" />
                <field name="cd_retorno" />
                <field name="seq_evento" optional="hide" />
                <field name="dh_process" optional="hide" />
            </list>
        </field>
    </record>
    <record id="view_dere_event_form" model="ir.ui.view">
        <field name="name">l10n_br_dere.event.form</field>
        <field name="model">l10n_br_dere.event</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="declaration_id" readonly="state != 'draft'" />
                            <field name="table_period_id" readonly="state != 'draft'" />
                            <field name="event_type" readonly="state != 'draft'" />
                            <field name="tp_oper" readonly="state != 'draft'" />
                            <field name="mot_excl" readonly="state != 'draft'" />
                            <field name="tp_amb" readonly="state != 'draft'" />
                            <field name="ver_aplic" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="event_id_attr" readonly="1" />
                            <field name="protocol" readonly="1" />
                            <field name="nr_recibo" readonly="1" />
                            <field name="cd_retorno" readonly="1" />
                            <field name="desc_retorno" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="XML" name="xml">
                            <field
                                name="xml_content"
                                widget="text"
                                readonly="state != 'draft'"
                            />
                            <field name="xml_hash" readonly="1" />
                        </page>
                        <page
                            string="Return"
                            name="return"
                            invisible="not return_type and not return_xml"
                        >
                            <group>
                                <group>
                                    <field name="return_type" readonly="1" />
                                    <field name="seq_evento" readonly="1" />
                                    <field name="nr_recibo_pgcc" readonly="1" />
                                </group>
                                <group>
                                    <field name="dh_recepcao" readonly="1" />
                                    <field name="dh_process" readonly="1" />
                                </group>
                            </group>
                            <field
                                name="total_ids"
                                readonly="1"
                                invisible="not total_ids"
                            >
                                <list create="0" delete="0">
                                    <field name="dere12_codTrib" />
                                    <field name="dere12_indTribISS" />
                                    <field
                                        name="brl_currency_id"
                                        column_invisible="1"
                                    />
                                    <field name="dere12_vApurTot" />
                                    <field name="local_v_apur" />
                                    <field name="difference" />
                                </list>
                            </field>
                            <field name="return_xml" widget="text" readonly="1" />
                        </page>
                        <page string="Occurrences" name="occurrences">
                            <field name="occurrence_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="codigo" />
                                    <field name="tipo" />
                                    <field name="descricao" />
                                    <field name="localizacao" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="action_dere_event" model="ir.actions.act_window">
        <field name="name">DeRE Events</field>
        <field name="res_model">l10n_br_dere.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
