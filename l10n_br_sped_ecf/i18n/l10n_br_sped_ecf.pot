msgstr ""

#. module: l10n_br_sped_ecf
#: model:ir.model.fields,field_description:l10n_br_sped_ecf.field_l10n_br_sped_ecf_9_y640__VL_CONS
#: model:ir.model.fields,field_description:l10n_br_sped_ecf.field_l10n_br_sped_ecf_y640__VL_CONS
msgid "Receita do Consórcio"
msgstr ""

#. module: l10n_br_sped_ecf
#: model:ir.model.fields,help:l10n_br_sped_ecf.field_l10n_br_sped_ecf_9_y640__VL_CONS
#: model:ir.model.fields,help:l10n_br_sped_ecf.field_l10n_br_sped_ecf_y640__VL_CONS
msgid ""
"Receita do Consórcio: O líder indicará, neste campo, o valor do somatório "
"das receitas auferidas por todos os consorciados no período considerado. "
"Atenção: Este campo não deve ser preenchido para participante que não seja "
"líder. Obrigatório se COND_DECL='1'. Senão, não deve ser preenchido."
msgstr ""

#. module: l10n_br_sped_ecf
#: model:ir.model.fields,field_description:l10n_br_sped_ecf.field_l10n_br_sped_ecf_9_y640__VL_DECL
#: model:ir.model.fields,field_description:l10n_br_sped_ecf.field_l10n_br_sped_ecf_y640__VL_DECL
msgid "Receita do Declarante no Consórcio"
msgstr ""

#. module: l10n_br_sped_ecf
#: model:ir.model.fields,help:l10n_br_sped_ecf.field_l10n_br_sped_ecf_9_y640__VL_DECL
#: model:ir.model.fields,help:l10n_br_sped_ecf.field_l10n_br_sped_ecf_y640__VL_DECL
msgid ""
"Receita do Declarante no Consórcio: Receita auferida pelo declarante no "
"período a que se refere esta declaração, observado o disposto no caput do "
"art. 3o da IN RFB no 1.199, de 2011."
msgstr ""

#. module: l10n_br_sped_ecf
#: model:ir.model.fields,field_description:l10n_br_sped_ecf.field_l10n_br_sped_ecf_9_y650__VL_PART
