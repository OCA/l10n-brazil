#: model:ir.model.fields,field_description:l10n_br_sped_ecf.field_l10n_br_sped_ecf_9_0020__IND_CAP_INF
msgid "Capacitação de Informática e Inclusão Digital"
msgstr ""

#. module: l10n_br_sped_ecf
#: model:ir.model.fields,help:l10n_br_sped_ecf.field_l10n_br_sped_ecf_0020__IND_CAP_INF
#: model:ir.model.fields,help:l10n_br_sped_ecf.field_l10n_br_sped_ecf_9_0020__IND_CAP_INF
msgid ""
"Capacitação de Informática e Inclusão Digital: S – Sim N – Não A pessoa "
"jurídica que tiver investido em atividades de pesquisa e desenvolvimento em "
"tecnologia da informação no âmbito dos programas de capacitação e "
"competitividade dos setores de informática e automação e tecnologias da "
"informação de que trata a Lei nº 8.248, de 23 de outubro de 1991, a Lei nº "
"10.176, de 11 de janeiro de 2001, e a Lei nº 11.077, de 30 de dezembro de "
"2004, regulamentadas pelo Decreto nº 5.906, de 26 de setembro de 2006, ou "
"tiver efetuado venda a varejo nos termos dos arts. 28 a 30 da Lei nº 11.196,"
" de 2005, que dispõem sobre o programa de inclusão digital, deve preencher "
"este campo com “Sim”."
msgstr ""

