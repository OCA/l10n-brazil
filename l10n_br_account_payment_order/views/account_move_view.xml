<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_cnab_form" model="ir.ui.view">
        <field name="name">account.move.cnab.view</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button
                    name="view_boleto_pdf"
                    type="object"
                    string="Print Boleto"
                    class="btn-primary"
                    invisible="state != 'posted' or payment_method_code not in ('240', '400', '500')"
                />
            </button>
            <xpath expr="/form/sheet/notebook" position="inside">
                <page string="CNAB Informations" invisible="not is_cnab">
                    <group>
                        <field name="cnab_return_log_id" />
                    </group>
                </page>
            </xpath>
            <field name="payment_mode_id" position="attributes">
                <attribute
                    name="domain"
                >[('payment_type', '=', payment_mode_filter_type_domain), ('company_id', '=', company_id)]</attribute>
            </field>
        </field>
    </record>
</odoo>
