<odoo>
    <record id="nfse_paulistana_direct_print_document_form_inherit" model="ir.ui.view">
        <field name="name">l10n_br_nfse_paulistana_direct_print.document.form.inherit</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <!--
                The base view condition is
                invisible="state_edoc == 'em_digitacao'". We add the Paulistana
                exclusion instead of replacing the whole value, otherwise
                installing this module would change the visibility of the
                "Visualizar PDF" button for NF-e, CT-e, MDF-e and for the NFS-e
                of other providers.
            -->
            <button name="view_pdf" position="attributes">
                <attribute
                    name="invisible"
                >state_edoc == 'em_digitacao' or is_nfse_paulistana</attribute>
            </button>
            <button name="view_pdf" position="after">
                <field name="is_nfse_paulistana" invisible="1" />
                <button
                    name="action_open_nfse_paulistana"
                    string="Visualizar NFS-e Paulistana"
                    type="object"
                    class="btn-primary"
                    icon="fa-file-text"
                    groups="l10n_br_fiscal.group_user"
                    invisible="not is_nfse_paulistana or state_edoc not in ('autorizada', 'cancelada')"
                />
            </button>
        </field>
    </record>
</odoo>
