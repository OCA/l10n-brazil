#. module: l10n_br_account_payment_order_brbank
#. odoo-python
#: code:addons/l10n_br_account_payment_order_brbank/models/account_payment_api_batch.py:0
msgid ""
"No answer from the bank and no identifier to ask for it: check the bank "
"statement before paying this title again."
msgstr ""
"O banco não respondeu e não há identificador para consultar: confira o "
"extrato antes de pagar este título de novo."

#. module: l10n_br_account_payment_order_brbank
#. odoo-python
#: code:addons/l10n_br_account_payment_order_brbank/models/account_payment_api_batch.py:0
msgid ""
"No answer from the bank: the payment may have been made. Odoo keeps asking "
"the bank."
msgstr ""
"O banco não respondeu: o pagamento pode ter sido feito. O Odoo continua "
"consultando o banco."

#. module: l10n_br_account_payment_order_brbank
#: model_terms:ir.ui.view,arch_db:l10n_br_account_payment_order_brbank.account_payment_order_form
msgid ""
"No money leaves on send: the bank only validates the payments, and they are "
"paid when you use Authorize at the Bank. Send these payments?"
msgstr ""
"Nenhum dinheiro sai no envio: o banco só valida os pagamentos, que são pagos"
" quando você usar Autorizar no banco. Enviar estes pagamentos?"

#. module: l10n_br_account_payment_order_brbank
#: model_terms:ir.ui.view,arch_db:l10n_br_account_payment_order_brbank.account_payment_order_form
msgid ""
"No money leaves on send: the payments wait for an approver in the bank "
"channel (app or internet banking). Send these payments?"
msgstr ""
"Nenhum dinheiro sai no envio: os pagamentos esperam um aprovador no canal do"
" banco (aplicativo ou internet banking). Enviar estes pagamentos?"

#. module: l10n_br_account_payment_order_brbank
#. odoo-python
#: code:addons/l10n_br_account_payment_order_brbank/models/account_payment_api_batch.py:0
msgid ""
"Not sent, because the bank did not answer an earlier payment. It can go in a"
" new payment order."
msgstr ""
"Não enviado, porque o banco não respondeu a um pagamento anterior. Pode "
"entrar em uma nova ordem de pagamento."

#. module: l10n_br_account_payment_order_brbank
#. odoo-python
#: code:addons/l10n_br_account_payment_order_brbank/models/account_payment_order.py:0
