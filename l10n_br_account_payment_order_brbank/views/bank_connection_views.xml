<odoo>
    <record id="bank_connection_form" model="ir.ui.view">
        <field name="model">l10n_br_bank_connection.connection</field>
        <field name="inherit_id" ref="l10n_br_bank_connection.bank_connection_form" />
        <field name="arch" type="xml">
            <page name="settings" position="after">
                <page
                    string="Payment Settings"
                    name="brbank_payment"
                    groups="base.group_system"
                    invisible="not brbank_payment_settings_help"
                >
                    <group>
                        <field name="brbank_payment_settings_help" />
                        <field
                            name="brbank_payment_settings"
                            widget="code"
                            options="{'mode': 'python'}"
                        />
                        <field
                            name="brbank_payment_secrets"
                            widget="code"
                            options="{'mode': 'python'}"
                        />
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
