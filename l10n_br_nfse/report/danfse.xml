<?xml version="1.0" ?>
<odoo>
    <record id="paperformat_br_nfse_danfse" model="report.paperformat">
        <field name="name">Danfe NFS-e</field>
        <field name="default" eval="True" />
        <field name="orientation">Portrait</field>
        <field name="margin_top">7</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">3</field>
    </record>

    <record id="report_br_nfse_danfe" model="ir.actions.report">
        <field name="name">Nota de Serviço</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_br_nfse.main_template_br_nfse_danfe</field>
        <field name="report_file">l10n_br_nfse.main_template_br_nfse_danfe</field>
        <field name="paperformat_id" ref="paperformat_br_nfse_danfse" />
        <field
            name="print_report_name"
        >'%s - %s' % (object.document_number and 'NFS-e %s' % object.document_number or 'RPS %s' % object.rps_number, object.partner_id.name)</field>
    </record>

    <template id="danfse_report_template">
        <t t-set="lines" t-value="doc.fiscal_line_ids" />
        <t t-set="line" t-value="lines[:1]" />
        <t t-set="is_nfse" t-value="bool(doc.document_number)" />
        <t t-set="company" t-value="doc.company_id" />
        <t t-set="partner" t-value="doc.partner_id" />
        <t
            t-set="money"
            t-value="{'widget': 'monetary', 'display_currency': doc.currency_id}"
        />
        <t
            t-set="federal_wh"
            t-value="doc.amount_pis_wh_value + doc.amount_cofins_wh_value + doc.amount_csll_wh_value + doc.amount_irpj_wh_value + doc.amount_inss_wh_value"
        />
        <div class="page nfse">
            <style type="text/css">
.nfse {
    font-size: 11px;
    line-height: 1.25;
    color: #000;
}
.nfse table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
}
.nfse td {
    border: 1px solid #000;
    padding: 2px 4px;
    vertical-align: top;
    word-wrap: break-word;
}
.nfse tr {
    page-break-inside: avoid;
}
.nfse .nfse-lb {
    display: block;
    font-size: 7.5px;
    text-transform: uppercase;
    color: #333;
}
.nfse .nfse-vl {
    display: block;
    min-height: 14px;
}
.nfse .nfse-sec td {
    padding: 2px 4px;
    font-size: 10px;
    font-weight: bold;
    text-align: center;
    text-transform: uppercase;
    background-color: #e4e4e4;
}
.nfse .nfse-tit {
    font-size: 15px;
    font-weight: bold;
}
.nfse .nfse-num {
    font-size: 18px;
    font-weight: bold;
}
.nfse .nfse-aviso td {
    font-size: 11px;
    font-weight: bold;
    text-align: center;
}
.nfse .nfse-rt {
    font-size: 9px;
    font-weight: bold;
    vertical-align: middle;
}
.nfse .nfse-vr {
    text-align: right;
    white-space: nowrap;
    vertical-align: middle;
}
.nfse .nfse-tot {
    font-weight: bold;
    background-color: #f0f0f0;
}
.nfse .nfse-c {
    text-align: center;
}
.nfse .nfse-m {
    vertical-align: middle;
}
.nfse .nfse-disc {
    height: 150px;
    padding: 6px 8px;
}
.nfse .nfse-disc .nfse-txt {
    white-space: pre-line;
}
.nfse .nfse-sm {
    font-size: 9px;
}
            </style>

            <table>
                <colgroup>
                    <t t-foreach="range(24)" t-as="i">
                        <col style="width: 4.1666%;" />
                    </t>
                </colgroup>

                <!-- Cabeçalho -->
                <tr>
                    <td colspan="4" class="nfse-c nfse-m">
                        <img
                            t-if="company.nfse_city_logo"
                            t-att-src="image_data_uri(company.nfse_city_logo)"
                            style="max-height: 62px; max-width: 100%;"
                        />
                    </td>
                    <td colspan="14" class="nfse-c nfse-m">
                        <div style="font-size: 13px;">
                            Prefeitura do Município de <span
                            t-field="company.city_id"
                        />
                        </div>
                        <div>Secretaria Municipal da Fazenda</div>
                        <div class="nfse-tit">
                            <t t-if="is_nfse">
                                NOTA FISCAL DE SERVIÇOS ELETRÔNICA - NFS-e
                            </t>
                            <t t-else="">
                                RECIBO PROVISÓRIO DE SERVIÇOS - RPS
                            </t>
                        </div>
                    </td>
                    <td colspan="6" class="nfse-c nfse-m">
                        <t t-if="is_nfse">
                            <span class="nfse-lb">Número da NFS-e</span>
                            <span class="nfse-num" t-field="doc.document_number" />
                        </t>
                        <t t-else="">
                            <span class="nfse-lb">Número do RPS</span>
                            <span class="nfse-num" t-field="doc.rps_number" />
                        </t>
                    </td>
                </tr>
                <tr t-if="doc.state_edoc == 'cancelada'" class="nfse-aviso">
                    <td colspan="24">NFS-e CANCELADA</td>
                </tr>
                <tr t-elif="not is_nfse" class="nfse-aviso">
                    <td colspan="24">
                        Este RPS ainda não foi convertido em NFS-e
                    </td>
                </tr>
                <tr t-if="doc.nfse_environment == '2'" class="nfse-aviso">
                    <td colspan="24">
                        EMITIDO EM AMBIENTE DE HOMOLOGAÇÃO - SEM VALOR FISCAL
                    </td>
                </tr>
                <tr>
                    <td colspan="5">
                        <span class="nfse-lb">Data e hora da emissão</span>
                        <span class="nfse-vl" t-field="doc.document_date" />
                    </td>
                    <td colspan="3">
                        <span class="nfse-lb">Competência</span>
                        <span
                            class="nfse-vl"
                            t-field="doc.document_date"
                            t-options='{"format": "MM/yyyy"}'
                        />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">Número / série do RPS</span>
                        <span class="nfse-vl">
                            <t t-out="doc.rps_number" />
                            <t t-if="doc.document_serie">
                                / <t t-out="doc.document_serie" />
                            </t>
                        </span>
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">Código de verificação</span>
                        <span class="nfse-vl" t-field="doc.verify_code" />
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">Local da prestação</span>
                        <span
                            class="nfse-vl"
                            t-out="(line.issqn_fg_city_id or company.city_id).display_name"
                        />
                    </td>
                </tr>

                <!-- Prestador -->
                <tr class="nfse-sec">
                    <td colspan="24">Prestador de serviços</td>
                </tr>
                <tr>
                    <td colspan="4" rowspan="4" class="nfse-c nfse-m">
                        <img
                            t-if="company.logo"
                            t-att-src="image_data_uri(company.logo)"
                            style="max-height: 90px; max-width: 100%;"
                        />
                    </td>
                    <td colspan="12">
                        <span class="nfse-lb">Razão social / nome</span>
                        <span class="nfse-vl" t-field="company.legal_name" />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">CNPJ / CPF</span>
                        <span class="nfse-vl" t-field="company.vat_formatted_cnpj" />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">Inscrição municipal</span>
                        <span class="nfse-vl" t-field="company.l10n_br_im_code" />
                    </td>
                </tr>
                <tr>
                    <td colspan="8">
                        <span class="nfse-lb">Nome fantasia</span>
                        <span class="nfse-vl" t-field="company.name" />
                    </td>
                    <td colspan="8">
                        <span class="nfse-lb">E-mail</span>
                        <span class="nfse-vl" t-field="company.email" />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">Telefone</span>
                        <span class="nfse-vl" t-field="company.phone" />
                    </td>
                </tr>
                <tr>
                    <td colspan="12">
                        <span class="nfse-lb">Endereço</span>
                        <span class="nfse-vl" t-field="company.street" />
                    </td>
                    <td colspan="8">
                        <span class="nfse-lb">Complemento</span>
                        <span class="nfse-vl" t-field="company.street2" />
                    </td>
                </tr>
                <tr>
                    <td colspan="7">
                        <span class="nfse-lb">Bairro</span>
                        <span class="nfse-vl" t-field="company.district" />
                    </td>
                    <td colspan="9">
                        <span class="nfse-lb">Município</span>
                        <span class="nfse-vl" t-field="company.city_id" />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">CEP</span>
                        <span class="nfse-vl" t-field="company.zip" />
                    </td>
                </tr>

                <!-- Tomador -->
                <tr class="nfse-sec">
                    <td colspan="24">Tomador de serviços</td>
                </tr>
                <tr>
                    <td colspan="14">
                        <span class="nfse-lb">Razão social / nome</span>
                        <span
                            class="nfse-vl"
                            t-out="partner.legal_name or partner.name"
                        />
                    </td>
                    <td colspan="5">
                        <span class="nfse-lb">CNPJ / CPF</span>
                        <span class="nfse-vl" t-field="partner.vat_formatted_cnpj" />
                    </td>
                    <td colspan="5">
                        <span class="nfse-lb">Inscrição municipal</span>
                        <span class="nfse-vl" t-field="partner.l10n_br_im_code" />
                    </td>
                </tr>
                <tr>
                    <td colspan="14">
                        <span class="nfse-lb">Endereço</span>
                        <span class="nfse-vl" t-field="partner.street" />
                    </td>
                    <td colspan="10">
                        <span class="nfse-lb">Complemento</span>
                        <span class="nfse-vl" t-field="partner.street2" />
                    </td>
                </tr>
                <tr>
                    <td colspan="5">
                        <span class="nfse-lb">Bairro</span>
                        <span class="nfse-vl" t-field="partner.district" />
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">Município</span>
                        <span class="nfse-vl" t-field="partner.city_id" />
                    </td>
                    <td colspan="3">
                        <span class="nfse-lb">CEP</span>
                        <span class="nfse-vl" t-field="partner.zip" />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">Telefone</span>
                        <span class="nfse-vl" t-field="partner.phone" />
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">E-mail</span>
                        <span class="nfse-vl" t-field="partner.email" />
                    </td>
                </tr>

                <!-- Serviços -->
                <tr class="nfse-sec">
                    <td colspan="24">Discriminação dos serviços</td>
                </tr>
                <tr>
                    <td colspan="24" class="nfse-disc">
                        <t t-foreach="lines" t-as="l">
                            <div style="margin-bottom: 4px;">
                                <span class="nfse-txt" t-field="l.name" />
                                <t t-if="len(lines) &gt; 1">
                                    <span class="nfse-sm">
                                        (<span t-field="l.quantity" /> x <span
                                        t-field="l.price_unit"
                                        t-options="money"
                                    /> = <span t-field="l.price_gross" />)
                                    </span>
                                </t>
                            </div>
                        </t>
                    </td>
                </tr>
                <tr class="nfse-sec">
                    <td colspan="24">Código do serviço / atividade</td>
                </tr>
                <tr>
                    <td colspan="16">
                        <span
                            class="nfse-lb"
                        >Item da lista de serviços (LC 116/2003)</span>
                        <span class="nfse-vl">
                            <t t-out="line.service_type_id.code" /> - <t
                            t-out="line.service_type_id.name"
                        />
                        </span>
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">Cód. tributação do município</span>
                        <span
                            class="nfse-vl"
                            t-field="line.city_taxation_code_id.code"
                        />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">CNAE</span>
                        <span class="nfse-vl" t-field="line.cnae_id.code" />
                    </td>
                </tr>
                <t t-if="doc.civil_construction_code or doc.civil_construction_art">
                    <tr class="nfse-sec">
                        <td colspan="24">Construção civil</td>
                    </tr>
                    <tr>
                        <td colspan="12">
                            <span class="nfse-lb">Código da obra</span>
                            <span
                                class="nfse-vl"
                                t-field="doc.civil_construction_code"
                            />
                        </td>
                        <td colspan="12">
                            <span class="nfse-lb">Código ART</span>
                            <span
                                class="nfse-vl"
                                t-field="doc.civil_construction_art"
                            />
                        </td>
                    </tr>
                </t>

                <!-- Tributos federais -->
                <tr class="nfse-sec">
                    <td colspan="24">Tributos federais</td>
                </tr>
                <tr>
                    <td colspan="5">
                        <span class="nfse-lb">PIS</span>
                        <span
                            class="nfse-vl"
                            t-out="doc.amount_pis_value or doc.amount_pis_wh_value"
                            t-options="money"
                        />
                    </td>
                    <td colspan="5">
                        <span class="nfse-lb">COFINS</span>
                        <span
                            class="nfse-vl"
                            t-out="doc.amount_cofins_value or doc.amount_cofins_wh_value"
                            t-options="money"
                        />
                    </td>
                    <td colspan="5">
                        <span class="nfse-lb">CSLL</span>
                        <span
                            class="nfse-vl"
                            t-out="doc.amount_csll_value or doc.amount_csll_wh_value"
                            t-options="money"
                        />
                    </td>
                    <td colspan="5">
                        <span class="nfse-lb">IR</span>
                        <span
                            class="nfse-vl"
                            t-out="doc.amount_irpj_value or doc.amount_irpj_wh_value"
                            t-options="money"
                        />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">INSS</span>
                        <span
                            class="nfse-vl"
                            t-out="doc.amount_inss_value or doc.amount_inss_wh_value"
                            t-options="money"
                        />
                    </td>
                </tr>
                <tr>
                    <td colspan="5">
                        <span class="nfse-lb">PIS retido</span>
                        <span class="nfse-vl" t-field="doc.amount_pis_wh_value" />
                    </td>
                    <td colspan="5">
                        <span class="nfse-lb">COFINS retido</span>
                        <span class="nfse-vl" t-field="doc.amount_cofins_wh_value" />
                    </td>
                    <td colspan="5">
                        <span class="nfse-lb">CSLL retido</span>
                        <span class="nfse-vl" t-field="doc.amount_csll_wh_value" />
                    </td>
                    <td colspan="5">
                        <span class="nfse-lb">IR retido</span>
                        <span class="nfse-vl" t-field="doc.amount_irpj_wh_value" />
                    </td>
                    <td colspan="4">
                        <span class="nfse-lb">INSS retido</span>
                        <span class="nfse-vl" t-field="doc.amount_inss_wh_value" />
                    </td>
                </tr>

                <!-- Valores -->
                <tr class="nfse-sec">
                    <td colspan="9">Valor líquido</td>
                    <td colspan="6">Outras informações</td>
                    <td colspan="9">ISS</td>
                </tr>
                <tr>
                    <td colspan="5" class="nfse-rt">Valor dos serviços</td>
                    <td colspan="4" class="nfse-vr">
                        <span t-field="doc.amount_price_gross" />
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">Natureza da operação</span>
                        <span class="nfse-vl" t-if="doc.operation_nature">
                            <t t-out="doc.operation_nature" /> - <span
                            t-field="doc.operation_nature"
                        />
                        </span>
                    </td>
                    <td colspan="5" class="nfse-rt">Valor dos serviços</td>
                    <td colspan="4" class="nfse-vr">
                        <span t-field="doc.amount_price_gross" />
                    </td>
                </tr>
                <tr>
                    <td colspan="5" class="nfse-rt">(-) Desconto incondicionado</td>
                    <td colspan="4" class="nfse-vr">
                        <span t-field="doc.amount_discount_value" />
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">Regime especial de tributação</span>
                        <span class="nfse-vl" t-if="doc.taxation_special_regime">
                            <t t-out="doc.taxation_special_regime" /> - <span
                            t-field="doc.taxation_special_regime"
                        />
                        </span>
                    </td>
                    <td colspan="5" class="nfse-rt">(-) Deduções permitidas em lei</td>
                    <td colspan="4" class="nfse-vr">
                        <span
                            t-out="sum(lines.mapped('fiscal_deductions_value'))"
                            t-options="money"
                        />
                    </td>
                </tr>
                <tr>
                    <td colspan="5" class="nfse-rt">(-) Retenções federais</td>
                    <td colspan="4" class="nfse-vr">
                        <span t-out="federal_wh" t-options="money" />
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">Optante pelo Simples Nacional</span>
                        <span class="nfse-vl">
                            <t t-if="company.tax_framework != '3'">1 - Sim</t>
                            <t t-else="">2 - Não</t>
                        </span>
                    </td>
                    <td colspan="5" class="nfse-rt">(-) Desconto incondicionado</td>
                    <td colspan="4" class="nfse-vr">
                        <span t-field="doc.amount_discount_value" />
                    </td>
                </tr>
                <tr>
                    <td colspan="5" class="nfse-rt">(-) Outras retenções</td>
                    <td colspan="4" class="nfse-vr">
                        <span
                            t-out="sum(lines.mapped('other_retentions_value'))"
                            t-options="money"
                        />
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">Incentivador cultural</span>
                        <span class="nfse-vl">
                            <t t-if="company.cultural_sponsor">1 - Sim</t>
                            <t t-else="">2 - Não</t>
                        </span>
                    </td>
                    <td colspan="5" class="nfse-rt">(=) Base de cálculo</td>
                    <td colspan="4" class="nfse-vr">
                        <span
                            t-out="doc.amount_issqn_base or doc.amount_issqn_wh_base"
                            t-options="money"
                        />
                    </td>
                </tr>
                <tr>
                    <td colspan="5" class="nfse-rt">(-) ISS retido</td>
                    <td colspan="4" class="nfse-vr">
                        <span t-field="doc.amount_issqn_wh_value" />
                    </td>
                    <td colspan="6">
                        <span class="nfse-lb">ISS retido pelo tomador</span>
                        <span class="nfse-vl">
                            <t t-if="doc.amount_issqn_wh_value">1 - Sim</t>
                            <t t-else="">2 - Não</t>
                        </span>
                    </td>
                    <td colspan="5" class="nfse-rt">(x) Alíquota</td>
                    <td colspan="4" class="nfse-vr">
                        <span
                        t-out="line.issqn_percent or line.issqn_wh_percent"
                        t-options='{"widget": "float", "precision": 2}'
                    /> %
                    </td>
                </tr>
                <tr>
                    <td colspan="5" class="nfse-rt nfse-tot">(=) Valor líquido</td>
                    <td colspan="4" class="nfse-vr nfse-tot">
                        <span t-field="doc.amount_financial_total" />
                    </td>
                    <td colspan="6">
                        <span
                            class="nfse-lb"
                        >Valor aproximado dos tributos / fonte</span>
                        <span class="nfse-vl">
                            <span t-field="doc.amount_estimate_tax" /> / IBPT
                        </span>
                    </td>
                    <td colspan="5" class="nfse-rt nfse-tot">(=) Valor do ISS</td>
                    <td colspan="4" class="nfse-vr nfse-tot">
                        <span t-field="doc.amount_issqn_value" />
                    </td>
                </tr>

                <!-- Rodapé -->
                <tr>
                    <td colspan="24" class="nfse-sm">
                        <span class="nfse-lb">Avisos</span>
                        1 - Uma via desta Nota Fiscal será enviada através do e-mail fornecido pelo Tomador dos Serviços.<br
                    />
                        2 - A autenticidade desta Nota Fiscal poderá ser verificada <t
                        t-if="company.nfse_website"
                    >no site <span
                        t-field="company.nfse_website"
                    />, </t>com a utilização do Código de Verificação.
                        <t t-if="company.tax_framework != '3'">
                            <br />
                            3 - Documento emitido por ME ou EPP optante pelo Simples Nacional. Não gera direito a crédito fiscal de ISS e IPI.
                        </t>
                    </td>
                </tr>
                <tr>
                    <td colspan="24" class="nfse-sm">
                        <span class="nfse-lb">Dados adicionais</span>
                        <div
                            t-if="doc.customer_additional_data"
                            t-field="doc.customer_additional_data"
                        />
                        <div
                            t-if="doc.fiscal_additional_data"
                            t-field="doc.fiscal_additional_data"
                        />
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="main_template_br_nfse_danfe">
        <t t-call="web.html_container">
            <div class="article">
                <t t-foreach="docs" t-as="doc">
                    <t
                        t-call="l10n_br_nfse.danfse_report_template"
                        t-lang="doc.company_id.partner_id.lang"
                    />
                </t>
            </div>
        </t>
    </template>
</odoo>
