<odoo>
    <record id="nfse_document_form_inherit" model="ir.ui.view">
        <field name="name">l10n_br_nfse.document.form.inherit</field>
        <field name="model">l10n_br_fiscal.document</field>
        <field name="inherit_id" ref="l10n_br_fiscal.document_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="nfse_replace_supported" invisible="1" />
                <button
                    name="action_nfse_replace"
                    type="object"
                    string="Replace NFS-e"
                    attrs="{'invisible': ['|', ('nfse_replace_supported', '=', False), ('state_edoc', '!=', 'autorizada')]}"
                />
            </xpath>
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-danger"
                    role="alert"
                    attrs="{'invisible': ['|', ('state_edoc', '!=', 'rejeitada'), ('edoc_error_message', '=', False)]}"
                >
                    <strong>Rejection reason:</strong>
                    <field name="edoc_error_message" readonly="1" />
                </div>
            </xpath>
            <field name="status_description" position="after">
                <field name="edoc_error_message" />
            </field>
            <group name="document_numbers" position="before">
                <group
                    name="nfse_operation"
                    attrs="{'invisible': [('document_type', '!=', 'SE')]}"
                >
                    <field name="operation_nature" />
                    <field name="taxation_special_regime" />
                </group>
                <group
                    name="nfse_info"
                    attrs="{'invisible': [('document_type', '!=', 'SE')]}"
                >
                    <field
                        name="verify_code"
                        attrs="{'invisible': [('document_type', '!=', 'SE')]}"
                    />
                    <field name="rps_number" force_save="1" readonly="1" />
                    <field name="rps_type" />
                    <field name="nfse_environment" readonly="1" />
                    <field name="civil_construction_code" />
                    <field name="civil_construction_art" />
                    <field
                        name="nfse_replaced_document_id"
                        attrs="{'invisible': ['|', ('nfse_replace_supported', '=', False), '&amp;', ('state_edoc', '=', 'autorizada'), ('nfse_replaced_document_id', '=', False)], 'readonly': [('state_edoc', 'not in', ('em_digitacao', 'a_enviar', 'rejeitada'))]}"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
