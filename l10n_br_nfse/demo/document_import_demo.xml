<odoo noupdate="1">

    <!-- The service that the NFS-e of a provider is matched to, in the company of
         the demo (Empresa Lucro Presumido) -->
    <record id="l10n_br_base.empresa_lucro_presumido" model="res.company">
        <field
            name="nfse_import_product_id"
            ref="l10n_br_fiscal.customized_development_sale"
        />
    </record>

    <!-- NFS-e received from a provider, with PIS, COFINS, IRRF and CSLL withheld.
         Access key 42024042259594315000157000000000000126031234567890. It stays
         in the review. -->
    <!-- NFS-e issued by the company in another system, with the access key
         42024042281583054000129000000000090226031234567896: it is imported and
         confirmed as authorized, which sends nothing. -->
    <function model="l10n_br_fiscal.document" name="_edi_import_demo_files">
        <value>l10n_br_nfse</value>
        <value
            eval="[
                'demo/import/nfse_servico_tomado_retencoes.xml',
                'demo/import/nfse_servico_prestado.xml',
            ]"
        />
    </function>
    <function model="l10n_br_fiscal.document.line" name="action_resolve_line">
        <value
            model="l10n_br_fiscal.document.line"
            search="[('document_id.document_key', '=', '42024042281583054000129000000000090226031234567896')]"
        />
    </function>
    <function model="l10n_br_fiscal.document" name="action_document_confirm">
        <value
            model="l10n_br_fiscal.document"
            search="[('document_key', '=', '42024042281583054000129000000000090226031234567896')]"
        />
    </function>

</odoo>
