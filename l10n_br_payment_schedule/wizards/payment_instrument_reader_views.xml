<odoo>
    <record id="payment_instrument_reader_form" model="ir.ui.view">
        <field name="model">l10n_br_payment_schedule.instrument.reader</field>
        <field name="arch" type="xml">
            <form string="Read Boleto or Pix">
                <group>
                    <field name="move_line_id" />
                    <field name="partner_id" />
                    <field
                        name="text"
                        placeholder="Barcode, digitable line or Pix copy and paste"
                    />
                </group>
                <div class="alert alert-danger" role="alert" invisible="not error">
                    <field name="error" nolabel="1" />
                </div>
                <div class="alert alert-warning" role="alert" invisible="not message">
                    <field name="message" nolabel="1" />
                </div>
                <group invisible="kind != 'pix'">
                    <field name="pix_key" />
                    <field name="pix_receiver" />
                    <field name="pix_key_id" />
                </group>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                        invisible="not kind"
                    />
                    <button
                        name="action_register_pix_key"
                        type="object"
                        string="Register Pix Key on the Partner"
                        invisible="kind != 'pix' or not pix_key or pix_key_id"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
