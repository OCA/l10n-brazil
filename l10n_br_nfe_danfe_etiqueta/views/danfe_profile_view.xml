<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="danfe_profile_form" model="ir.ui.view">
        <field name="name">l10n_br_nfe.danfe.profile.form.etiqueta</field>
        <field name="model">l10n_br_nfe.danfe.profile</field>
        <field name="inherit_id" ref="l10n_br_nfe.danfe_profile_form" />
        <field name="arch" type="xml">
            <group name="footer_stamp" position="after">
                <group name="etiqueta" string="Simplified DANFE - Label">
                    <field name="etiqueta_paper_width" string="Paper Width (mm)" />
                    <field name="etiqueta_paper_height" string="Paper Height (mm)" />
                    <field name="etiqueta_display_total" string="Display the Total" />
                    <field
                        name="etiqueta_display_delivery_address"
                        string="Display the Delivery Address"
                    />
                    <field name="etiqueta_display_items" string="Display the Items" />
                </group>
                <group name="etiqueta_margins" string="Label Margins (mm)">
                    <field name="etiqueta_margin_top" string="Top" />
                    <field name="etiqueta_margin_right" string="Right" />
                    <field name="etiqueta_margin_bottom" string="Bottom" />
                    <field name="etiqueta_margin_left" string="Left" />
                </group>
            </group>
        </field>
    </record>
</odoo>
